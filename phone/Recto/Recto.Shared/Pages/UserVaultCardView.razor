@using Recto.Shared.Capability
@using Recto.Shared.Protocol.V04
@using Recto.Shared.Services
@implements IDisposable
@inject IBootloaderClient BootloaderClient
@inject IEnclaveKeyService EnclaveKeys

@* R-SERIES STEP 3: the user-vault grant and revoke cards. Every field of the
   record the phone signs is a row (hard rule 15.x); the agent's name and the
   purpose are the service's words, labelled so and never signed; the window
   chips only shorten the proposal. The model lives here and nowhere else, and
   is dropped on approve, deny, expiry or close (hard rule 15.y). The app
   banner above is Home's, shared with every card. *@

@if (_model is null)
{
    <div class="alert alert-warning small text-start mb-0" role="alert">
        This card cannot be shown whole, so it cannot be approved: @_refusal
    </div>
    <div class="rec-btn-row mt-2">
        <button class="rec-btn rec-btn-deny" disabled="@_busy" @onclick="DenyAsync">Dismiss</button>
    </div>
}
else
{
    var grant = _model.Action == UserVaultCardModel.ActionGrant;
    var record = grant ? _model.GrantRecord(_notAfter, _nonce) : _model.RevokeRecord(_nonce);
    var rows = UserVaultCardModel.RowsFor(record);
    var keyLabel = _model.Key;

    <div class="uv-card @(grant ? "" : "uv-danger")" data-uv-action="@_model.Action">
        <p class="uv-title">
            @if (grant)
            {
                <span>Let @AgentLabel() use your <code>@keyLabel</code> key?</span>
            }
            else
            {
                <span>Stop @AgentLabel() using your <code>@keyLabel</code> key?</span>
            }
        </p>
        @if (!string.IsNullOrEmpty(_model.Purpose))
        {
            <p class="uv-ask">The service says: <q>@_model.Purpose</q></p>
        }
        else if (!grant)
        {
            <p class="uv-ask">The service asked for this.</p>
        }

        @if (rows is null)
        {
            <div class="alert alert-warning small mb-2" role="alert">
                A field of this record cannot be shown, so it cannot be signed.
            </div>
        }
        else
        {
            <div class="uv-rows">
                @foreach (var row in rows)
                {
                    <div class="uv-row" data-field="@row.Field">
                        <div class="uv-k">@row.Label</div>
                        <div class="uv-v">
                            @if (row.Field == "agent_handle" && !string.IsNullOrEmpty(_model.AgentName))
                            {
                                <div>@_model.AgentName <span class="uv-claim">named by the service</span></div>
                            }
                            @if (row.IsHandle)
                            {
                                <button type="button" class="uv-h uv-h-btn" title="Show all"
                                        @onclick="() => ToggleReveal(row.Field)">
                                    @(_revealed.Contains(row.Field) ? row.Value : UserVaultCardModel.HandlePrefix(row.Value))
                                </button>
                            }
                            else if (row.Field is "nonce" or "grant_id")
                            {
                                <span class="uv-h">@UserVaultCardModel.HandlePrefix(row.Value)</span>
                            }
                            else
                            {
                                <span>@row.Value</span>
                            }
                            @if (row.Field == "not_after" && grant)
                            {
                                <div class="uv-chips">
                                    @foreach (var t in _choices)
                                    {
                                        var on = t == _notAfter;
                                        <button type="button" class="uv-chip @(on ? "on" : "")" @onclick="() => Choose(t)">
                                            @ChipLabel(t)
                                        </button>
                                    }
                                </div>
                            }
                            @if (row.Field == "grant_id" && _model.AdmittedAtUnix is { } given)
                            {
                                <div class="uv-sub">given @UserVaultCardModel.FormatUtc(given)</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger small mb-2" role="alert">@_error</div>
        }

        @if (_busy)
        {
            <div class="rec-btn-row">
                <button class="rec-btn rec-btn-ghost" style="flex: 1 1 0; cursor: not-allowed;" disabled>
                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                    <span>@_busyText</span>
                </button>
            </div>
        }
        else
        {
            <div class="rec-btn-row">
                @if (rows is not null)
                {
                    <button class="rec-btn @(grant ? "rec-btn-approve" : "rec-btn-deny uv-btn-stop")" @onclick="ApproveAsync">
                        @(grant ? "Approve" : "Stop it")
                    </button>
                }
                <button class="rec-btn @(grant ? "rec-btn-deny" : "rec-btn-ghost")" @onclick="DenyAsync">
                    @(grant ? "Deny" : "Keep")
                </button>
            </div>
        }
        <p class="uv-note">
            @if (grant)
            {
                <span>One agent, one key. You can stop it any time under "Your grants" below.</span>
            }
            else
            {
                <span>Takes effect at once: the agent's next use of the key is refused.</span>
            }
        </p>
    </div>
}

@code {
    [Parameter, EditorRequired] public PendingRequest Request { get; set; } = default!;
    [Parameter, EditorRequired] public string BootloaderUrl { get; set; } = string.Empty;
    /// <summary>This phone's id: its delegated poll key signs the Deny.</summary>
    [Parameter, EditorRequired] public string PhoneId { get; set; } = string.Empty;
    /// <summary>The bootloader this phone is paired to: a card naming another one is refused.</summary>
    [Parameter, EditorRequired] public string PairedBootloaderId { get; set; } = string.Empty;
    /// <summary>The phone's identity key alias (the biometric-gated key the grant verifies against).</summary>
    [Parameter, EditorRequired] public string IdentityKeyAlias { get; set; } = string.Empty;
    /// <summary>Called once the card is resolved, so Home re-polls; carries a line for the status area, or null.</summary>
    [Parameter] public EventCallback<string?> OnResolved { get; set; }

    private UserVaultCardModel? _model;
    private string? _refusal;
    private string _nonce = UserVaultCardModel.NewNonce();
    private long _notAfter;
    private IReadOnlyList<long> _choices = Array.Empty<long>();
    private readonly HashSet<string> _revealed = new(StringComparer.Ordinal);
    private bool _busy;
    private string _busyText = string.Empty;
    private string? _error;
    private string? _builtFor;

    protected override void OnParametersSet()
    {
        if (_builtFor == Request.RequestId) return;
        _builtFor = Request.RequestId;
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        _model = UserVaultCardModel.TryBuild(Request, now, out _refusal);
        if (_model is not null && !string.IsNullOrEmpty(PairedBootloaderId) && _model.BootloaderId != PairedBootloaderId)
        {
            _refusal = "The card names another vault than the one this phone is paired to.";
            _model = null;
        }
        if (_model is not null && _model.Action == UserVaultCardModel.ActionGrant)
        {
            _choices = _model.WindowChoices(now);
            _notAfter = _choices[0];
        }
    }

    private string AgentLabel()
        => string.IsNullOrEmpty(_model?.AgentName) ? "agent " + UserVaultCardModel.HandlePrefix(_model!.AgentHandle) : _model.AgentName!;

    private string ChipLabel(long t)
    {
        var days = (int)Math.Round((t - DateTimeOffset.UtcNow.ToUnixTimeSeconds()) / 86400.0);
        return t == _choices[0] ? $"{days} days (asked)" : $"{days} days";
    }

    private void Choose(long t) => _notAfter = t;

    private void ToggleReveal(string field)
    {
        if (!_revealed.Add(field)) _revealed.Remove(field);
    }

    private async Task ApproveAsync()
    {
        if (_model is null) return;
        _error = null;
        _busy = true;
        _busyText = "Awaiting biometric approval...";
        StateHasChanged();
        try
        {
            var grant = _model.Action == UserVaultCardModel.ActionGrant;
            var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            var record = grant ? _model.GrantRecord(_notAfter, _nonce, now) : _model.RevokeRecord(_nonce);
            if (UserVaultCardModel.RowsFor(record) is null)
            {
                _error = "A field of this record cannot be shown, so it was not signed.";
                return;
            }
            var message = UserVaultCardModel.SignedMessage(
                grant ? UserVaultCardModel.GrantPrefix : UserVaultCardModel.RevokePrefix, record);
            var sig = await EnclaveKeys.SignAsync(IdentityKeyAlias, message, CancellationToken.None);
            if (sig.IsFailure)
            {
                _error = sig.Error.Message;
                return;
            }
            _busyText = "Sending to the vault...";
            StateHasChanged();
            var body = new UserVaultSignedRecord(record, B64u(sig.Value));
            string? line;
            if (grant)
            {
                var r = await BootloaderClient.PostUserVaultGrantAsync(BootloaderUrl, body, CancellationToken.None);
                if (r.IsFailure) { _error = r.Error.Message; _nonce = UserVaultCardModel.NewNonce(); return; }
                line = $"Granted until {UserVaultCardModel.FormatUtc(r.Value.NotAfter)}.";
            }
            else
            {
                var r = await BootloaderClient.PostUserVaultRevokeAsync(BootloaderUrl, body, CancellationToken.None);
                if (r.IsFailure) { _error = r.Error.Message; _nonce = UserVaultCardModel.NewNonce(); return; }
                line = "Stopped.";
            }
            _model.Drop();
            await OnResolved.InvokeAsync(line);
        }
        finally
        {
            _busy = false;
            _busyText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task DenyAsync()
    {
        _busy = true;
        _busyText = "Taking the card away...";
        StateHasChanged();
        try
        {
            // The poll key signs the Deny (no biometric prompt); the request leaves the phone, and expires on its
            // own if the vault is unreachable.
            await BootloaderClient.DenyUserVaultGrantRequestAsync(BootloaderUrl, PhoneId, Request.RequestId, CancellationToken.None);
            _model?.Drop();
            await OnResolved.InvokeAsync(null);
        }
        finally
        {
            _busy = false;
            _busyText = string.Empty;
            StateHasChanged();
        }
    }

    public void Dispose() => _model?.Drop();

    private static string B64u(byte[] raw) => Convert.ToBase64String(raw).TrimEnd('=').Replace('+', '-').Replace('/', '_');
}
