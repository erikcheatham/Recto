<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): nothing of Recto's leaves the phone by cloud backup or device-to-device transfer.
     The identity and signing keys are non-exportable in StrongBox regardless; this keeps the preferences and the
     pairing store from arriving on a new phone without the keys they name (docs/backlog.md, the backup item). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
