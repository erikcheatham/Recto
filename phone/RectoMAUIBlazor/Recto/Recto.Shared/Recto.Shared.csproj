<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<!-- This library ships inside the MAUI Blazor Hybrid WebView and runs
		     on-device only; it is never loaded as browser WebAssembly. The
		     Razor template's default browser declaration made the platform
		     analyzer treat browser as reachable and flag APIs the browser
		     sandbox lacks (string.Normalize(FormKD), the SPKI-pinning
		     HttpClientHandler callback) with CA1416 for a platform that
		     cannot load this assembly. Declaring the truth removes them. -->
		<SupportedPlatform Remove="browser" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
		<PackageReference Include="Microsoft.Extensions.Configuration" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Http" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" />
		<PackageReference Include="Polly" />
		<PackageReference Include="Scrutor" />
		<PackageReference Include="Serilog" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" />
		<!-- Wave 4: BIP-39 mnemonic + BIP-32/BIP-44 derivation + secp256k1
		     ECDSA. Used by EthSigningOps / Bip39 / Bip32. Cross-platform
		     pure-managed crypto (no platform-specific code), so the
		     classes live here in Recto.Shared and the test project
		     reaches them through the existing project reference. -->
		<PackageReference Include="BouncyCastle.Cryptography" />
		<!-- Phase 2.B: QR encoder. Pure-managed MIT QRCoder library;
		     PngByteQRCode + SvgQRCode for cross-platform output without
		     System.Drawing. Used by Recto.Shared.QR.QrEncoder. Sister
		     of Python's qrcode library (Phase 1 substrate ce9aca6); both
		     produce QR codes from the same canonical-JSON input bytes
		     so a Python-encoded QR and a C#-encoded QR carrying the
		     same payload are byte-equivalent at the QR-content layer
		     (the actual PNG byte sequences may differ due to library-
		     specific image compression, but the decoded payload bytes
		     match). -->
		<PackageReference Include="QRCoder" />
	</ItemGroup>
	<ItemGroup>
		<!-- Canonical BIP-0039 English wordlist (2048 words). One-time
		     download from
		     https://github.com/bitcoin/bips/blob/master/bip-0039/english.txt
		     into Resources/Bip39/english.txt. Embedded as a manifest
		     resource so Bip39Wordlist loads the byte-for-byte canonical
		     wordlist from the assembly regardless of build host —
		     mnemonics generated by Recto are interoperable with every
		     other BIP-39 wallet (MetaMask, Ledger, Trezor, etc.). -->
		<EmbeddedResource Include="Resources\Bip39\english.txt" />
	</ItemGroup>
</Project>
