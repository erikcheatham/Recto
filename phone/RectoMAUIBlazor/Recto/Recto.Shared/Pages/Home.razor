    private async Task RefreshRegisteredPhonesAsync(CancellationToken ct)
    {
        if (_paired is null) return;
        _refreshingPhones = true;
        StateHasChanged();
        try
        {
            var result = await BootloaderClient.ListRegisteredPhonesAsync(
                ActiveBootloaderUrl, _paired.PhoneId, ct);
            if (result.IsSuccess)
            {
                _registeredPhones = result.Value.Phones.ToList();
            }
            else
            {
                // Surface in the same poll-error slot used for pending refresh.
                _pollingError = result.Error.Message;
            }
        }
        finally
        {
            _refreshingPhones = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleRevokeAsync(RegisteredPhoneInfo target)
    {
        if (_paired is null) return;

        // Confirm via the browser-native confirm dialog so an accidental tap
        // doesn't nuke a backup phone.
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Revoke '{target.DeviceLabel}'?\n\nThis phone will no longer be able to sign requests for this bootloader. " +
            $"You can re-pair it later if needed.");
        if (!confirmed) return;

        _revokingPhoneId = target.PhoneId;
        _revokingText = "Awaiting biometric...";
        StateHasChanged();

        try
        {
            // Step 1: fetch a fresh challenge to sign as the auth proof.
            var challengeResult = await BootloaderClient.GetRevokeChallengeAsync(
                ActiveBootloaderUrl, _paired.PhoneId, CancellationToken.None);
            if (challengeResult.IsFailure)
            {
                // ALERT, not _pollingError: the polling loop overwrites
                // _pollingError within seconds, which is how FOUR contract
                // defects in this lane failed invisibly (2026-08-23). A
                // revoke failure must outlive one poll cycle.
                await JS.InvokeVoidAsync("alert",
                    $"Revoke failed fetching the challenge: {challengeResult.Error.Message}");
                return;
            }
            var challenge = challengeResult.Value;

            // Step 2: sign with the enclave key. iOS / Android trigger
            // biometric here; Windows-software signs immediately.
            // Canonical convention (Build 9 fix): literal ASCII bytes of the
            // base64url challenge string -- Do NOT reintroduce Base64UrlDecode.
            // COLON-BOUND to the target (server contract, server.py
            // _handle_revoke_phone): the payload is
            // "{challenge_b64u}:{target_phone_id}", which is what makes a
            // captured signature useless against any other target. Signing
            // the bare challenge verifies against nothing -- that was defect
            // #3 of the dead revoke lane found 2026-08-23.
            var challengeBytes = System.Text.Encoding.ASCII.GetBytes(
                $"{challenge.ChallengeB64u}:{target.PhoneId}");
            var signResult = await EnclaveKeys.SignAsync(KeyAlias, challengeBytes, CancellationToken.None);
            if (signResult.IsFailure)
            {
                await JS.InvokeVoidAsync("alert",
                    $"Revoke failed at enclave signing: {signResult.Error.Message}");
                return;
            }

            // Step 3: POST the revocation.
            _revokingText = "Revoking...";
            StateHasChanged();
            await Task.Yield();
            var revokeReq = new RevokeRequest(
                RevokerPhoneId: _paired.PhoneId,
                TargetPhoneId: target.PhoneId,
                ChallengeB64u: challenge.ChallengeB64u,
                SignatureB64u: Base64UrlEncode(signResult.Value));
            var revokeResult = await BootloaderClient.RevokePhoneAsync(
                ActiveBootloaderUrl, revokeReq, CancellationToken.None);
            if (revokeResult.IsFailure)
            {
                await JS.InvokeVoidAsync("alert",
                    $"Revoke rejected by the bootloader: {revokeResult.Error.Message}");
                return;
            }

            // Step 4: refresh the list so the revoked phone disappears.
            await RefreshRegisteredPhonesAsync(CancellationToken.None);
        }
        finally
        {
            _revokingPhoneId = null;
            _revokingText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task CopyTotpCodeAsync()
    {
        if (string.IsNullOrEmpty(_lastTotpCode)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _lastTotpCode);
            _totpCopied = true;
            StateHasChanged();
            // Reset the "Copied" indicator after 2 s so a subsequent generation
            // gets a fresh "Copy" affordance.
            await Task.Delay(2000);
            _totpCopied = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _pollingError = $"Clipboard copy failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Copies a long-string trust artifact (TLS pin, Phone id, Bootloader id)
    /// to the device clipboard and flashes a "Copied" indicator on the
    /// originating button for ~2 seconds. Recto Phone v1.1 Phase 4 polish
    /// (banked 2026-05-20 morning). Sister of <see cref="CopyTotpCodeAsync"/>;
    /// uses the same navigator.clipboard.writeText JS interop primitive.
    /// </summary>
    /// <param name="key">Stable key identifying which artifact button to
    /// flash ("bootloaderId", "phoneId", "tlsPin"). Single shared
    /// _pairingCopiedKey field means only one button shows "Copied" at
    /// a time; rapid taps on different buttons cancel each other's
    /// flash gracefully because the latest Task.Delay assignment wins.</param>
    /// <param name="value">The full string to copy to clipboard. NEVER
    /// truncated — that defeats the entire purpose of the Copy button.</param>
    private async Task CopyArtifactAsync(string key, string value)
    {
        if (string.IsNullOrEmpty(value)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
            _pairingCopiedKey = key;
            StateHasChanged();
            await Task.Delay(2000);
            // Only clear if this is still the most-recent copy — defends
            // against a later Copy click overwriting our key, then this
            // Delay returning and incorrectly clearing the newer flash.
            if (_pairingCopiedKey == key)
            {
                _pairingCopiedKey = null;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _pollingError = $"Clipboard copy failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Opens the QR-rendering modal for a long-string trust artifact
    /// (TLS pin, Phone id, Bootloader id). Recto Phone v1.1 Phase 2.C
    /// polish (banked 2026-05-20 night). Encodes the value via
    /// <see cref="QrEncoder.EncodeText"/> with M error-correction +
    /// 8 pixels-per-module + 4-module quiet zone (all canonical
    /// defaults from <c>recto.qr</c> substrate primitive). Converts
    /// the PNG bytes to a base64 data URI via
    /// <see cref="QrEncoder.PngBytesToDataUri"/> so the modal can
    /// render via &lt;img src="data:image/png;base64,..."/&gt; without
    /// a disk write or temp file. Modal closes via
    /// <see cref="CloseQrModal"/>; the encoded data URI is cached
    /// only for the modal's open lifetime.
    /// </summary>
    /// <param name="key">Stable key identifying which artifact opened
    /// the modal (matches the _pairingCopiedKey convention). Single-
    /// modal-at-a-time discipline.</param>
    /// <param name="label">Human-readable label rendered above the
    /// QR (e.g. "TLS pin"). Operator's at-a-glance "what am I
    /// scanning" cue.</param>
    /// <param name="value">The full string to encode as QR. NEVER
    /// truncated — defeats the entire purpose of the QR primitive.</param>
    private void ShowQrModal(string key, string label, string value)
    {
        if (string.IsNullOrEmpty(value)) return;
        try
        {
            var pngBytes = QrEncoder.EncodeText(value);
            _qrModalArtifactKey = key;
            _qrModalArtifactLabel = label;
            _qrModalArtifactValue = value;
            _qrModalDataUri = QrEncoder.PngBytesToDataUri(pngBytes);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _pollingError = $"QR render failed: {ex.Message}";
        }
    }

    /// <summary>
    /// Closes the QR modal and releases the cached PNG data URI.
    /// Called from the modal's overlay-tap handler + explicit close
    /// button. Idempotent — repeated calls just clear already-null
    /// state.
    /// </summary>
    private void CloseQrModal()
    {
        _qrModalArtifactKey = null;
        _qrModalArtifactLabel = null;
        _qrModalArtifactValue = null;
        _qrModalDataUri = null;
        StateHasChanged();
    }

    // --- Polling ---

    private void StartPolling()
    {
        StopPolling();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private void StopPolling()
    {
        try { _pollCts?.Cancel(); } catch { /* swallow */ }
        _pollCts?.Dispose();
        _pollCts = null;
    }

    private async Task PollLoopAsync(CancellationToken ct)
    {
        while (!ct.IsCancellationRequested)
        {
            // DIAG-2026-04-30 (auto-unpair investigation): wrap the
            // refresh call. BootloaderClient.SendAsync already catches
            // OCE / TaskCanceledException internally and returns a
            // failed Result, so this catch shouldn't fire under normal
            // operation. If it DOES fire, something else (e.g. an
            // address-derivation call inside Populate*Async) is
            // throwing during the refresh -- log it instead of letting
            // it escape the loop silently.
            try
            {
                await RefreshPendingAsync(ct);
            }
            catch (OperationCanceledException) when (ct.IsCancellationRequested)
            {
                System.Diagnostics.Debug.WriteLine(
                    "[Recto/DIAG] PollLoopAsync: refresh cancelled (CT fired).");
                return;
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine(
                    $"[Recto/DIAG] PollLoopAsync: refresh threw {ex.GetType().Name}: {ex.Message}{Environment.NewLine}{ex.StackTrace}");
                // Don't return -- one bad refresh shouldn't kill the
                // whole polling loop. Sleep then continue.
            }
            try
            {
                await Task.Delay(PollInterval, ct);
            }
            catch (OperationCanceledException)
            {
                return;
            }
        }
    }

    private async Task RefreshPendingAsync(CancellationToken ct)
    {
        if (_paired is null) return;
        // App Review demo-mode no-op (banked 2026-05-22). There's no real
        // bootloader to poll; the synthetic pending request stays in
        // _pending until the operator approves or denies it.
        if (IsDemoMode) return;
        var result = await BootloaderClient.GetPendingAsync(ActiveBootloaderUrl, _paired.PhoneId, ct);

        // Build 12 multi-URL failover: a connection-level failure on the
        // polling path rotates to the next candidate so the NEXT poll tick
        // hits a live instance (all share the Postgres state store, so any
        // instance sees the same pending queue). HTTP-level failures don't
        // rotate — a sibling would reject identically. One rotation per
        // failed tick keeps it gentle; the poll cadence paces the sweep.
        // Fully-qualified: the injected field is also named `BootloaderClient`
        // (typed IBootloaderClient), so the bare name binds to the instance —
        // the static discriminator lives on the concrete class.
        if (result.IsFailure
            && Recto.Shared.Services.BootloaderClient.IsNetworkUnreachable(result.Error)
            && AdvanceFailover())
        {
            _pollingError = result.Error.Message;
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (result.IsSuccess)
        {
            _pending = result.Value.Requests.ToList();
            _pollingError = null;
            await PopulateEthAddressesAsync(_pending, ct);
            await PopulateBtcAddressesAsync(_pending, ct);
            await PopulateEdAddressesAsync(_pending, ct);
            await PopulateTronAddressesAsync(_pending, ct);
            PopulateCapabilityDecodes(_pending);

            // v1 vault home (banked 2026-05-18): every observed request
            // upserts the Connected Services registry. AppContext is the
            // canonical key — requests without it are "Unknown app" cards
            // and don't populate the registry. Fire-and-await sequentially
            // (registry impl is SecureStorage-backed and uses a SemaphoreSlim
            // for concurrency, so back-to-back upserts are safe but not
            // strictly parallel — sequential keeps the code simple).
            foreach (var req in _pending)
            {
                await Registry.RecordObservedAsync(req.Context.AppContext, ct);
            }
            var servicesResult = await Registry.GetAllAsync(ct);
            _connectedServices = servicesResult.IsSuccess
                ? servicesResult.Value
                : Array.Empty<ConnectedService>();
        }
        else
        {
            _pollingError = result.Error.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Pre-derive the ETH address each pending <c>eth_sign</c> request
    /// will sign with, keyed by request_id. This runs once per refresh
    /// (~2-5 ms per address on Windows) so the @switch render arm can
    /// show "Address: 0x..." inline without doing async work in markup.
    /// Stale entries from previous refreshes are dropped.
    /// </summary>
    private async Task PopulateEthAddressesAsync(List<PendingRequest> pending, CancellationToken ct)
    {
        var newMap = new Dictionary<string, string>();
        foreach (var req in pending)
        {
            if (req.Kind != PendingRequestKind.EthSign) continue;
            var path = string.IsNullOrEmpty(req.Context.EthDerivationPath)
                ? "m/44'/60'/0'/0/0"
                : req.Context.EthDerivationPath!;
            var account = await EthSigner.EnsureMnemonicAsync(EthKeyAlias, path, ct);
            if (account.IsSuccess)
            {
                newMap[req.RequestId] = account.Value.Address;
            }
        }
        _ethAddressByRequestId = newMap;
    }

    /// <summary>
    /// Wave-5 sibling of PopulateEthAddressesAsync. Runs once per
    /// refresh; for each pending btc_sign request, derives the
    /// network-and-path-specific Bitcoin address (bech32 P2WPKH for
    /// the m/84' purpose level) so the render arm can display
    /// "Address: bc1q..." inline without doing async work in markup.
    /// </summary>
    private async Task PopulateBtcAddressesAsync(List<PendingRequest> pending, CancellationToken ct)
    {
        var newMap = new Dictionary<string, string>();
        foreach (var req in pending)
        {
            if (req.Kind != PendingRequestKind.BtcSign) continue;
            var coin = string.IsNullOrEmpty(req.Context.BtcCoin)
                ? BtcCoin.Bitcoin
                : req.Context.BtcCoin!;
            var path = string.IsNullOrEmpty(req.Context.BtcDerivationPath)
                ? _btcDefaultPathForCoin(coin)
                : req.Context.BtcDerivationPath!;
            var network = string.IsNullOrEmpty(req.Context.BtcNetwork)
                ? "mainnet"
                : req.Context.BtcNetwork!;
            var account = await BtcSigner.EnsureMnemonicAsync(BtcKeyAlias, path, network, coin, ct);
            if (account.IsSuccess)
            {
                newMap[req.RequestId] = account.Value.Address;
            }
        }
        _btcAddressByRequestId = newMap;
    }

    /// <summary>
    /// Wave-8 sibling of PopulateEthAddressesAsync /
    /// PopulateBtcAddressesAsync. Runs once per refresh; for each
    /// pending ed_sign request, derives the chain-encoded address
    /// (SOL base58 / XLM StrKey / XRP classic) so the render arm can
    /// display "Address: ..." inline without doing async work in
    /// markup.
    /// </summary>
    private async Task PopulateEdAddressesAsync(List<PendingRequest> pending, CancellationToken ct)
    {
        var newMap = new Dictionary<string, string>();
        foreach (var req in pending)
        {
            if (req.Kind != PendingRequestKind.EdSign) continue;
            if (string.IsNullOrEmpty(req.Context.EdChain)) continue;
            var chain = req.Context.EdChain!;
            var path = string.IsNullOrEmpty(req.Context.EdDerivationPath)
                ? _edDefaultPathForChain(chain)
                : req.Context.EdDerivationPath!;
            var account = await EdSigner.EnsureMnemonicAsync(EdKeyAlias, chain, path, ct);
            if (account.IsSuccess)
            {
                newMap[req.RequestId] = account.Value.Address;
            }
        }
        _edAddressByRequestId = newMap;
    }

    /// <summary>
    /// Wave 9: pre-derive TRON addresses for every pending tron_sign
    /// request so the render arm can show "Address: T..." inline
    /// without doing async work inside the @switch. Same shape as
    /// PopulateEthAddressesAsync; only the service + path defaults
    /// differ.
    /// </summary>
    private async Task PopulateTronAddressesAsync(List<PendingRequest> pending, CancellationToken ct)
    {
        var newMap = new Dictionary<string, string>();
        foreach (var req in pending)
        {
            if (req.Kind != PendingRequestKind.TronSign) continue;
            var path = string.IsNullOrEmpty(req.Context.TronDerivationPath)
                ? "m/44'/195'/0'/0/0"
                : req.Context.TronDerivationPath!;
            var account = await TronSigner.EnsureMnemonicAsync(TronKeyAlias, path, ct);
            if (account.IsSuccess)
            {
                newMap[req.RequestId] = account.Value.Address;
            }
        }
        _tronAddressByRequestId = newMap;
    }

    /// <summary>
    /// Phase 5 Wave B part 2: decode CapabilityClaims for every
    /// pending capability_request so the render arm can show the
    /// structured-list approval UI without doing decoding inline.
    /// Synchronous (no enclave / network calls; just base64url-decode
    /// + System.Text.Json parse + claims projection). Decode failures
    /// stash a friendly error string in
    /// <see cref="_capabilityDecodeErrorByRequestId"/> so the operator
    /// sees what went wrong rather than rendering an empty card.
    /// </summary>
    private void PopulateCapabilityDecodes(List<PendingRequest> pending)
    {
        var decoded = new Dictionary<string, Recto.Shared.Capability.CapabilityAuditView>();
        var errors = new Dictionary<string, string>();
        foreach (var req in pending)
        {
            if (req.Kind != PendingRequestKind.CapabilityRequest) continue;
            if (string.IsNullOrEmpty(req.Context.CapPayloadB64))
            {
                errors[req.RequestId] = "capability_request missing cap_payload_b64";
                continue;
            }
            try
            {
                var pad = (4 - (req.Context.CapPayloadB64!.Length % 4)) % 4;
                var paddedB64 = req.Context.CapPayloadB64
                    .Replace('-', '+').Replace('_', '/')
                    + new string('=', pad);
                var payloadBytes = System.Convert.FromBase64String(paddedB64);
                using var doc = System.Text.Json.JsonDocument.Parse(payloadBytes);
                var claims = Recto.Shared.Capability.CapabilityJws.PayloadToClaims(doc.RootElement);
                // AUDIT DETAILS v2 (2026-08-13): the view-model is
                // computed from the SIGNED payload bytes only
                // (sign-what-you-see); transport facts render from
                // req.Context in a separate, unsigned-labeled section.
                decoded[req.RequestId] = Recto.Shared.Capability.CapabilityAuditView.From(claims);
            }
            catch (Exception ex)
            {
                errors[req.RequestId] = $"Decode failed: {ex.GetType().Name}: {ex.Message}";
            }
        }
        _capabilityDecodedByRequestId = decoded;
        _capabilityDecodeErrorByRequestId = errors;
    }

    // AUDIT DETAILS v2 (2026-08-13): the capability card's view-model
    // moved to Recto.Shared.Capability.CapabilityAuditView so its
    // parsing / cross-check logic is unit-testable outside a Blazor
    // render harness. The page-private CapabilityRequestView records
    // it replaced lived here.

    private async Task HandleRetryPollAsync()
    {
        _retrying = true;
        StateHasChanged();
        try
        {
            await RefreshPendingAsync(CancellationToken.None);
        }
        finally
        {
            _retrying = false;
            StateHasChanged();
        }
    }

    private async Task SetBusyTextAsync(string text)
    {
        _busyText = text;
        StateHasChanged();
        await Task.Yield();
    }

    public async ValueTask DisposeAsync()
    {
        // Build 6 (2026-06-02): unsubscribe from PayloadArrived event
        // before stopping the polling loop. The static event field in
        // InMemoryPairDeepLinkState outlives every page instance, so a
        // missed unsubscribe would leak this Home.razor reference into
        // the multicast delegate chain — subsequent SetGlobal calls
        // would fire on a disposed component (the try/catch in the
        // handler swallows the InvokeAsync, but the leak still bloats
        // the delegate chain over time).
        _disposed = true;

        if (_payloadArrivedHandler is not null)
        {
            DeepLink.PayloadArrived -= _payloadArrivedHandler;
            _payloadArrivedHandler = null;
        }

        // Build 12: same leak-avoidance for the wake-signal subscription —
        // the static event field outlives every page instance.
        if (_pushWakeHandler is not null)
        {
            PushWake.WakeRequested -= _pushWakeHandler;
            _pushWakeHandler = null;
        }

        StopPolling();
        await Task.CompletedTask;
    }

    // --- Cert pinning helpers ---

    private string? TryCaptureBootloaderPin(string bootloaderUrl)
    {
        try
        {
            var host = new Uri(bootloaderUrl).Host;
            var observed = Pinning.GetObservedPin(host);
            if (string.IsNullOrEmpty(observed)) return null;
            Pinning.SetPin(host, observed);
            return observed;
        }
        catch
        {
            return null;
        }
    }

    private void RestorePin(PairingState state)
    {
        if (string.IsNullOrEmpty(state.BootloaderSpkiPin)) return;
        try
        {
            var host = new Uri(state.BootloaderUrl).Host;
            Pinning.SetPin(host, state.BootloaderSpkiPin);
        }
        catch { /* ignore bad URL in stored state */ }
    }

    private void ClearPin(string bootloaderUrl)
    {
        try
        {
            var host = new Uri(bootloaderUrl).Host;
            Pinning.ClearPin(host);
        }
        catch { /* ignore */ }
    }

    // --- base64url helpers ---

    private static string Base64UrlEncode(byte[] data)
    {
        var b64 = Convert.ToBase64String(data);
        return b64.TrimEnd('=').Replace('+', '-').Replace('/', '_');
    }

    private static byte[] Base64UrlDecode(string b64u)
    {
        var b64 = b64u.Replace('-', '+').Replace('_', '/');
        switch (b64.Length % 4)
        {
            case 2: b64 += "=="; break;
            case 3: b64 += "="; break;
        }
        return Convert.FromBase64String(b64);
    }

    // Full-disclosure rule: show the entire hash inline; never truncate
    // with ellipsis. Sister of the v1.1 TLS pin disclosure commitment
    // ("operators / reviewers need every byte of the trust artifact to
    // cross-reference across devices"). The function name + signature
    // are preserved so the 4 callers below don't change shape; only the
    // body's behavior is gutted. Long strings wrap cleanly via the
    // .rec-disclosure-body code CSS rule (word-break + overflow-wrap)
    // so the audit-detail row reflows to 2-3 lines on phone width
    // instead of overflowing horizontally. Renaming + inlining is a
    // future cleanup-pass item. Banked 2026-05-22 evening after the
    // iPhone 17 Pro Max simulator capture showed truncated hashes
    // in the demo card's audit-details disclosure.
    private static string TruncateHash(string hash) => hash;

    private static string TruncatePin(string pin) => pin;

    // ---- v1 vault home helpers (banked 2026-05-18) ----

    /// <summary>
    /// Truncates a bootloader URL for the vault header status line.
    /// "https://bootloader-staging.example.com" -> "bootloader-staging.example.com".
    /// Strips the protocol so the host fits on one line on narrow screens.
    /// </summary>
    private static string TruncateUrlForDisplay(string url)
    {
        if (string.IsNullOrEmpty(url)) return url;
        var stripped = url.Replace("https://", "").Replace("http://", "");
        return stripped.Length > 40 ? stripped[..40] + "..." : stripped;
    }

    /// <summary>
    /// Returns the first character of the service's AppName, uppercased,
    /// for use as a fallback icon placeholder when AppIconUrl is null.
    /// "Example App" -> "E". Defensive for empty strings.
    /// </summary>
    private static string GetServiceInitial(string appName)
    {
        if (string.IsNullOrEmpty(appName)) return "?";
        return appName[0].ToString().ToUpperInvariant();
    }

    /// <summary>
    /// Human-readable relative time for the vault home + service panel.
    /// "just now" / "5m ago" / "3h ago" / "2d ago" / specific date past 7 days.
    /// </summary>
    private static string FormatRelativeTime(DateTimeOffset utc)
    {
        var delta = DateTimeOffset.UtcNow - utc;
        if (delta.TotalSeconds < 60) return "just now";
        if (delta.TotalMinutes < 60) return $"{(int)delta.TotalMinutes}m ago";
        if (delta.TotalHours < 24) return $"{(int)delta.TotalHours}h ago";
        if (delta.TotalDays < 7) return $"{(int)delta.TotalDays}d ago";
        return utc.ToLocalTime().ToString("MMM d");
    }

    /// <summary>
    /// Opens the per-service info panel for the given AppId. Toggles —
    /// tapping the currently-open row closes it (back to no panel).
    /// Also resets any pending-unpair-confirm state so a dirty
    /// "Are you sure?" row from another service doesn't carry over.
    /// </summary>
    private void OpenServicePanel(string appId)
    {
        // Build 6 (2026-06-02): always clear the pending-unpair confirm
        // state on panel toggle. Otherwise a half-confirmed unpair on
        // service A could remain "armed" when the operator pops over to
        // inspect service B's panel.
        _pendingUnpairAppId = null;
        _unpairServiceError = null;

        if (_openServicePanelId == appId)
        {
            _openServicePanelId = null;
        }
        else
        {
            _openServicePanelId = appId;
        }
    }

    /// <summary>
    /// Closes the per-service info panel without opening another.
    /// Bound to the panel's "Close details" button.
    /// </summary>
    private void CloseServicePanel()
    {
        _openServicePanelId = null;
        // Build 6 (2026-06-02): closing the panel also clears any
        // pending-unpair confirm state — the operator backed out.
        _pendingUnpairAppId = null;
        _unpairServiceError = null;
    }

    /// <summary>
    /// First tap on "Unpair this service" — arms the inline confirm
    /// row inside the same rec-service-panel. Doesn't touch the
    /// registry yet; the confirm tap is what actually fires
    /// UnpairAsync.
    /// </summary>
    private void HandleUnpairServiceClick(string appId)
    {
        if (_unpairServiceBusy) return;
        _pendingUnpairAppId = appId;
        _unpairServiceError = null;
    }

    /// <summary>
    /// Cancel tap — backs out of the "Are you sure?" row without
    /// touching the registry. Panel stays open showing the service
    /// detail card.
    /// </summary>
    private void HandleCancelUnpairServiceClick()
    {
        _pendingUnpairAppId = null;
        _unpairServiceError = null;
    }

    /// <summary>
    /// Confirm tap — fires the actual UnpairAsync.
    ///
    /// <para>
    /// For the demo service (<see cref="DemoServiceAppId"/>), delegates
    /// to <see cref="HandleStartFreshClick"/> so the full demo-mode
    /// exit ceremony (clearing biometric, pairing-state, AND the
    /// connected-services entry) runs as a single user-visible action.
    /// </para>
    /// <para>
    /// For real services, FIRST tears down the consumer-side master-pubkey
    /// binding via the <c>devices:pairing_revoke</c> capability
    /// (Build 9 — closes the local-only gap Build 6 left): the phone signs
    /// a revoke JWS that relays through <c>/v0.4/devices/unpair</c> to the
    /// consumer's <c>/api/v1/devices/pairing/revoke</c>, which NULLs the
    /// binding. Local removal happens ONLY after the remote teardown
    /// succeeds — remote-first + fail-loud, so we never recreate the
    /// stale-binding trap (local gone, remote bound, re-pair blocked)
    /// that motivated this whole feature.
    /// </para>
    /// </summary>
    private async Task HandleConfirmUnpairServiceAsync(string appId)
    {
        if (_unpairServiceBusy) return;
        _unpairServiceBusy = true;
        _unpairServiceError = null;
        StateHasChanged();

        try
        {
            if (string.Equals(appId, DemoServiceAppId, StringComparison.Ordinal))
            {
                // Demo-mode exit delegates to the canonical "Start fresh"
                // ceremony so all demo-mode side-state (biometric, pairing,
                // bootloader sentinel) gets reset, not just the connected-
                // services entry. HandleStartFreshClick already removes the
                // demo service via Registry.ClearAllAsync (which also
                // wipes any real services that snuck in during demo-mode
                // testing — acceptable because demo mode should never run
                // alongside real pairings). No remote binding exists for
                // the demo service, so there is nothing to revoke.
                await HandleStartFreshClick();
                return;
            }

            // Real service: tear down the consumer-side binding FIRST.
            var revokeError = await RevokeConsumerBindingAsync(appId);
            if (revokeError is not null)
            {
                _unpairServiceError = revokeError;
                return; // Do NOT remove locally — remote binding still stands.
            }

            var result = await Registry.UnpairAsync(appId, CancellationToken.None);
            if (result.IsFailure)
            {
                _unpairServiceError = $"Couldn't remove this service: {result.Error.Message}";
                return;
            }

            var refreshed = await Registry.GetAllAsync(CancellationToken.None);
            _connectedServices = refreshed.IsSuccess
                ? refreshed.Value
                : Array.Empty<ConnectedService>();

            // Close the panel — the service it represented is gone.
            _openServicePanelId = null;
            _pendingUnpairAppId = null;
        }
        catch (Exception ex)
        {
            _unpairServiceError = $"Couldn't remove this service: {ex.Message}";
        }
        finally
        {
            _unpairServiceBusy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Sign + relay a <c>devices:pairing_revoke</c> JWS to tear down the
    /// consumer-side master-pubkey binding for a service. Returns null on
    /// success, or a user-facing error string on failure (the caller
    /// aborts local removal on non-null so local + remote stay in sync).
    ///
    /// <para>
    /// Sister of the pair-flow JWS build (see HandlePairServiceClick):
    /// same secp256k1 master key at <c>m/44'/60'/0'/0/0</c>, same
    /// canonical-JSON signing input, differing only in the action
    /// (<c>devices:pairing_revoke</c>) and the absence of a
    /// <c>pairing_code</c> scope field. The consumer resolves the user
    /// row by the recovered pubkey (commitment #11) and NULLs the
    /// binding. v1 is single-consumer: the base URL + aud come from the
    /// Default* constants, matching the pair flow.
    /// </para>
    /// </summary>
    private async Task<string?> RevokeConsumerBindingAsync(string appId)
    {
        if (_paired is null)
        {
            return "This phone is not paired to a bootloader, so the service " +
                   "binding can't be revoked. Try again after re-pairing.";
        }

        _unpairServiceBusy = true;
        StateHasChanged();

        const string masterPath = "m/44'/60'/0'/0/0";
        var ensureResult = await EthSigner.EnsureMnemonicAsync(
            EthKeyAlias, masterPath, CancellationToken.None);
        if (ensureResult.IsFailure)
        {
            return $"Couldn't access your signing key: {ensureResult.Error.Message}";
        }
        var pubkeyResult = await EthSigner.DerivePubkeyAtPathAsync(
            EthKeyAlias, masterPath, CancellationToken.None);
        if (pubkeyResult.IsFailure)
        {
            return $"Couldn't derive your master key: {pubkeyResult.Error.Message}";
        }
        var masterPubkeyHex = BytesToHexLower(pubkeyResult.Value); // 128 chars X||Y
        if (masterPubkeyHex.Length != 128)
        {
            return $"Master pubkey has wrong length ({masterPubkeyHex.Length}); expected 128.";
        }

        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var exp = now + 300; // 5-min window, same as the pair JWS.
        var jti = $"recto-unpair-{Guid.NewGuid():N}";
        var pubkeyPrefix = masterPubkeyHex.Length >= 16
            ? masterPubkeyHex.Substring(0, 16) : masterPubkeyHex;

        // Revoke JWS: identical shape to the pair JWS minus pairing_code,
        // with allow_actions carrying devices:pairing_revoke.
        var scopeDict = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["env"] = new List<object?>(),
            ["services"] = new List<object?>(),
            ["repos"] = new List<object?>(),
        };
        var capDict = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["tier"] = (long)0,
            ["registry_version"] = PairServiceManifestVersion,
            ["groups"] = new List<object?>(),
            ["scope"] = scopeDict,
            ["allow_actions"] = new List<object?> { "devices:pairing_revoke" },
            ["deny_actions"] = new List<object?>(),
            ["limits"] = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["per_hour"] = new Dictionary<string, object?>(),
                ["per_day"] = new Dictionary<string, object?>(),
                ["per_session"] = new Dictionary<string, object?>(),
            },
        };
        var claimsDict = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["iss"] = $"phone:user:{_paired!.PhoneId}",
            ["sub"] = $"user:{pubkeyPrefix}",
            ["aud"] = new List<object?> { DefaultConsumerAud },
            ["iat"] = now,
            ["nbf"] = now,
            ["exp"] = exp,
            ["jti"] = jti,
            ["cap"] = capDict,
            ["purpose"] = $"Unbind master pubkey from {DefaultConsumerAppName}",
        };

        var headerDict = new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["alg"] = "ES256K",
            ["typ"] = "JWT",
        };
        var headerB64 = Base64UrlEncode(Recto.Shared.Capability.CanonicalJson.Encode(headerDict));
        var payloadB64 = Base64UrlEncode(Recto.Shared.Capability.CanonicalJson.Encode(claimsDict));
        var signingInput = System.Text.Encoding.ASCII.GetBytes($"{headerB64}.{payloadB64}");
        var digest = System.Security.Cryptography.SHA256.HashData(signingInput);

        var signResult = await EthSigner.SignDigestAsync(
            EthKeyAlias, masterPath, digest, CancellationToken.None);
        if (signResult.IsFailure)
        {
            return $"Signing the revoke failed: {signResult.Error.Message}";
        }
        var signature = signResult.Value;
        if (signature.Length != 64)
        {
            return $"Revoke signature has wrong length ({signature.Length}); expected 64.";
        }
        var jws = $"{headerB64}.{payloadB64}.{Base64UrlEncode(signature)}";

        var unpairReq = new DevicesUnpairRequest(
            ConsumerBaseUrl: DefaultConsumerBaseUrl,
            UserPubkeyHex: masterPubkeyHex,
            UserJws: jws);
        var relay = await BootloaderClient.UnpairDeviceAsync(
            _paired!.BootloaderUrl, unpairReq, CancellationToken.None);
        if (relay.IsFailure)
        {
            return $"Couldn't reach {DefaultConsumerAppName} to revoke: {relay.Error.Message}";
        }

        var resp = relay.Value;
        // Consumer success is 2xx. A 404 "not bound" is benign — the
        // binding is already gone, so treat it as success (idempotent
        // teardown, sister of the bootloader's idempotent delete).
        if (resp.Status == 404)
        {
            return null;
        }
        if (resp.Status < 200 || resp.Status >= 300)
        {
            var reason = TryExtractConsumerErrorReason(resp.Body);
            return string.IsNullOrEmpty(reason)
                ? $"{DefaultConsumerAppName} returned HTTP {resp.Status} — revoke rejected."
                : $"{DefaultConsumerAppName} rejected the revoke: {reason}";
        }
        return null;
    }

