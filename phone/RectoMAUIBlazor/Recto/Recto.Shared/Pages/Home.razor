    // picker fetched from the bootloader's manifest.
    private const string DefaultConsumerBaseUrl = "https://staging.allthruit.com";
    private const string DefaultConsumerAud = "allthruit";
    private const string DefaultConsumerAppId = "allthruit";
    private const string DefaultConsumerAppName = "AllThruit";
    private const string DefaultConsumerAppDescription = "Where attention compounds";
    // Card/panel icon for the synthesized AppContext below. COMPOSED from the consts
    // above rather than written out, so the consumer's host and name each appear in
    // exactly one place (and so this public tree gains no new sibling-project literal
