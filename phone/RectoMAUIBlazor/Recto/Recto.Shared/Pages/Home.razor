    // seeded into Connected Services when demo mode activates. Value
    // matches the BuildDemoPendingRequest's synthetic AppContext.AppId
    // (and the demo ManagedSecretRef service name) so the same sentinel
    // identifies the demo throughout the codebase. Used by the unpair
    // confirm-action path to choose between the canonical confirm-text
    // and the "Exit demo mode" variant.
    private const string DemoServiceAppId = "demo-service";
    private const string DemoServiceAppName = "Demo Service";
    private const string DemoServiceAppDescription = "App Review canary";

    // ManifestVersion: pinned to the manifest_v1.json version this phone
    // was authored against. Phase H added the devices:pair action at
    // 2026-05-19; the JWS payload's cap.registry_version field carries
    // this value so verifiers know which manifest to validate against.
    private const string PairServiceManifestVersion = "2026-05-19";

    private string _pairServiceCode = string.Empty;
    private bool _pairServiceBusy;
    private string _pairServiceBusyText = string.Empty;
    private string? _pairServiceError;
    private string? _pairServiceSuccessMessage;

    // Build 6 (2026-06-02): warm-start consumer gap fix.
    //
    // The cold-launch consume path at OnInitializedAsync (DeepLink.TryConsume)
    // only fires once per page mount — which means recto:// URLs tapped from
    // the OS Camera app while Recto Agentic is ALREADY foregrounded reach
    // SetGlobal but never propagate to the UI because OnInitializedAsync
    // doesn't re-fire on warm resume. The PayloadArrived event closes the
    // gap: SetGlobal fires the event after writing s_pending, this stored
    // handler reference subscribes in OnInitializedAsync + unsubscribes in
    // DisposeAsync, and the routing logic in ProcessPairDeepLinkPayloadAsync
    // serves BOTH the cold-launch TryConsume branch AND the warm-resume
    // event-handler branch.
    //
    // Stored as a field (not an inline lambda) so the same delegate
    // reference can be passed to += AND -= — anonymous delegates would
    // produce two distinct delegate instances at the call sites and the
    // unsubscription would silently no-op, leaking the subscription past
    // the page's lifetime.
    private Action<PairDeepLinkPayload>? _payloadArrivedHandler;

    // Build 12 (2026-07-11): stored wake-signal handler, same field-not-lambda
    // discipline as _payloadArrivedHandler so += and -= reference one delegate.
    // A native push raises IPushWakeSignal.WakeRequested; this fetches pending
    // immediately (marshaled to the render sync-context, guarded against
    // firing after dispose per the static-event-field gotcha).
    private Action? _pushWakeHandler;

    // Build 12: set in DisposeAsync so the process-lifetime wake-signal event
    // (static field, outlives this page) can't fetch on a disposed component.
    private bool _disposed;

    // Set on successful pair to drive the .rec-service-row-highlighted
    // transient animation on the new Connected Services row. Reset when
    // the operator dismisses the success card OR starts another pair.
    // Sister of the chat-tier "social-chat pill" one-time-glow pattern
    // banked in the consumer's Phase D notes.
    private string? _pairServiceHighlightedAppId;

    // Build 6 (2026-06-02): per-service unpair UX state.
    //
    // When the operator taps "Unpair this service" inside the rec-
    // service-panel, _pendingUnpairAppId is set to that AppId so the
    // panel renders an inline two-step confirm row ("Are you sure?
    // [Cancel] [Confirm unpair]"). Tapping the same row's Cancel
    // (or opening a different service's panel) resets to null.
    // Tapping Confirm fires HandleConfirmUnpairServiceAsync which
    // calls Registry.UnpairAsync + reloads _connectedServices +
    // closes the panel.
    //
    // Local-only semantics: this UI removes the service from the
    // phone-side Connected Services list. The consumer-side trust
    // state (master pubkey binding on the User row) is NOT revoked
    // until the v1.x devices:pairing_revoke endpoint ships. v1
    // accepts the gap because the demo-service unpair (App Store
    // reviewer path) doesn't have any consumer-side trust state to
    // begin with — the demo bootloader URL is a sentinel.
    private string? _pendingUnpairAppId;

    // Async-busy flag while UnpairAsync is in flight. Prevents
    // double-tap firing the unpair twice + dims the Confirm button.
    private bool _unpairServiceBusy;

    // Surfaces an unpair-fail error message inside the service panel
    // when UnpairAsync returns Result.Failure. Self-clears on next
    // OpenServicePanel.
    private string? _unpairServiceError;
    private string _pairServiceTargetName => DefaultConsumerAppName;

    // True when the operator entered the App Review demo code. We accept
    // ANY bootloader URL value (including empty) so the reviewer can hit
    // "Pair" without typing a real URL -- the demo flow bypasses HTTP
    // entirely.
    private bool IsDemoPairAttempt =>
        _pairingCode == DemoPairingCode;

    // True when the current pairing is a demo-mode pairing (used by the
    // polling loop + approve handlers to short-circuit HTTP calls).
    private bool IsDemoMode =>
        _paired is not null
        && _paired.BootloaderUrl.StartsWith("demo://", StringComparison.OrdinalIgnoreCase);

    private bool CanPair =>
        !_busy
        && _pairingCode.Length == 6
        && _pairingCode.All(char.IsDigit)
        // Real-pair path requires a bootloader URL; demo-pair path doesn't.
        && (IsDemoPairAttempt || !string.IsNullOrWhiteSpace(_bootloaderUrl));

    private bool CanSubmitPairService =>
        _paired is not null
        && !_pairServiceBusy
        && _pairServiceCode.Length == 8
        && _pairServiceCode.All(char.IsLetterOrDigit);

    protected override async Task OnInitializedAsync()
    {
        // Build 5 (2026-06-02): pre-flight biometric availability check.
        // Runs ONCE on mount + every time RefreshBiometricsStatusAsync is
        // invoked (after Start fresh, after pairing state change). Without
        // this, an iPhone with no Face ID enrolled would reach the
        // Secure Enclave keygen call + fail with OSStatus -25293, which
        // is what Apple's reviewer hit in Build 4 — banner now surfaces
        // the action ("Enroll Face ID in Settings") proactively.
        await RefreshBiometricsStatusAsync(CancellationToken.None);

        var current = await Pairing.GetCurrentAsync(CancellationToken.None);
        if (current.IsSuccess)
        {
            _paired = current.Value;
        }

        if (_paired is not null)
        {
            // Build 12: rehydrate the session failover list from the restored
            // pairing (primary retried first per RebuildFailoverCandidates).
            RebuildFailoverCandidates();
            RestorePin(_paired);
            if (IsDemoMode)
            {
                // App Review demo-mode (banked 2026-05-22). No real
                // bootloader to poll. On app relaunch we restore the
                // demo pairing and re-surface the synthetic pending
                // request so the reviewer sees the full Paired-state
                // UX exactly as it looked when they first paired.
                _pending = new List<PendingRequest> { BuildDemoPendingRequest() };
            }
            else
            {
                StartPolling();
                await RefreshRegisteredPhonesAsync(CancellationToken.None);
            }
        }

        // Task #22 Phase 1 (banked 2026-05-31): consume any pending
        // recto://pair?... deep-link payload pushed by the platform
        // URL handlers (iOS AppDelegate.OpenUrl, Android MainActivity
        // .OnCreate / OnNewIntent). Single-consume semantics — the
        // payload clears on the first read so a back-navigation +
        // re-mount of Home.razor won't re-surface a stale pre-fill.
        //
        // Only meaningful when the phone is ALREADY paired with a
        // bootloader (the "Pair a service" surface is hidden in the
        // un-paired state). If the deep-link fires before the phone
        // has paired with any bootloader, the payload sits in the
        // singleton until the user finishes initial pairing, then
        // gets consumed on the first Home.razor render that comes
        // back through here. Cold-launch race acceptable: this
        // is operator-driven (they tapped a link) and re-tap recovers.
        //
        // v1 ignores payload.BootloaderUrl per the hardcoded-consumer
        // posture (DefaultConsumerBaseUrl). v1.1 polish (banked):
        // gate BootloaderUrl consumption behind a known-consumers
        // allowlist fetched from the bootloader's manifest. See
        // IPairDeepLinkState.cs design rationale.
        // Deep-link consumer: route by Kind (banked 2026-06-01 alongside
        // the demo-mode QR primitive, task #41). Service-kind URLs only
        // make sense when ALREADY paired (they pre-fill the "Pair a
        // service" form); Bootloader-kind URLs only make sense when NOT
        // YET paired (they pre-fill the bootloader-pair form, canonical
        // first-use being the App Store reviewer demo QR). Mismatched
        // state silently drops the payload -- no UI surface to express
        // "you scanned a demo QR but you're already paired"; operator
        // can unpair + rescan to recover.
        //
        // Build 6 (2026-06-02) warm-start fix:
        // 1. SUBSCRIBE TO PayloadArrived FIRST so warm-resume payloads
        //    (recto:// URL tapped while the app is foregrounded) reach
        //    the routing logic. OnInitializedAsync fires once per page
        //    mount, so without this subscription the warm-resume case
        //    silently sits in s_pending forever.
        // 2. THEN TryConsume to pick up any cold-launch payload that
        //    landed before subscription. If SetGlobal happens to fire
        //    between subscribe and TryConsume, BOTH branches deliver
        //    the same payload to ProcessPairDeepLinkPayloadAsync, which
        //    is idempotent on the same payload (assignments to
        //    _pairServiceCode / _pairingCode are last-write-wins on the
        //    same value).
        // 3. Routing logic extracted to ProcessPairDeepLinkPayloadAsync
        //    so the cold-launch path AND the warm-resume event-handler
        //    path serve the same code.
        _payloadArrivedHandler = OnPairDeepLinkPayloadArrived;
        DeepLink.PayloadArrived += _payloadArrivedHandler;

        // Build 12: subscribe to silent-push wakes (same field-referenced
        // handler discipline). A push nudges an immediate pending-fetch.
        _pushWakeHandler = OnPushWakeRequested;
        PushWake.WakeRequested += _pushWakeHandler;

        var deepLink = DeepLink.TryConsume();
        if (deepLink is not null)
        {
            await ProcessPairDeepLinkPayloadAsync(deepLink);
        }
    }

    /// <summary>
    /// Build 12 wake handler. Fires on a platform thread when a silent push
    /// arrives; marshals to the Blazor sync-context and fetches pending
    /// immediately (the accelerant over the poll loop). No-ops when not
    /// paired, in demo mode, or already disposed.
    /// </summary>
    private void OnPushWakeRequested()
    {
        if (_disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (_disposed || _paired is null || IsDemoMode) return;
            try
            {
                await RefreshPendingAsync(_pollCts?.Token ?? CancellationToken.None);
            }
            catch
            {
                // A failed wake-fetch is harmless — the poll loop retries.
            }
        });
    }

    /// <summary>
    /// Warm-resume event handler. Fires on the platform UI thread when
    /// <see cref="IPairDeepLinkState.PayloadArrived"/> raises. Marshals
    /// to the Blazor sync-context via <see cref="ComponentBase.InvokeAsync"/>
    /// before touching component state.
    /// </summary>
    /// <remarks>
    /// Build 6 (2026-06-02): closes the warm-start consumer gap that bit
    /// Apple App Review 1.0.1 (4) when the reviewer tapped recto:// from
    /// Mail while Recto Agentic was already foregrounded.
    /// <para>
    /// Calls <c>TryConsume</c> first to clear the slot so a future
    /// cold-launch doesn't replay this payload. The slot-clear is
    /// idempotent — if the cold-launch path already consumed (shouldn't
    /// happen, since the event fires only on push), this returns null
    /// and the routing call uses the captured <paramref name="payload"/>.
    /// </para>
    /// </remarks>
    private void OnPairDeepLinkPayloadArrived(PairDeepLinkPayload payload)
    {
        // Discard return — InvokeAsync queues the work; we don't block
        // the platform UI thread on Blazor's render loop.
        _ = InvokeAsync(async () =>
        {
            try
            {
                // Clear the slot. Future cold-launches start clean.
                DeepLink.TryConsume();
                await ProcessPairDeepLinkPayloadAsync(payload);
                StateHasChanged();
            }
            catch
            {
                // Warm-resume path runs against a possibly-disposed
                // component (event can fire after DisposeAsync raced
                // unsubscribe). Silent swallow — there's no UI surface
                // to render an error to anyway, and the unsubscribe in
                // DisposeAsync should prevent this case in practice.
            }
        });
    }

    /// <summary>
    /// Canonical routing logic for a pair-deep-link payload. Serves both
    /// cold-launch (from <see cref="OnInitializedAsync"/>'s TryConsume
    /// branch) and warm-resume (from
    /// <see cref="OnPairDeepLinkPayloadArrived"/>). Mutations are
    /// idempotent on repeated invocations of the same payload.
    /// </summary>
    private async Task ProcessPairDeepLinkPayloadAsync(PairDeepLinkPayload deepLink)
    {
        if (deepLink.Kind == PairDeepLinkKind.Service)
        {
            // Build 7 (banked 2026-06-02 night): end-user first-pair UX.
            // When the phone is NOT yet paired with a bootloader AND the
            // QR carries bootstrap_bootloader + bootstrap_pair_code, run
            // the first-pair ceremony — pre-fill the bootloader URL +
            // bootloader-pair code from the QR, stash the Service code
            // for auto-fire post-pair, surface the first-pair banner.
            // Single tap covers both phases (bootloader pair → service
            // pair). Sister case to the canonical Phase H end-user
            // pair-a-service flow but for the cold-start case where the
            // phone has no bootloader paired yet (the load-bearing case
            // for a downstream consumer's public launch — end users
            // install Recto Phone, sign up on the consumer's web
            // surface, scan the QR, done).
            //
            // Branch order matters: check FIRST-PAIR CEREMONY before
            // the already-paired Phase H branch so an unpaired phone
            // scanning an end-user QR enters the ceremony rather than
            // silently dropping the payload.
            var hasBootstrap = !string.IsNullOrEmpty(deepLink.BootstrapBootloaderUrl)
                && !string.IsNullOrEmpty(deepLink.BootstrapPairCode);

            if (_paired is null && hasBootstrap)
            {
                // First-pair ceremony entry. Pre-fill the existing
                // bootloader-pair form fields + stash the Service code
                // for the post-pair auto-fire. _firstPairCeremonyActive
                // gates the banner render above the pair card; the
                // existing Pair button + HandlePairClick handle the
                // actual bootloader pair.
                _bootloaderUrl = deepLink.BootstrapBootloaderUrl!;
                _pairingCode = deepLink.BootstrapPairCode!;
                _pendingServicePairCodeAfterFirstPair = deepLink.Code.ToUpperInvariant();
                _firstPairCeremonyActive = true;
                _errorMessage = null;
                StateHasChanged();
                return;
            }

            // Phase H end-user pair-a-service. Only makes sense when
            // already paired with a real (non-demo) bootloader.
            // Pre-paired-or-demo-mode state silently drops the
            // payload -- the "Pair a service" form doesn't exist
            // until pairing completes.
            if (_paired is not null && !IsDemoMode)
            {
                _pairServiceCode = deepLink.Code.ToUpperInvariant();
                _pairServiceError = null;
                _pairServiceSuccessMessage = null;
                // Auto-open the "Pair a service" <details> accordion
                // via JS interop so the pre-filled code is
                // immediately visible to the user (otherwise they'd
                // have to scroll down + tap "Add a service" to
                // discover the pre-fill). The element id is the
                // canonical pair-service-code input; setting open on
                // its parent <details> ancestor.
                try
                {
                    await JS.InvokeVoidAsync(
                        "eval",
                        "var el = document.getElementById('pair-service-code'); if (el) { var d = el.closest('details'); if (d) { d.open = true; el.focus(); } }");
                }
                catch
                {
                    // JS interop can fail before the BlazorWebView
                    // is fully wired on cold-launch. Silent
                    // swallow -- the pre-fill still landed; the
                    // operator just has to tap "Add a service"
                    // manually to see it.
                }
            }
        }
        else // PairDeepLinkKind.Bootloader
        {
            // Bootloader-pair flow (App Store reviewer demo QR is the
            // canonical first use). Only makes sense when NOT yet
            // paired -- the bootloader-pair form is only rendered in
            // the unpaired state. If already paired, drop silently;
            // the operator can unpair via Settings and re-scan.
            if (_paired is null)
            {
                _pairingCode = deepLink.Code;
                // Bootloader URL is required for bootloader-kind URLs
                // (PairDeepLinkParser enforces; the null-check is
                // defense-in-depth).
                if (!string.IsNullOrEmpty(deepLink.BootloaderUrl))
                {
                    _bootloaderUrl = deepLink.BootloaderUrl;
                }
                _errorMessage = null;
                // Bootloader-pair form is the unpaired-state main
                // screen -- no accordion to open, no scroll needed.
                // The pre-filled values appear immediately on the
                // next render. CanPair re-evaluates against the new
                // values + the operator just taps the Pair button.
            }
        }
    }

    // Build 5 (2026-06-02): pre-flight biometric availability probe.
    // Called from OnInitializedAsync + after any pairing state change.
    // Updates _biometricsStatusMessage so the Pair card surfaces a clear
    // actionable warning when the device's biometric subsystem isn't
    // ready. NoneEnrolled / NoPasscode are the cases that triggered
    // Apple's Build 4 rejection (raw OSStatus -25293 dumped to the
    // alert-danger card mid-keygen).
    private async Task RefreshBiometricsStatusAsync(CancellationToken ct)
    {
        try
        {
            var status = await Biometrics.CheckAsync(ct);
            _biometricsStatusMessage = IBiometricsAvailability.GetUserMessage(status);
        }
        catch (Exception)
        {
            // Biometric probe failed — leave message null so keygen
            // surfaces the actual error via EnclaveErrors.Translate.
            _biometricsStatusMessage = null;
        }
    }

    // Build 5 (2026-06-02): "Start fresh" button on the demo-mode paired
    // banner. Replaces the prior "Use Settings → Unpair all bootloaders
    // to exit" text instruction with a one-tap action. Sister of
    // Settings.razor's UnpairAllAsync sequence:
    //   1. Pairing.SaveAsync(null) — clears persisted pairing.
    //   2. Totp.ClearAllAsync() — clears any provisioned TOTP secrets.
    //   3. EnclaveKeys.DeleteAsync(KeyAlias) — wipes the enclave keypair.
    //   4. Navigate to "/" — re-mount Home.razor in unpaired state.
    //
    // The button is intentionally NOT a destructive-red treatment because
    // demo-mode pairings carry no real authority — losing them is a no-op
    // for any real workflow. A real-pairing equivalent stays in Settings
    // behind the two-step confirmation (Hard Rule #9 — phone enclave as
    // root of trust; deleting real key material should NOT be one tap).
    private async Task HandleStartFreshClick()
    {
        if (_busy) return;
        _busy = true;
        _busyText = "Starting fresh...";
        StateHasChanged();

        try
        {
            // The wipe core (pairing → TOTP → enclave key) routes through
            // IUnpairService so the genesis guard covers this path too:
            // demo-mode "shouldn't" coexist with a genesis membership, but
            // "shouldn't" is not a boundary — a genesis member pressing
            // Start fresh gets the same refusal naming the recovery
            // ceremony. (The pre-guard sequence swallowed a missing demo
            // key; the service's Failed status covers that — Start fresh
            // stays best-effort.)
            var wipe = await Unpair.UnpairAllAsync(KeyAlias, CancellationToken.None);
            if (wipe.Status == UnpairAllStatus.RefusedGenesisMember)
            {
                _errorMessage = wipe.Message;
                return;
            }
            // Build 6 (2026-06-02): also wipe Connected Services so the
            // Demo Service entry (seeded into the list when demo mode
            // activated) disappears with the rest of the demo-state
            // cleanup. ClearAllAsync removes ALL services — acceptable
            // in demo mode because real pairings shouldn't coexist with
            // a demo pairing.
            await Registry.ClearAllAsync(CancellationToken.None);

            // Reset all in-memory state so we land cleanly on the
            // unpaired Pair card on the next render.
            _paired = null;
            _pending.Clear();
            _connectedServices = Array.Empty<ConnectedService>();
            _pairServiceHighlightedAppId = null;
            _bootloaderUrl = DemoBootloaderUrl;
            _pairingCode = string.Empty;
            _errorMessage = null;
            await RefreshBiometricsStatusAsync(CancellationToken.None);

            // Force a re-render by navigating to "/" — works on both
            // iOS WebKit + Android WebView identically. NavigationManager
            // re-mounts Home.razor cleanly.
            Nav.NavigateTo("/", forceLoad: false);
        }
        finally
        {
            _busy = false;
            _busyText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task HandlePairClick()
    {
        _errorMessage = null;
        _busy = true;
        try
        {
            // App Review demo-mode branch (banked 2026-05-22). When the
            // operator typed the demo code, short-circuit the HTTP pairing
            // handshake entirely and run the demo flow. The biometric +
            // Secure Enclave key generation + ECDSA signing all fire REAL
            // so Apple's reviewer sees the full UX -- only the network
            // round-trip is mocked.
            if (IsDemoPairAttempt)
            {
                await RunDemoPairFlowAsync();
                return;
            }

            await SetBusyTextAsync("Identifying phone...");
            var phoneIdResult = await Pairing.GetOrCreatePhoneIdAsync(CancellationToken.None);
            if (phoneIdResult.IsFailure)
            {
                _errorMessage = phoneIdResult.Error.Message;
                return;
            }
            var phoneId = phoneIdResult.Value;

            await SetBusyTextAsync("Contacting bootloader...");
            var challengeResult = await BootloaderClient.GetRegistrationChallengeAsync(
                _bootloaderUrl, _pairingCode, CancellationToken.None);
            if (challengeResult.IsFailure)
            {
                _errorMessage = challengeResult.Error.Message;
                return;
            }
            var challenge = challengeResult.Value;

            await SetBusyTextAsync("Preparing identity key...");
            var existsResult = await EnclaveKeys.KeyExistsAsync(KeyAlias, CancellationToken.None);
            EnclavePublicKey publicKey;
            if (existsResult.IsSuccess && existsResult.Value)
            {
                var pubResult = await EnclaveKeys.GetPublicKeyAsync(KeyAlias, CancellationToken.None);
                if (pubResult.IsFailure)
                {
                    _errorMessage = pubResult.Error.Message;
                    return;
                }
                publicKey = pubResult.Value;
            }
            else
            {
                var genResult = await EnclaveKeys.GenerateAsync(KeyAlias, CancellationToken.None);
                if (genResult.IsFailure)
                {
                    _errorMessage = genResult.Error.Message;
                    return;
                }
                publicKey = genResult.Value;
            }

            await SetBusyTextAsync("Awaiting biometric approval...");
            // Canonical challenge-signing convention (Build 9 fix): sign the
            // LITERAL ASCII BYTES of the base64url challenge string -- the
            // same bytes the bootloader's verifier checks
            // (payload=challenge.encode("ascii")). Pre-Build-9 binaries
            // base64url-DECODED the challenge first and only paired because
            // the server carries a temporary decode-fallback leniency in
            // verify_signature; that leniency is scheduled for removal once
            // this build saturates the store rollout. Do NOT reintroduce
            // Base64UrlDecode here.
            var challengeBytes = System.Text.Encoding.ASCII.GetBytes(challenge.ChallengeB64u);
            var signResult = await EnclaveKeys.SignAsync(KeyAlias, challengeBytes, CancellationToken.None);
            if (signResult.IsFailure)
            {
                _errorMessage = signResult.Error.Message;
                return;
            }

            await SetBusyTextAsync("Fetching push token...");
            // Best-effort: a push-token failure is non-fatal -- pairing still
            // works, the bootloader just falls back to the 3s poll cycle for
            // this phone. Windows / Mac Catalyst dev hosts return null
            // (NoOpPushTokenService); Android / iOS return real tokens.
            string? pushToken = null;
            string? pushPlatform = null;
            try
            {
                var pushResult = await PushTokens.GetTokenAsync(CancellationToken.None);
                if (pushResult.IsSuccess && pushResult.Value is not null)
                {
                    pushToken = pushResult.Value.Token;
                    pushPlatform = pushResult.Value.Platform;
                }
            }
            catch { /* swallow -- pairing must not fail because push wasn't available */ }

            await SetBusyTextAsync("Registering with bootloader...");
            var deviceLabel = $"Recto / {FormFactor.GetFormFactor()}";
            var request = new RegistrationRequest(
                PhoneId: phoneId,
                DeviceLabel: deviceLabel,
                PublicKeyB64u: Base64UrlEncode(publicKey.PublicKey),
                SupportedAlgorithms: new[] { publicKey.Algorithm },
                V04Protocol: V04Protocol.Version,
                RegistrationProof: new RegistrationProof(
                    Challenge: challenge.ChallengeB64u,
                    SignatureB64u: Base64UrlEncode(signResult.Value)),
                PushToken: pushToken,
                PushPlatform: pushPlatform);

            var registerResult = await BootloaderClient.RegisterAsync(
                _bootloaderUrl, request, CancellationToken.None);
            if (registerResult.IsFailure)
            {
                _errorMessage = registerResult.Error.Message;
                return;
            }

            string? capturedPin = TryCaptureBootloaderPin(_bootloaderUrl);

            var registration = registerResult.Value;

            // GATE 5b, phone half: an rb1- id is a CLAIM — recompute it from
            // the key set the bootloader presented, and refuse a pairing
            // whose identity does not verify. Receive-only would make the id
            // a label nobody checks; a look-alike deployment at any hostname
            // could then claim any identity and be believed. NoClaim (legacy
            // / demo ids) passes through unchanged.
            var identityCheck = BootloaderIdentity.Check(
                registration.BootloaderId, registration.Identity);
            if (identityCheck.Status == BootloaderIdentityStatus.Refused)
            {
                _errorMessage = identityCheck.Reason;
                return;
            }

            // Genesis membership, discovered by arithmetic: a phone that
            // finds ITS OWN enclave key in a VERIFIED identity's member set
            // is a genesis member, and arms the unpair-all guard by marking
            // itself with the derived id. Fail-soft: the pairing already
            // succeeded server-side, so a marking failure is surfaced on
            // the next unpair attempt (the guard fails closed there) rather
            // than aborting a valid pairing here.
            if (identityCheck.Status == BootloaderIdentityStatus.Verified
                && BootloaderIdentity.IsMemberOfIdentity(
                    publicKey.PublicKey, registration.Identity))
            {
                await Genesis.MarkGenesisMemberAsync(
                    registration.BootloaderId, CancellationToken.None);
            }

            var pairedState = new PairingState(
                PhoneId: registration.PhoneId,
                BootloaderId: registration.BootloaderId,
                BootloaderUrl: _bootloaderUrl,
                ManagedSecrets: registration.ManagedSecrets
                    .Select(s => new ManagedSecretRef(s.Service, s.Secret, s.Algorithm))
                    .ToArray(),
                PairedAt: DateTimeOffset.UtcNow,
                BootloaderSpkiPin: capturedPin,
                // Build 12: capture the bootloader's advertised failover list
                // at pairing time (null on single-instance deployments).
                BootloaderUrls: registration.BootloaderUrls);

            var saveResult = await Pairing.SaveAsync(pairedState, CancellationToken.None);
            if (saveResult.IsFailure)
            {
                _errorMessage = saveResult.Error.Message;
                return;
            }

            _paired = pairedState;
            RebuildFailoverCandidates();
            StartPolling();
            await RefreshRegisteredPhonesAsync(CancellationToken.None);

            // Build 7 (banked 2026-06-02 night): post-bootloader-pair
            // continuation of the end-user first-pair ceremony. When
            // _firstPairCeremonyActive is set, the user came in via a
            // Service-kind QR with bootstrap_bootloader + bootstrap_pair_code
            // + a Service-pair code stashed in
            // _pendingServicePairCodeAfterFirstPair. Now that the
            // bootloader pair succeeded, auto-fire the Phase H service-
            // pair flow with the carried code so the user doesn't have
            // to tap a second time.
            if (_firstPairCeremonyActive
                && !string.IsNullOrEmpty(_pendingServicePairCodeAfterFirstPair))
            {
                _pairServiceCode = _pendingServicePairCodeAfterFirstPair;
                _pairServiceError = null;
                _pairServiceSuccessMessage = null;
                // Clear first-pair state BEFORE firing HandlePairServiceClick
                // so a failure in the service-pair phase doesn't loop us
                // back to the first-pair ceremony. The bootloader is
                // already paired; on service-pair failure the user can
                // re-scan or enter the service code manually via the
                // canonical Phase H surface.
                _firstPairCeremonyActive = false;
                _pendingServicePairCodeAfterFirstPair = null;
                // Auto-fire after a brief beat so the user sees the
                // bootloader-pair success render before the service-pair
                // busy state takes over. _busy is currently true; we
                // intentionally don't clear it between phases — the
                // outer try/finally below clears it once both phases
                // resolve, OR after HandlePairServiceClick runs its
                // own busy lifecycle. Per HandlePairServiceClick's
                // shape it manages _busy independently; clear ours now.
                _busy = false;
                _busyText = string.Empty;
                StateHasChanged();
                await Task.Delay(300);
                await HandlePairServiceClick();
                return;
            }
        }
        finally
        {
            _busy = false;
            _busyText = string.Empty;
            StateHasChanged();
        }
    }

    // App Review demo-mode pairing flow (banked 2026-05-22). Skips every
    // HTTP round-trip but otherwise mirrors HandlePairClick so the
    // reviewer sees the canonical biometric + Secure Enclave key
    // generation path firing. _busy / _busyText / _errorMessage state
    // is managed by HandlePairClick's outer try/finally; this method
    // only sets _busyText / _errorMessage along the way.
    private async Task RunDemoPairFlowAsync()
    {
        await SetBusyTextAsync("Identifying phone...");
        var phoneIdResult = await Pairing.GetOrCreatePhoneIdAsync(CancellationToken.None);
        if (phoneIdResult.IsFailure)
        {
            _errorMessage = phoneIdResult.Error.Message;
            return;
        }
        var phoneId = phoneIdResult.Value;

        await SetBusyTextAsync("Preparing demo bootloader...");
        // Give the reviewer a moment to read "Preparing demo bootloader"
        // before the biometric prompt fires; the real flow has a similar
        // beat where it's waiting on the network.
        await Task.Delay(400);

        await SetBusyTextAsync("Preparing identity key...");
        //
        // Build 10 (2026-06-04, App Review -25293 graceful-degrade): the
        // Build 3-era demo flow exercised real Secure Enclave keygen +
        // sign to "prove the cryptographic identity path works end-to-end
        // on the reviewer's device." Architecturally clean, but it
        // structurally blocks Apple's reviewers — their test devices
        // don't enroll Face ID or set a passcode, so the
        // BiometryCurrentSet | PrivateKeyUsage ACL on the Secure Enclave
        // key returns errSecAuthFailed (-25293). Build 4 + Build 9 both
        // got rejected for the same -25293 error (Apple's reviewer's
        // iPad screenshot 2026-06-01 explicitly shows it).
        //
        // Build 10's fix: try the real Secure Enclave path FIRST (still
        // exercises real crypto when biometric IS enrolled — the
        // canonical real-user state). If keygen fails (any reason, but
        // typically -25293 on review devices), fall through to a
        // synthetic in-memory publicKey + skip the SignAsync call. Demo
        // mode bypasses the network handshake to a real bootloader
        // entirely, so the generated key isn't actually sent anywhere —
        // its cryptographic validity is irrelevant for any downstream
        // code path. The synthetic key is 64 zero bytes + ecdsa-p256
        // algorithm tag for protocol-shape consistency with the
        // ManagedSecretRef + PairingState records.
        //
        // Real users with biometric enrolled hit the real path (no
        // behavior change). App Review reviewers + any user who hasn't
        // set up biometric land on the fallback and demo mode completes.
        //
        var existsResult = await EnclaveKeys.KeyExistsAsync(KeyAlias, CancellationToken.None);
        EnclavePublicKey publicKey;
        bool keygenSucceeded = false;
        if (existsResult.IsSuccess && existsResult.Value)
        {
            var pubResult = await EnclaveKeys.GetPublicKeyAsync(KeyAlias, CancellationToken.None);
            if (pubResult.IsSuccess)
            {
                publicKey = pubResult.Value;
                keygenSucceeded = true;
            }
            else
            {
                // Existing-key fetch failed (rare — corruption, OS
                // quirk, etc.). Fall through to synthetic for demo mode.
                publicKey = new EnclavePublicKey(
                    new byte[64], V04Protocol.AlgorithmEcdsaP256);
            }
        }
        else
        {
            var genResult = await EnclaveKeys.GenerateAsync(KeyAlias, CancellationToken.None);
            if (genResult.IsSuccess)
            {
                publicKey = genResult.Value;
                keygenSucceeded = true;
            }
            else
            {
                // Secure Enclave keygen failed. Typically errSecAuthFailed
                // (-25293) when no biometric/passcode is enrolled — the
                // canonical App Review reviewer state. Synthesize a
                // protocol-shaped publicKey so demo mode can complete.
                publicKey = new EnclavePublicKey(
                    new byte[64], V04Protocol.AlgorithmEcdsaP256);
            }
        }

        // Only attempt the real-sign path if we have a real Secure
        // Enclave key. The synthetic-fallback key can't sign (no private
        // half), and even when there IS a real key, SignAsync hits the
        // same biometric prompt + can fail with -25293 if biometric was
        // removed between keygen and sign. Demo mode doesn't transmit
        // the signature anywhere, so a failed sign is equivalent to a
        // successful sign — both produce the same "Paired with
        // demo://recto-app-review" end state.
        if (keygenSucceeded)
        {
            await SetBusyTextAsync("Awaiting biometric approval...");
            var challengeBytes = System.Text.Encoding.ASCII.GetBytes(
                $"recto-app-review-demo-pair:{phoneId}");
            // Discard result — failure here is non-fatal in demo mode.
            _ = await EnclaveKeys.SignAsync(KeyAlias, challengeBytes, CancellationToken.None);
        }

        await SetBusyTextAsync("Finalizing demo pairing...");

        var pairedState = new PairingState(
            PhoneId: phoneId,
            BootloaderId: DemoBootloaderId,
            BootloaderUrl: DemoBootloaderUrl,
            ManagedSecrets: new[]
            {
                new ManagedSecretRef("demo-service", "demo-secret", publicKey.Algorithm),
            },
            PairedAt: DateTimeOffset.UtcNow,
            // Synthetic demo SPKI pin — shows the TLS pin feature in demo mode
            // (with Copy / QR buttons functional on a load-bearing trust
            // artifact) while staying honest via the "demo placeholder"
            // subscript in the render. See DemoBootloaderSpkiPin comment block
            // above for the architectural rationale (option B from the
            // honest-trade-off matrix).
            BootloaderSpkiPin: DemoBootloaderSpkiPin);

        var saveResult = await Pairing.SaveAsync(pairedState, CancellationToken.None);
        if (saveResult.IsFailure)
        {
            _errorMessage = saveResult.Error.Message;
            return;
        }

        _paired = pairedState;
        // Surface one synthetic SingleSign pending request so the
        // reviewer can also exercise the approve flow with another
        // real biometric prompt. ApproveSingleSignAsync detects
        // IsDemoMode and short-circuits the HTTP response POST.
        _pending = new List<PendingRequest> { BuildDemoPendingRequest() };

        // Build 6 (2026-06-02): seed the Demo Service entry into the
        // Connected Services registry. RefreshPendingAsync is gated by
        // IsDemoMode and won't fire the canonical Registry.RecordObserved
        // path that real-bootloader requests use, so the demo
        // AppContext must be explicitly threaded through here.
        // Sister of the post-real-pair seeding in HandlePairServiceClick.
        var demoAppContext = _pending[0].Context.AppContext;
        if (demoAppContext is not null)
        {
            await Registry.RecordObservedAsync(demoAppContext, CancellationToken.None);
            var connected = await Registry.GetAllAsync(CancellationToken.None);
            _connectedServices = connected.IsSuccess
                ? connected.Value
                : Array.Empty<ConnectedService>();
            // Tee up the same one-time-glow animation on the Demo
            // Service row that real-service pairs get.
            _pairServiceHighlightedAppId = DemoServiceAppId;
        }

        // NOTE: deliberately do NOT call StartPolling() here. Demo mode
        // has no bootloader to poll; the synthetic pending request is
        // already in _pending. RefreshPendingAsync ALSO no-ops in demo
        // mode as a defensive belt-and-suspenders.
    }

    // Builds the synthetic SingleSign request the demo-mode flow surfaces
    // to the reviewer after pairing. ApproveSingleSignAsync's enclave
    // signing call uses Context.PayloadHashB64u, so we populate it with
    // SHA-256 of a recognizable demo payload.
    private static PendingRequest BuildDemoPendingRequest()
    {
        var requestId = Guid.NewGuid().ToString();
        var payload = System.Text.Encoding.UTF8.GetBytes(
            "Recto App Review demo: tap Approve to fire a real biometric prompt + real Secure Enclave signature.");
        var hash = System.Security.Cryptography.SHA256.HashData(payload);
        var hashB64u = Convert.ToBase64String(hash)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');

        // Synthetic AppContext for the demo request so the phone renders a
        // clean AppContext banner ("Demo Service") instead of the orange
        // "Unknown app — No AppContext registered for this principal"
        // warning that would normally fire on principals without registered
        // app metadata. The warning is correct behavior for real-world
        // signing requests (operator should verify identity before
        // approving), but on a demo card it reads as "your demo is broken"
        // to App Store reviewers. Banked 2026-05-22 evening after the
        // iPhone 17 Pro Max simulator capture surfaced the warning during
        // the screenshot pass; demo-mode commitment is zero visible errors
        // / warnings throughout the reviewer flow.
        // AppDescription deliberately terse — the blue "Demo mode" banner
        // above the pending request already explains the full context to
        // operators / reviewers. A verbose description here pushed the
        // Approve / Deny buttons below the fold on iPhone 17 Pro Max sim.
        var demoAppContext = new Recto.Shared.Protocol.V04.AppContext(
            AppId: "demo-service",
            AppName: "Demo Service",
            AppDescription: "App Store reviewer demo.",
            AppUrl: "demo://recto-app-review",
            AppIconUrl: null,
            AppVersion: "1.0");

        var context = new PendingRequestContext(
            ChildPid: 1234,
            ChildArgv0: "recto-app-review-demo",
            RequestedAtUnix: DateTimeOffset.UtcNow.ToUnixTimeSeconds(),
            OperationDescription:
                "Demo sign request — your biometric will fire the Secure Enclave for real, but the result stays on this device.",
            PayloadHashB64u: hashB64u,
            AppContext: demoAppContext);
        return new PendingRequest(
            RequestId: requestId,
            Kind: PendingRequestKind.SingleSign,
            Service: "demo-service",
            Secret: "demo-secret",
            Context: context);
    }

    // Build 6 (2026-06-02): HandleScanQrClick retired alongside the
    // in-app QR scanner. The OS Camera + recto:// URL-scheme deep-link
    // path picks up the same QR payload via PairDeepLinkParser (running
    // in AppDelegate.OpenUrl on iOS / MainActivity.OnNewIntent on
    // Android) -> InMemoryPairDeepLinkState.SetGlobal -> the
    // PayloadArrived event -> ProcessPairDeepLinkPayloadAsync. The
    // ProcessPairDeepLinkPayloadAsync helper above handles both the
    // service-pair AND bootloader-pair routing that this method used
    // to handle inline.
    //
    // Recto-emitted pairing QRs always wrap the recto:// URL form (the
    // PairingCodeArtifact's QR is generated from the same URL stored
    // in PairingCodeArtifact.DeepLinkUrl), so the OS Camera scan +
    // banner-tap UX picks them up natively without any in-app camera
    // permission, modal scanner UI, or native camera binding (no
    // AVFoundation, no CameraX, no ML Kit Barcode Scanner).
    //
    // QrDecoder (the JSON envelope path) is preserved in
    // Recto.Shared.QR.QrDecoder for future scenarios that need to
    // ingest non-URL QR payloads from sources we don't control, but
    // those flows aren't exposed in v1 of the phone UI.

    // Phase H (2026-05-19 night) — end-user "Pair a service" orchestrator.
    //
    // Builds a self-attested capability JWS over the typed pairing code,
    // POSTs through the bootloader's /v0.4/devices/pair relay to the
    // consumer's /api/v1/devices/pairing/complete verifier. On success,
    // synthesizes an AppContext for the now-paired consumer and pushes
    // it through ConnectedServiceRegistry.RecordObservedAsync so the new
    // entry surfaces in the Vault home's Connected Services list with
    // the .rec-service-row-highlighted animation drawing attention to it
    // for a few seconds.
    //
    // Different shape from HandlePairClick (which pairs the phone WITH
    // the bootloader): no operator-pubkey trust root, no challenge-
    // response handshake. The consumer-side verifier recovers the JWS's
    // signature against the caller-supplied master pubkey hex (self-
    // attested model — sister of WebAuthn's "the device proves it
    // holds the key it claims").
    //
    // Different shape from ApproveCapabilityRequestAsync (which signs
    // an already-staged pending request): the phone constructs the
    // entire JWS from scratch here. No bootloader-pre-staged cap_*_b64
    // segments because there is no pending request — the end-user
    // initiated the flow from the phone itself.
    private async Task HandlePairServiceClick()
    {
        if (_paired is null)
        {
            _pairServiceError = "Phone is not paired with a bootloader yet.";
            return;
        }
        _pairServiceError = null;
        _pairServiceBusy = true;
        _pairServiceBusyText = "Deriving master pubkey...";
        StateHasChanged();
        await Task.Yield();

        try
        {
            // 1) Derive master secp256k1 pubkey at the canonical ETH path
            //    (m/44'/60'/0'/0/0). Same identity primitive as the
            //    capability_request flow — one BIP-39 mnemonic, one
            //    secp256k1 key, multiple capability-bound surfaces.
            //
            // Auto-provision the mnemonic if absent. Fresh-APK-install
            // case (sideload changed signing-cert chain → Android wiped
            // SecureStorage → no mnemonic at alias 'default'): the
            // EnsureMnemonicAsync call generates a fresh 24-word BIP-39
            // mnemonic on first invocation, persists it to SecureStorage,
            // and returns the derived EthAccount. The mnemonic stays
            // intact across subsequent pairings; this call is idempotent
            // on existing mnemonics. Caught 2026-05-31 during the
            // Pixel-Android-16 fresh-install re-pair (Task #40 multi-
            // user pairing test) — the previous error path 'No
            // mnemonic provisioned at alias default' surfaced because
            // DerivePubkeyAtPathAsync is intentionally read-only and
            // does NOT auto-provision (it's the canonical "fail loud
            // if mnemonic missing" path for downstream call sites that
            // shouldn't surprise-mint identity material).
            const string masterPath = "m/44'/60'/0'/0/0";
            var ensureResult = await EthSigner.EnsureMnemonicAsync(
                EthKeyAlias, masterPath, CancellationToken.None);
            if (ensureResult.IsFailure)
            {
                _pairServiceError = $"Could not provision master mnemonic: {ensureResult.Error.Message}";
                return;
            }
            var pubkeyResult = await EthSigner.DerivePubkeyAtPathAsync(
                EthKeyAlias, masterPath, CancellationToken.None);
            if (pubkeyResult.IsFailure)
            {
                _pairServiceError = $"Could not derive master pubkey: {pubkeyResult.Error.Message}";
                return;
            }
            var masterPubkeyHex = BytesToHexLower(pubkeyResult.Value); // 128 chars (X||Y, no 0x04 prefix)
            if (masterPubkeyHex.Length != 128)
            {
                _pairServiceError = $"Master pubkey has wrong length ({masterPubkeyHex.Length} hex chars); expected 128.";
                return;
            }

            // 2) Build the CapabilityClaims dict manually. C# CapabilityScope
            //    record doesn't carry scope-extension fields today (Phase E /
            //    F / G all use partial-canonical-JSON + manual injection at
            //    signing time). Same pattern here for pairing_code.
            _pairServiceBusyText = "Building JWS payload...";
            StateHasChanged();
            await Task.Yield();

            var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
            var exp = now + 300; // 5-min window — short enough that a leaked JWS expires fast, long enough to survive typical network slowness.
            var jti = $"recto-pair-{Guid.NewGuid():N}";
            var pubkeyPrefix = masterPubkeyHex.Length >= 16 ? masterPubkeyHex.Substring(0, 16) : masterPubkeyHex;

            var scopeDict = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["env"] = new List<object?>(),
                ["services"] = new List<object?>(),
                ["repos"] = new List<object?>(),
                ["pairing_code"] = _pairServiceCode,
            };
            var capDict = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["tier"] = (long)0,
                ["registry_version"] = PairServiceManifestVersion,
                ["groups"] = new List<object?>(),
                ["scope"] = scopeDict,
                ["allow_actions"] = new List<object?> { "devices:pair" },
                ["deny_actions"] = new List<object?>(),
                ["limits"] = new Dictionary<string, object?>(StringComparer.Ordinal)
                {
                    ["per_hour"] = new Dictionary<string, object?>(),
                    ["per_day"] = new Dictionary<string, object?>(),
                    ["per_session"] = new Dictionary<string, object?>(),
                },
            };
            var claimsDict = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["iss"] = $"phone:user:{_paired!.PhoneId}",
                ["sub"] = $"user:{pubkeyPrefix}",
                ["aud"] = new List<object?> { DefaultConsumerAud },
                ["iat"] = now,
                ["nbf"] = now,
                ["exp"] = exp,
                ["jti"] = jti,
                ["cap"] = capDict,
                ["purpose"] = $"Bind master pubkey to {DefaultConsumerAppName} via pairing code",
            };

            // 3) Build header + payload + signing input. Use
            //    Recto.Shared.Capability.CanonicalJson to ensure byte-parity
            //    with the Python emitter (the consumer-side verifier
            //    re-encodes the parsed claim dict and signs against the
            //    same canonical form).
            var headerDict = new Dictionary<string, object?>(StringComparer.Ordinal)
            {
                ["alg"] = "ES256K",
                ["typ"] = "JWT",
            };
            var headerBytes = Recto.Shared.Capability.CanonicalJson.Encode(headerDict);
            var headerB64 = Base64UrlEncode(headerBytes);
            var payloadBytes = Recto.Shared.Capability.CanonicalJson.Encode(claimsDict);
            var payloadB64 = Base64UrlEncode(payloadBytes);
            var signingInput = System.Text.Encoding.ASCII.GetBytes($"{headerB64}.{payloadB64}");
            var digest = System.Security.Cryptography.SHA256.HashData(signingInput);

            // 4) Sign the digest with the master key. SignDigestAsync
            //    returns the 64-byte raw r||s (no recovery v byte) — the
            //    shape JWS ES256K (RFC 8812) expects.
            _pairServiceBusyText = "Awaiting biometric...";
            StateHasChanged();
            var signResult = await EthSigner.SignDigestAsync(
                EthKeyAlias, masterPath, digest, CancellationToken.None);
            if (signResult.IsFailure)
            {
                _pairServiceError = $"Signing failed: {signResult.Error.Message}";
                return;
            }
            var signature = signResult.Value;
            if (signature.Length != 64)
            {
                _pairServiceError = $"Signature has wrong length ({signature.Length} bytes); expected 64 raw r||s.";
                return;
            }

            // 5) Assemble the 3-part JWS: header.payload.signature, all
            //    base64url-encoded. The bootloader treats the JWS as an
            //    opaque string and relays it verbatim to the consumer.
            var jws = $"{headerB64}.{payloadB64}.{Base64UrlEncode(signature)}";

            // 6) POST to the bootloader's /v0.4/devices/pair relay.
            _pairServiceBusyText = "Pairing...";
            StateHasChanged();
            var pairReq = new DevicesPairRequest(
                ConsumerBaseUrl: DefaultConsumerBaseUrl,
                PairingCode: _pairServiceCode,
                UserPubkeyHex: masterPubkeyHex,
                UserJws: jws);
            var pairResp = await BootloaderClient.PairDeviceAsync(
                ActiveBootloaderUrl, pairReq, CancellationToken.None);
            if (pairResp.IsFailure)
            {
                _pairServiceError = pairResp.Error.Message;
                return;
            }

            // 7) Inspect the consumer's relayed status. The bootloader
            //    returns 200 with {status, body} containing the consumer's
            //    HTTP status code and parsed JSON body. Consumer success
            //    is 2xx; consumer rejections (pubkey_already_bound,
            //    pairing_code_expired, capability_invalid, etc.) are
            //    surfaced through the body's reason/error field.
            var resp = pairResp.Value;
            if (resp.Status < 200 || resp.Status >= 300)
            {
                var consumerReason = TryExtractConsumerErrorReason(resp.Body);
                _pairServiceError = string.IsNullOrEmpty(consumerReason)
                    ? $"{DefaultConsumerAppName} returned HTTP {resp.Status} — pairing rejected."
                    : $"{DefaultConsumerAppName} rejected the pair: {consumerReason}";
                return;
            }

            // 8) Success path. Populate the Connected Services registry
            //    with a synthesized AppContext for the new consumer (v1
            //    hardcoded; v1.1 will derive these from a known-consumers
            //    manifest fetched from the bootloader). Refresh the local
            //    snapshot, set the highlight flag so the new row renders
            //    with the .rec-service-row-highlighted animation, and
            //    flip the UI to success-state.
            //    Fully-qualified namespace: AppContext collides with
            //    System.AppContext at the bare name when @using
            //    Recto.Shared.Protocol.V04 imports the type. Banked
            //    gotcha in Recto/CLAUDE.md gotchas index.
            var appContext = new Recto.Shared.Protocol.V04.AppContext(
                AppId: DefaultConsumerAppId,
                AppName: DefaultConsumerAppName,
                AppDescription: DefaultConsumerAppDescription,
                AppUrl: DefaultConsumerBaseUrl,
                AppIconUrl: DefaultConsumerAppIconUrl,
                AppVersion: null);
            await Registry.RecordObservedAsync(appContext, CancellationToken.None);
            var refreshed = await Registry.GetAllAsync(CancellationToken.None);
            if (refreshed.IsSuccess)
            {
                _connectedServices = refreshed.Value;
            }
            _pairServiceHighlightedAppId = DefaultConsumerAppId;
            _pairServiceSuccessMessage =
                $"Your master pubkey is now bound to your {DefaultConsumerAppName} account. " +
                $"You can sign in to {DefaultConsumerAppName} on any browser; this device is the signer.";
            _pairServiceCode = string.Empty;
        }
        catch (Exception ex)
        {
            _pairServiceError = $"Unexpected error: {ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _pairServiceBusy = false;
            _pairServiceBusyText = string.Empty;
            StateHasChanged();
        }
    }

    private void DismissPairServiceSuccess()
    {
        _pairServiceSuccessMessage = null;
        _pairServiceHighlightedAppId = null;
        _pairServiceError = null;
        StateHasChanged();
    }

    /// <summary>
    /// Phase H consumer-error parser. The bootloader relays the
    /// consumer's HTTP body verbatim, so the reason for a rejection
    /// (pubkey_already_bound, pairing_code_expired, capability_invalid,
    /// etc.) lives in the consumer's own JSON shape. That consumer's
    /// CompletePairingEndpoint returns <c>{"error": "...", "reason": "..."}</c>;
    /// generic consumers may use only <c>error</c>. We try <c>reason</c>
    /// first (more specific), then <c>error</c>, then fall back to the
    /// HTTP status line.
    /// </summary>
    private static string? TryExtractConsumerErrorReason(System.Text.Json.JsonElement? body)
    {
        if (body is null) return null;
        var elem = body.Value;
        if (elem.ValueKind != System.Text.Json.JsonValueKind.Object) return null;
        if (elem.TryGetProperty("reason", out var reasonProp)
            && reasonProp.ValueKind == System.Text.Json.JsonValueKind.String)
        {
            var r = reasonProp.GetString();
            if (!string.IsNullOrWhiteSpace(r)) return r;
        }
        if (elem.TryGetProperty("error", out var errorProp)
            && errorProp.ValueKind == System.Text.Json.JsonValueKind.String)
        {
            var e = errorProp.GetString();
            if (!string.IsNullOrWhiteSpace(e)) return e;
        }
        return null;
    }

    private async Task HandleUnpairClick()
    {
        StopPolling();
        if (_paired is not null)
        {
            ClearPin(_paired.BootloaderUrl);
        }
        var clear = await Pairing.ClearAsync(CancellationToken.None);
        if (clear.IsSuccess)
        {
            _paired = null;
            _pending.Clear();
            _registeredPhones.Clear();
            _bootloaderUrl = DemoBootloaderUrl;
            _pairingCode = string.Empty;
            _errorMessage = null;
            _pollingError = null;
            _lastTotpCode = null;
            _lastTotpAlias = null;
            _lastTotpAt = null;
        }
    }

    // --- Approve / deny dispatchers (unchanged from round 6) ---

    private async Task HandleApproveAsync(PendingRequest req)
    {
        if (_paired is null) return;
        _processingRequestId = req.RequestId;
        StateHasChanged();

        try
        {
            switch (req.Kind)
            {
                case PendingRequestKind.SingleSign:
                    await ApproveSingleSignAsync(req);
                    break;
                case PendingRequestKind.TotpProvision:
                    await ApproveTotpProvisionAsync(req);
                    break;
                case PendingRequestKind.TotpGenerate:
                    await ApproveTotpGenerateAsync(req);
                    break;
                case PendingRequestKind.SessionIssuance:
                    await ApproveSessionIssuanceAsync(req);
                    break;
                case PendingRequestKind.WebAuthnAssert:
                    await ApproveWebAuthnAssertAsync(req);
                    break;
                case PendingRequestKind.Pkcs11Sign:
                case PendingRequestKind.PgpSign:
                    // PKCS#11 and PGP both reuse the single_sign signing
                    // path -- they're just labeled differently in the UI
                    // so the operator sees the right context for what
                    // they're approving (an SSH login vs an arbitrary
                    // sign vs a git commit signature).
                    await ApproveSingleSignAsync(req);
                    break;
                case PendingRequestKind.EthSign:
                    await ApproveEthSignAsync(req);
                    break;
                case PendingRequestKind.BtcSign:
                    await ApproveBtcSignAsync(req);
                    break;
                case PendingRequestKind.EdSign:
                    await ApproveEdSignAsync(req);
                    break;
                case PendingRequestKind.TronSign:
                    await ApproveTronSignAsync(req);
                    break;
                case PendingRequestKind.CapabilityRequest:
                    await ApproveCapabilityRequestAsync(req);
                    break;
                case PendingRequestKind.ProfileCreate:
                    await ApproveProfileCreateAsync(req);
                    break;
                case PendingRequestKind.ProfileAddDevice:
                    await ApproveProfileAddDeviceAsync(req);
                    break;
                case PendingRequestKind.ProfileRevokeDevice:
                    await ApproveProfileRevokeDeviceAsync(req);
                    break;
                default:
                    _pollingError = $"Cannot approve unknown request kind '{req.Kind}'.";
                    break;
            }
        }
        finally
        {
            _processingRequestId = null;
            _processingText = string.Empty;
            StateHasChanged();
        }
    }

    private async Task ApproveBtcSignAsync(PendingRequest req)
    {
        // Validate BTC-specific context before either crypto path runs.
        // Today only message_signing is wired end-to-end on the phone
        // side; psbt earns its own approval method when BIP-174 lands.
        var msgKind = req.Context.BtcMessageKind;
        if (string.IsNullOrEmpty(msgKind))
        {
            _pollingError = "btc_sign request missing btc_message_kind.";
            return;
        }
        if (msgKind != BtcMessageKind.MessageSigning)
        {
            _pollingError = $"btc_sign kind '{msgKind}' is not yet implemented; only message_signing is wired today.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.BtcMessageText))
        {
            _pollingError = "btc_sign message_signing request missing btc_message_text.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "btc_sign request missing payload_hash_b64u (Ed25519 envelope binding).";
            return;
        }

        // Wave-7: Bitcoin-family coin discriminator. Defaults to "btc"
        // for backward compat with v0.5 launchers that pre-date the
        // multi-coin extension. Each coin's default BIP-44 path is
        // different (m/84'/0' BTC, m/84'/2' LTC, m/44'/3' DOGE,
        // m/44'/145' BCH); when btc_derivation_path is absent the
        // coin's default applies.
        var coin = string.IsNullOrEmpty(req.Context.BtcCoin)
            ? BtcCoin.Bitcoin
            : req.Context.BtcCoin!;
        var derivationPath = string.IsNullOrEmpty(req.Context.BtcDerivationPath)
            ? _btcDefaultPathForCoin(coin)
            : req.Context.BtcDerivationPath!;
        var network = string.IsNullOrEmpty(req.Context.BtcNetwork)
            ? "mainnet"
            : req.Context.BtcNetwork!;

        _processingText = $"Signing with {_btcCoinDisplayName(coin)} key...";
        StateHasChanged();
        await Task.Yield();

        // Phone produces TWO signatures (same shape as eth_sign):
        //   (a) BIP-137 compact secp256k1 signature over the
        //       coin-specific BIP-137 hash of the message (preamble
        //       differs per coin: BTC + BCH share Bitcoin's preamble,
        //       LTC + DOGE have their own). Returned in
        //       RespondRequest.BtcSignatureBase64. Opaque to the
        //       bootloader; consumed by the smart contract / off-chain
        //       verifier / wallet performing on-chain verification.
        //   (b) Ed25519 over the bootloader-supplied payload_hash_b64u,
        //       returned in RespondRequest.SignatureB64u. Proves the
        //       response came from the paired phone — same envelope
        //       eth_sign / single_sign use.
        var signResult = await BtcSigner.SignMessageAsync(
            BtcKeyAlias, derivationPath, network, coin, req.Context.BtcMessageText!, CancellationToken.None);
        if (signResult.IsFailure)
        {
            _pollingError = signResult.Error.Message;
            return;
        }
        var compactSigBase64 = signResult.Value;

        byte[] payloadHash;
        try { payloadHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, payloadHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            BtcSignatureBase64: compactSigBase64);
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveEdSignAsync(PendingRequest req)
    {
        // Wave-8 ed25519 chains (SOL / XLM / XRP). Validate context.
        // Today only message_signing is wired end-to-end on the phone
        // side; transaction signing earns its own approval method when
        // each chain's canonical transaction-blob hashing rule lands.
        var msgKind = req.Context.EdMessageKind;
        if (string.IsNullOrEmpty(msgKind))
        {
            _pollingError = "ed_sign request missing ed_message_kind.";
            return;
        }
        if (msgKind != EdMessageKind.MessageSigning)
        {
            _pollingError = $"ed_sign kind '{msgKind}' is not yet implemented; only message_signing is wired today.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.EdMessageText))
        {
            _pollingError = "ed_sign message_signing request missing ed_message_text.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "ed_sign request missing payload_hash_b64u (Ed25519 envelope binding).";
            return;
        }

        // Default chain to "sol" only because absence of ed_chain on the
        // wire means the launcher built a malformed request — bail loud.
        if (string.IsNullOrEmpty(req.Context.EdChain))
        {
            _pollingError = "ed_sign request missing ed_chain (sol/xlm/xrp).";
            return;
        }
        var chain = req.Context.EdChain!;
        var derivationPath = string.IsNullOrEmpty(req.Context.EdDerivationPath)
            ? _edDefaultPathForChain(chain)
            : req.Context.EdDerivationPath!;

        _processingText = $"Signing with {_edChainDisplayName(chain)} key...";
        StateHasChanged();
        await Task.Yield();

        // Phone produces TWO signatures (same shape as eth_sign /
        // btc_sign):
        //   (a) raw 64-byte ed25519 chain signature over
        //       SHA-256(chain_preamble || message_bytes). Returned in
        //       RespondRequest.EdSignatureBase64. The chain-specific
        //       32-byte ed25519 public key (NOT the address) is also
        //       returned in RespondRequest.EdPubkeyHex — XRP needs it
        //       because addresses are HASH160s; SOL and XLM carry it
        //       for protocol uniformity. Both opaque to the bootloader.
        //   (b) Ed25519 over the bootloader-supplied payload_hash_b64u,
        //       returned in RespondRequest.SignatureB64u. Proves the
        //       response came from the paired phone — same envelope
        //       eth_sign / btc_sign / single_sign use.
        var signResult = await EdSigner.SignMessageAsync(
            EdKeyAlias, chain, derivationPath, req.Context.EdMessageText!, CancellationToken.None);
        if (signResult.IsFailure)
        {
            _pollingError = signResult.Error.Message;
            return;
        }
        var edSignature = signResult.Value.SignatureBase64;
        var edPubkeyHex = signResult.Value.PublicKeyHex;

        byte[] payloadHash;
        try { payloadHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, payloadHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            EdSignatureBase64: edSignature,
            EdPubkeyHex: edPubkeyHex);
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveEthSignAsync(PendingRequest req)
    {
        // Validate ETH-specific context before either crypto path runs.
        // All three message kinds are now wired end-to-end: personal_sign
        // (EIP-191), typed_data (EIP-712), and transaction (EIP-1559 raw
        // signed bytes ready for eth_sendRawTransaction).
        var msgKind = req.Context.EthMessageKind;
        if (string.IsNullOrEmpty(msgKind))
        {
            _pollingError = "eth_sign request missing eth_message_kind.";
            return;
        }
        if (msgKind != EthMessageKind.PersonalSign
            && msgKind != EthMessageKind.TypedData
            && msgKind != EthMessageKind.Transaction)
        {
            _pollingError = $"eth_sign kind '{msgKind}' is not recognized.";
            return;
        }
        if (msgKind == EthMessageKind.PersonalSign && string.IsNullOrEmpty(req.Context.EthMessageText))
        {
            _pollingError = "eth_sign personal_sign request missing eth_message_text.";
            return;
        }
        if (msgKind == EthMessageKind.TypedData && string.IsNullOrEmpty(req.Context.EthTypedDataJson))
        {
            _pollingError = "eth_sign typed_data request missing eth_typed_data_json.";
            return;
        }
        if (msgKind == EthMessageKind.Transaction && string.IsNullOrEmpty(req.Context.EthTransactionJson))
        {
            _pollingError = "eth_sign transaction request missing eth_transaction_json.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "eth_sign request missing payload_hash_b64u (Ed25519 envelope binding).";
            return;
        }

        var derivationPath = string.IsNullOrEmpty(req.Context.EthDerivationPath)
            ? "m/44'/60'/0'/0/0"
            : req.Context.EthDerivationPath!;

        _processingText = msgKind switch
        {
            EthMessageKind.PersonalSign => "Signing with ETH key (EIP-191)...",
            EthMessageKind.TypedData => "Signing with ETH key (EIP-712)...",
            EthMessageKind.Transaction => "Signing with ETH key (EIP-1559)...",
            _ => "Signing with ETH key...",
        };
        StateHasChanged();
        await Task.Yield();

        // Phone produces TWO signatures:
        //   (a) secp256k1 over the kind-specific digest (EIP-191 hash for
        //       personal_sign, EIP-712 hash for typed_data, EIP-1559 hash
        //       for transaction). For personal_sign + typed_data the
        //       result is 65-byte r||s||v with v ∈ {27, 28}; for
        //       transaction the result is the FULL raw signed-tx bytes
        //       (0x02 || rlp([fields..., yParity, r, s])) ready for
        //       eth_sendRawTransaction. All three return as
        //       RespondRequest.EthSignatureRsv (the field name is a
        //       slight misnomer for transaction's case, but the wire
        //       protocol pre-dates that distinction; bootloader does
        //       structure-only validation, so it forwards opaquely).
        //   (b) Ed25519 over the bootloader-supplied payload_hash_b64u,
        //       returned in RespondRequest.SignatureB64u. Proves the
        //       response came from the paired phone -- same envelope
        //       single_sign uses.
        Result<string> signResult;
        if (msgKind == EthMessageKind.PersonalSign)
        {
            signResult = await EthSigner.SignPersonalSignAsync(
                EthKeyAlias, derivationPath, req.Context.EthMessageText!, CancellationToken.None);
        }
        else if (msgKind == EthMessageKind.TypedData)
        {
            signResult = await EthSigner.SignTypedDataAsync(
                EthKeyAlias, derivationPath, req.Context.EthTypedDataJson!, CancellationToken.None);
        }
        else // Transaction
        {
            signResult = await EthSigner.SignTransactionAsync(
                EthKeyAlias, derivationPath, req.Context.EthTransactionJson!, CancellationToken.None);
        }
        if (signResult.IsFailure)
        {
            _pollingError = signResult.Error.Message;
            return;
        }
        var rsvHex = signResult.Value;

        byte[] payloadHash;
        try { payloadHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, payloadHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            EthSignatureRsv: rsvHex);
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveTronSignAsync(PendingRequest req)
    {
        // Wave 9 part 2: TRON message_signing. Same secp256k1 +
        // Keccak-256 + RFC 6979 pipeline as ETH personal_sign; the
        // only differences are the TIP-191 preamble (handled inside
        // TronSigningOps.SignedMessageHash) and the BIP-44 path
        // (m/44'/195'/0'/0/N -- SLIP-0044 coin-type 195). Phone
        // produces the standard r||s||v hex AND the Ed25519 envelope
        // over payload_hash_b64u; bootloader forwards both to the
        // verifier opaquely.
        var msgKind = req.Context.TronMessageKind;
        if (string.IsNullOrEmpty(msgKind))
        {
            _pollingError = "tron_sign request missing tron_message_kind.";
            return;
        }
        if (msgKind != TronMessageKind.MessageSigning)
        {
            // tron_message_kind="transaction" is reserved at the
            // protocol layer (recto.bootloader.state.new_tron refuses
            // it). The phone-side check here is belt-and-suspenders.
            _pollingError = $"tron_sign kind '{msgKind}' is not yet supported (only 'message_signing' is wired).";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.TronMessageText))
        {
            _pollingError = "tron_sign message_signing request missing tron_message_text.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "tron_sign request missing payload_hash_b64u (Ed25519 envelope binding).";
            return;
        }

        var derivationPath = string.IsNullOrEmpty(req.Context.TronDerivationPath)
            ? "m/44'/195'/0'/0/0"
            : req.Context.TronDerivationPath!;

        _processingText = "Signing with TRON key (TIP-191)...";
        StateHasChanged();
        await Task.Yield();

        var signResult = await TronSigner.SignMessageAsync(
            TronKeyAlias, derivationPath, req.Context.TronMessageText!, CancellationToken.None);
        if (signResult.IsFailure)
        {
            _pollingError = signResult.Error.Message;
            return;
        }
        var rsvHex = signResult.Value;

        byte[] payloadHash;
        try { payloadHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, payloadHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            TronSignatureRsv: rsvHex);
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveCapabilityRequestAsync(PendingRequest req)
    {
        // Phase 5 Wave B part 2: capability_request approval. The
        // bootloader pre-encoded the operator's CapabilityClaims into
        // cap_header_b64 + cap_payload_b64 (canonical-JSON, byte-
        // identical to the Python build_signing_input output). The
        // phone:
        //   1. Reconstructs SHA-256(f"{cap_header_b64}.{cap_payload_b64}")
        //      and cross-checks against payload_hash_b64u so the
        //      operator's biometric consent on the Ed25519 envelope
        //      binds 1:1 to the JWS they sign.
        //   2. Signs the digest with the operator's secp256k1 BIP-39-
        //      derived key (same identity as ETH personal_sign — one
        //      operator, two surfaces).
        //   3. Returns the 64-byte raw r||s base64url-encoded on
        //      cap_signature_b64u alongside the standard Ed25519
        //      envelope on signature_b64u.
        //
        // Bootloader assembles the final 3-part JWS via
        // assemble_jws and stashes it as a CapabilityResult for the
        // requesting agent to fetch via /v0.4/capability/result/<id>.
        if (string.IsNullOrEmpty(req.Context.CapHeaderB64))
        {
            _pollingError = "capability_request missing cap_header_b64.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.CapPayloadB64))
        {
            _pollingError = "capability_request missing cap_payload_b64.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "capability_request missing payload_hash_b64u (Ed25519 envelope binding).";
            return;
        }

        // Reconstruct the signing-input digest the same way Python's
        // build_signing_input does. If this drifts from the bootloader's
        // pinned payload_hash_b64u, refuse — the operator should NOT
        // sign a digest the bootloader didn't pin.
        var signingInputBytes = System.Text.Encoding.ASCII.GetBytes(
            $"{req.Context.CapHeaderB64}.{req.Context.CapPayloadB64}");
        byte[] reconstructedDigest;
        try
        {
            reconstructedDigest = System.Security.Cryptography.SHA256.HashData(signingInputBytes);
        }
        catch (Exception ex)
        {
            _pollingError = $"Could not compute signing-input digest: {ex.Message}";
            return;
        }

        byte[] envelopeHash;
        try { envelopeHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }

        if (envelopeHash.Length != reconstructedDigest.Length
            || !System.Linq.Enumerable.SequenceEqual(envelopeHash, reconstructedDigest))
        {
            // The bootloader and phone disagree on the digest. Refuse
            // to sign — this could indicate a tampering attempt or a
            // protocol bug; either way, the operator's consent on the
            // envelope wouldn't bind to the JWS we're about to produce.
            _pollingError = "capability_request payload_hash_b64u does not match SHA-256(cap_header_b64.cap_payload_b64). Refusing to sign.";
            return;
        }

        _processingText = "Signing capability JWS (ES256K)...";
        StateHasChanged();
        await Task.Yield();

        // Same operator identity as ETH personal_sign — one BIP-39
        // mnemonic, one secp256k1 derivation, two surfaces. Default
        // to the ETH path; future v0.6+ may carry an explicit
        // cap_signing_derivation_path on the wire if operators want
        // multiple capability-issuer identities per phone.
        var derivationPath = "m/44'/60'/0'/0/0";
        var capSignResult = await EthSigner.SignDigestAsync(
            EthKeyAlias, derivationPath, reconstructedDigest, CancellationToken.None);
        if (capSignResult.IsFailure)
        {
            _pollingError = capSignResult.Error.Message;
            return;
        }
        var capSig = capSignResult.Value;
        if (capSig.Length != 64)
        {
            _pollingError = $"SignDigestAsync returned {capSig.Length} bytes; expected 64 (raw r||s).";
            return;
        }

        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, envelopeHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            CapSignatureB64u: Base64UrlEncode(capSig));
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveProfileCreateAsync(PendingRequest req)
    {
        // Phase 2.0.C wave C.3: profile_create approval flow.
        // The bootloader's queue-time cap_payload_b64 carries the
        // PARTIAL canonical JSON of the candidate fields (no
        // child_pubkey_hex yet -- bootloader doesn't know what the
        // phone will derive). The phone:
        //   1. Derives the child key at the candidate's BIP-32 path
        //      from the operator's mnemonic.
        //   2. Builds the FULL canonical JSON by parsing the partial
        //      back to dict + injecting child_pubkey_hex (server-side
        //      reconstructs the same canonical bytes from req.candidate_*
        //      + child_pubkey_hex when verifying).
        //   3. SHA-256s the full canonical JSON.
        //   4. Signs the digest with the operator's MASTER key (same
        //      identity as ETH personal_sign / capability_request --
        //      one operator, multiple surfaces). Per Hard Rule #9 the
        //      master mnemonic never leaves the enclave context.
        //   5. Signs the Ed25519 paired-phone envelope over
        //      payload_hash_b64u (the partial-canonical hash the
        //      bootloader stashed).
        //   6. POSTs cap_signature_b64u + child_pubkey_hex + the
        //      Ed25519 envelope back.
        // Bootloader-side: server.py _handle_respond profile_create
        // branch (Phase 2.0.C wave C.1) extracts child_pubkey_hex,
        // re-canonicalizes, recovers the master signature, persists
        // the Profile row with derived_pubkey_hex.
        if (string.IsNullOrEmpty(req.Context.CapPayloadB64))
        {
            _pollingError = "profile_create missing cap_payload_b64.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "profile_create missing payload_hash_b64u.";
            return;
        }
        if (req.Context.CandidateDerivationPurpose is null
            || req.Context.CandidateDerivationCoinType is null
            || req.Context.CandidateDerivationIndex is null)
        {
            _pollingError = "profile_create missing candidate derivation purpose/coin_type/index.";
            return;
        }

        // 1. Derive child pubkey at the candidate's BIP-32 path. Path
        // form: m/<purpose>'/<coin_type>'/<index>' (all hardened, per
        // recto.profile.manage's PROFILE_BIP32_PURPOSE convention).
        var childPath = $"m/{req.Context.CandidateDerivationPurpose.Value}'/"
            + $"{req.Context.CandidateDerivationCoinType.Value}'/"
            + $"{req.Context.CandidateDerivationIndex.Value}'";
        _processingText = "Deriving child profile key (BIP-32)...";
        StateHasChanged();
        await Task.Yield();
        var derivePubResult = await EthSigner.DerivePubkeyAtPathAsync(
            EthKeyAlias, childPath, CancellationToken.None);
        if (derivePubResult.IsFailure)
        {
            _pollingError = derivePubResult.Error.Message;
            return;
        }
        var childPubkeyBytes = derivePubResult.Value;
        if (childPubkeyBytes.Length != 64)
        {
            _pollingError = $"Child pubkey derivation returned {childPubkeyBytes.Length} bytes; expected 64 (raw X||Y).";
            return;
        }
        var childPubkeyHex = BytesToHexLower(childPubkeyBytes);

        // 2. Reconstruct the FULL canonical JSON by parsing the
        // queue-time partial + injecting child_pubkey_hex + re-
        // canonicalizing via the same encoder the bootloader's
        // verify path uses. Byte-parity with Python's
        // recto.capability.jwt._canonical_json is the contract.
        byte[] partialBytes;
        try { partialBytes = Base64UrlDecode(req.Context.CapPayloadB64!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode cap_payload_b64: {ex.Message}";
            return;
        }
        Dictionary<string, object?> partialDict;
        try
        {
            partialDict = ParsePartialCanonicalToDict(partialBytes);
        }
        catch (Exception ex)
        {
            _pollingError = $"profile_create cap_payload_b64 not valid JSON object: {ex.Message}";
            return;
        }
        if (partialDict.ContainsKey("child_pubkey_hex"))
        {
            _pollingError = "profile_create queue-time payload unexpectedly already contains child_pubkey_hex.";
            return;
        }
        partialDict["child_pubkey_hex"] = childPubkeyHex;
        byte[] fullCanonical;
        try { fullCanonical = Recto.Shared.Capability.CanonicalJson.Encode(partialDict); }
        catch (Exception ex)
        {
            _pollingError = $"Failed to re-canonicalize profile_create signing input: {ex.Message}";
            return;
        }
        var fullDigest = System.Security.Cryptography.SHA256.HashData(fullCanonical);

        // 3. Sign full digest with operator's master key (same path
        // capability_request uses -- one operator identity, both
        // surfaces). Future v0.6+ may carry an explicit
        // cap_signing_derivation_path on the wire for per-surface
        // operator identities; v2.0.C ships the default.
        _processingText = "Signing master attestation (ES256K)...";
        StateHasChanged();
        await Task.Yield();
        var masterDerivationPath = "m/44'/60'/0'/0/0";
        var masterSignResult = await EthSigner.SignDigestAsync(
            EthKeyAlias, masterDerivationPath, fullDigest, CancellationToken.None);
        if (masterSignResult.IsFailure)
        {
            _pollingError = masterSignResult.Error.Message;
            return;
        }
        var masterSig = masterSignResult.Value;
        if (masterSig.Length != 64)
        {
            _pollingError = $"SignDigestAsync returned {masterSig.Length} bytes; expected 64 (raw r||s).";
            return;
        }

        // 4. Sign the Ed25519 paired-phone envelope over
        // payload_hash_b64u (the partial-canonical hash the bootloader
        // queue-stashed). NOT the full digest -- the envelope binds
        // the operator's biometric consent to the pending request the
        // bootloader queued, not to the freshly-augmented JSON we
        // just built phone-side.
        byte[] envelopeHash;
        try { envelopeHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, envelopeHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        // 5. POST RespondRequest with cap_signature_b64u (master
        // attestation) + child_pubkey_hex (derived) + Ed25519
        // envelope (paired-phone consent).
        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            CapSignatureB64u: Base64UrlEncode(masterSig),
            ChildPubkeyHex: childPubkeyHex);
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveProfileAddDeviceAsync(PendingRequest req)
    {
        // Phase 2.0.C wave C.5.c: profile_add_device approval flow.
        // Simpler than profile_create's approval because the FULL
        // canonical-JSON signing input is known at queue time -- the
        // bootloader stashed it in cap_payload_b64 verbatim, and the
        // phone signs SHA-256 of those exact bytes (no field needs
        // injection at signing time, unlike profile_create's
        // child_pubkey_hex flow). Steps:
        //   1. Decode cap_payload_b64 -> raw bytes
        //   2. SHA-256 the bytes -> 32-byte digest
        //   3. Sign the digest with the operator's MASTER key (same
        //      m/44'/60'/0'/0/0 identity as profile_create's master
        //      attestation -- one operator, multiple surfaces).
        //   4. Sign the Ed25519 paired-phone envelope over
        //      payload_hash_b64u (the canonical-JSON hash the
        //      bootloader queue-stashed).
        //   5. POST cap_signature_b64u + the Ed25519 envelope back.
        // Bootloader-side: server.py _handle_respond
        // profile_add_device branch (Phase 2.0.C wave C.5.b) decodes
        // cap_payload_b64, SHA-256s, recovers the master signature,
        // appends new_phone_id to the profile's device_ids tuple.
        if (string.IsNullOrEmpty(req.Context.CapPayloadB64))
        {
            _pollingError = "profile_add_device missing cap_payload_b64.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "profile_add_device missing payload_hash_b64u.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.AddevProfileId))
        {
            _pollingError = "profile_add_device missing addev_profile_id.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.AddevNewPhoneId))
        {
            _pollingError = "profile_add_device missing addev_new_phone_id.";
            return;
        }

        // 1. Decode cap_payload_b64 -> raw signing-input bytes.
        byte[] signingInputBytes;
        try { signingInputBytes = Base64UrlDecode(req.Context.CapPayloadB64!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode cap_payload_b64: {ex.Message}";
            return;
        }

        // 2. SHA-256 -> 32-byte digest.
        var fullDigest = System.Security.Cryptography.SHA256.HashData(signingInputBytes);

        // 3. Sign digest with operator master key (m/44'/60'/0'/0/0,
        // same identity as profile_create's master attestation +
        // capability_request). Future v0.6+ may carry an explicit
        // cap_signing_derivation_path on the wire; v2.0.C ships the
        // default.
        _processingText = "Signing master attestation (ES256K)...";
        StateHasChanged();
        await Task.Yield();
        var masterDerivationPath = "m/44'/60'/0'/0/0";
        var masterSignResult = await EthSigner.SignDigestAsync(
            EthKeyAlias, masterDerivationPath, fullDigest, CancellationToken.None);
        if (masterSignResult.IsFailure)
        {
            _pollingError = masterSignResult.Error.Message;
            return;
        }
        var masterSig = masterSignResult.Value;
        if (masterSig.Length != 64)
        {
            _pollingError = $"SignDigestAsync returned {masterSig.Length} bytes; expected 64 (raw r||s).";
            return;
        }

        // 4. Sign the Ed25519 paired-phone envelope over
        // payload_hash_b64u. Binds the operator's biometric consent
        // to the pending request the bootloader queued.
        byte[] envelopeHash;
        try { envelopeHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, envelopeHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        // 5. POST RespondRequest. profile_add_device's response shape
        // mirrors profile_create's minus ChildPubkeyHex (not needed --
        // no phone-supplied field in the signing input).
        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            CapSignatureB64u: Base64UrlEncode(masterSig));
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    private async Task ApproveProfileRevokeDeviceAsync(PendingRequest req)
    {
        // Phase 2.0.C wave C.6.c: profile_revoke_device approval flow.
        // Structurally identical to ApproveProfileAddDeviceAsync --
        // the full canonical-JSON signing input is stashed in
        // cap_payload_b64 at queue time, phone signs SHA-256 of
        // those exact bytes with the operator master key. Only the
        // semantics differ (removing a phone from device_ids vs
        // appending one); the cryptographic path is the same.
        //
        // Steps:
        //   1. Validate cap_payload_b64 + payload_hash_b64u + revdev_*
        //      fields present.
        //   2. Decode cap_payload_b64 -> raw signing-input bytes.
        //   3. SHA-256 -> 32-byte digest.
        //   4. Sign digest with operator master key (m/44'/60'/0'/0/0).
        //   5. Sign Ed25519 paired-phone envelope over
        //      payload_hash_b64u.
        //   6. POST cap_signature_b64u + envelope back.
        // Bootloader-side: server.py _handle_respond
        // profile_revoke_device branch decodes cap_payload_b64,
        // SHA-256s, recovers the master signature, calls
        // profile.manage.profile_revoke_device to atomic-write the
        // device removal.
        if (string.IsNullOrEmpty(req.Context.CapPayloadB64))
        {
            _pollingError = "profile_revoke_device missing cap_payload_b64.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.PayloadHashB64u))
        {
            _pollingError = "profile_revoke_device missing payload_hash_b64u.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.RevdevProfileId))
        {
            _pollingError = "profile_revoke_device missing revdev_profile_id.";
            return;
        }
        if (string.IsNullOrEmpty(req.Context.RevdevPhoneIdToRevoke))
        {
            _pollingError = "profile_revoke_device missing revdev_phone_id_to_revoke.";
            return;
        }

        // 1. Decode cap_payload_b64.
        byte[] signingInputBytes;
        try { signingInputBytes = Base64UrlDecode(req.Context.CapPayloadB64!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode cap_payload_b64: {ex.Message}";
            return;
        }

        // 2. SHA-256.
        var fullDigest = System.Security.Cryptography.SHA256.HashData(signingInputBytes);

        // 3. Sign digest with operator master key.
        _processingText = "Signing master attestation (ES256K)...";
        StateHasChanged();
        await Task.Yield();
        var masterDerivationPath = "m/44'/60'/0'/0/0";
        var masterSignResult = await EthSigner.SignDigestAsync(
            EthKeyAlias, masterDerivationPath, fullDigest, CancellationToken.None);
        if (masterSignResult.IsFailure)
        {
            _pollingError = masterSignResult.Error.Message;
            return;
        }
        var masterSig = masterSignResult.Value;
        if (masterSig.Length != 64)
        {
            _pollingError = $"SignDigestAsync returned {masterSig.Length} bytes; expected 64 (raw r||s).";
            return;
        }

        // 4. Sign Ed25519 envelope.
        byte[] envelopeHash;
        try { envelopeHash = Base64UrlDecode(req.Context.PayloadHashB64u!); }
        catch (Exception ex)
        {
            _pollingError = $"Could not decode payload hash: {ex.Message}";
            return;
        }
        _processingText = "Awaiting biometric...";
        StateHasChanged();
        var enclaveSignResult = await EnclaveKeys.SignAsync(KeyAlias, envelopeHash, CancellationToken.None);
        if (enclaveSignResult.IsFailure)
        {
            _pollingError = enclaveSignResult.Error.Message;
            return;
        }

        // 5. POST RespondRequest. Same shape as profile_add_device --
        // master sig + Ed25519 envelope, no child_pubkey_hex needed.
        _processingText = "Sending response...";
        StateHasChanged();
        var respondReq = new RespondRequest(
            PhoneId: _paired!.PhoneId,
            Decision: RespondDecision.Approved,
            SignatureB64u: Base64UrlEncode(enclaveSignResult.Value),
            CapSignatureB64u: Base64UrlEncode(masterSig));
        var respondResult = await BootloaderClient.RespondAsync(
            ActiveBootloaderUrl, req.RequestId, respondReq, CancellationToken.None);
        if (respondResult.IsFailure)
        {
            _pollingError = respondResult.Error.Message;
            return;
        }
        await RefreshPendingAsync(CancellationToken.None);
    }

    /// <summary>
    /// Phase 2.0.C wave C.3 helper: parse the queue-time partial
    /// canonical JSON from cap_payload_b64 back into a string-keyed
    /// dict compatible with <c>CanonicalJson.Encode</c>. The dict
    /// gains <c>child_pubkey_hex</c> in the calling flow before
    /// re-encoding. Supports the JSON value types Recto's
    /// <c>_canonical_json</c> emits for the candidate-fields shape:
    /// string, long, null, dict-of-string-to-supported. Arrays /
    /// nested objects fall through unchanged since profile_create's
    /// candidate fields don't currently contain either -- if a
    /// future schema extension uses them, this helper grows the
    /// case alongside <see cref="CanonicalJson.WriteValue"/>'s
    /// supported-type list.
    /// </summary>
    private static Dictionary<string, object?> ParsePartialCanonicalToDict(byte[] partialBytes)
    {
        using var doc = System.Text.Json.JsonDocument.Parse(partialBytes);
        if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object)
        {
            throw new InvalidOperationException(
                $"Expected JSON object at root, got {doc.RootElement.ValueKind}.");
        }
        var dict = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var prop in doc.RootElement.EnumerateObject())
        {
            dict[prop.Name] = JsonElementToCanonicalValue(prop.Value);
        }
        return dict;
    }

    private static object? JsonElementToCanonicalValue(System.Text.Json.JsonElement elem)
    {
        return elem.ValueKind switch
        {
            System.Text.Json.JsonValueKind.Null => null,
            System.Text.Json.JsonValueKind.True => true,
            System.Text.Json.JsonValueKind.False => false,
            System.Text.Json.JsonValueKind.String => elem.GetString(),
            System.Text.Json.JsonValueKind.Number => elem.TryGetInt64(out var l) ? (object)l
                : throw new InvalidOperationException(
                    $"Numeric value {elem} is not a valid int64 for canonical JSON."),
            _ => throw new InvalidOperationException(
                $"Unsupported JSON value kind {elem.ValueKind} in profile_create "
                + "partial canonical JSON. Recto's canonical encoder only handles "
                + "string / int64 / bool / null at the candidate-fields layer."),
        };
    }

    private static string BytesToHexLower(byte[] bytes)
    {
        var sb = new System.Text.StringBuilder(bytes.Length * 2);
        foreach (var b in bytes)
        {
            sb.Append(b.ToString("x2"));
        }
        return sb.ToString();
    }

