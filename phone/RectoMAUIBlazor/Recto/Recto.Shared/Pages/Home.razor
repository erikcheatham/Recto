@page "/"
@using System
@using System.Linq
@using System.Threading
@using Microsoft.JSInterop
@using Recto.Shared.Common
@using Recto.Shared.Models
@using Recto.Shared.Protocol.V04
@using Recto.Shared.QR
@using Recto.Shared.Services
@implements IAsyncDisposable
@inject IFormFactor FormFactor
@inject IBootloaderClient BootloaderClient
@inject IEnclaveKeyService EnclaveKeys
@inject ITotpService Totp
@inject IEthSignService EthSigner
@inject IBtcSignService BtcSigner
@inject IEd25519ChainSignService EdSigner
@inject ITronSignService TronSigner
@inject IPinningService Pinning
@inject IPairingStateService Pairing
@inject IPushTokenService PushTokens
@inject IConnectedServiceRegistry Registry
@inject IUnpairService Unpair
@inject IGenesisStateService Genesis
@inject IJSRuntime JS
@* Task #22 Phase 1 (banked 2026-05-31): recto://pair?... URL-scheme
   deep-link consumer. Platform handlers (iOS AppDelegate.OpenUrl, Android
   MainActivity.OnCreate / OnNewIntent) push validated payloads into the
   singleton's static-state via InMemoryPairDeepLinkState.SetGlobal;
   this page consumes on OnInitializedAsync via DeepLink.TryConsume(). *@
@inject IPairDeepLinkState DeepLink
@* Build 6 (2026-06-02): in-app QR scanner retired. The OS Camera +
   recto:// URL-scheme deep-link path is the canonical scan surface
   on both iOS and Android — operators point the OS Camera at a
   pairing QR, tap the system-generated banner, the OS routes the
   recto://pair URL to AppDelegate.OpenUrl (iOS) / MainActivity
   OnNewIntent (Android), and the warm-start consumer path in
   OnInitializedAsync + PayloadArrived event picks it up. No camera
   permission, no AVFoundation/CameraX/ML Kit native binding, no
   modal scanner UI — strictly less code to maintain + no in-app
   crash surface. App Store reviewer demo path also exercises the
   recto:// route (canonical demo URL banked in the App Review
   note). *@
@inject IBiometricsAvailability Biometrics
@inject NavigationManager Nav
@* Build 12 (2026-07-11, wave-C consumer): silent-push wake signal. A native
   push (Android RectoFirebaseMessagingService / iOS
   AppDelegate.DidReceiveRemoteNotification) raises this; we subscribe below
   and fetch pending immediately instead of waiting out the poll interval.
   Polling stays the fallback until APNs/FCM creds are provisioned. *@
@inject IPushWakeSignal PushWake

<PageTitle>Recto</PageTitle>

@*
    Recto vault — phone-side approval surface.

    Pending requests split into two semantic sections: IDENTITY &
    ACCESS (single_sign / TOTP / WebAuthn / JWT capability / PKCS#11
    / PGP — the "common security" credential kinds that authenticate
    the operator or sign small non-financial payloads) and CRYPTO
    TOKENS (eth_sign / btc_sign + family — cryptocurrency-custody
    credential kinds that move money or on-chain authority). The
    split is driven by IsTokenSigningKind() in @code; adding a new
    kind needs one switch arm + one entry there.

    Settings gear is now in MainLayout's topbar. Brand wordmark
    lives there too, so this page just carries the tagline + paired
    state + pending-request sections.
*@

<div class="rec-home">

    @* v1 vault home (banked 2026-05-18): Connected Services section
       at the top. Renders only when the phone is paired (otherwise the
       pairing card below takes precedence). This is the Authy-analog
       "list of services connected to my Recto" view that anchors the
       multi-tenant user mental-model. Rows derive from the
       IConnectedServiceRegistry which aggregates AppContext entries
       observed across all pending requests this phone has received.
       Tap a row → opens per-service info panel (v1 scope decision b). *@
    @if (_paired is not null)
    {
        <div class="rec-vault-header">
            <div class="rec-vault-header-title">
                <span>Vault</span>
            </div>
            <div class="rec-vault-header-status">
                Paired to <code class="rec-mono">@TruncateUrlForDisplay(_paired.BootloaderUrl)</code>
            </div>
        </div>

        <div class="rec-section-header">
            <span class="rec-section-header-title">Connected Services</span>
            @if (_connectedServices.Count > 0)
            {
                <span class="rec-section-header-count">@_connectedServices.Count</span>
            }
        </div>

        @if (_connectedServices.Count == 0)
        {
            <div class="rec-vault-empty">
                <div class="rec-vault-empty-title">No services connected yet</div>
                <div class="rec-vault-empty-body">
                    Open a service that uses Recto on the web and tap
                    <strong>Pair my phone</strong> in your account settings.
                    Point your camera at the QR code it shows — your phone
                    will guide you through the rest. Once paired, your
                    services appear here and signing requests can reach you.
                </div>
            </div>
        }
        else
        {
            @foreach (var service in _connectedServices)
            {
                var svc = service;
                <button type="button"
                        class="rec-service-row @(_pairServiceHighlightedAppId == svc.AppId ? "rec-service-row-highlighted" : null)"
                        @onclick="() => OpenServicePanel(svc.AppId)">
                    <div class="rec-service-row-icon">
                        @if (!string.IsNullOrEmpty(svc.AppIconUrl))
                        {
                            <img src="@svc.AppIconUrl" alt="" />
                        }
                        else
                        {
                            <span class="rec-service-row-icon-placeholder">@GetServiceInitial(svc.AppName)</span>
                        }
                    </div>
                    <div class="rec-service-row-meta">
                        <div class="rec-service-row-name">@svc.AppName</div>
                        @if (!string.IsNullOrEmpty(svc.AppDescription))
                        {
                            <div class="rec-service-row-description">@svc.AppDescription</div>
                        }
                    </div>
                    <div class="rec-service-row-activity">@FormatRelativeTime(svc.LastSeenUtc)</div>
                    <span class="rec-service-row-chevron">›</span>
                </button>

                @* Per-service info panel (v1 scope decision b — full
                   AppContext + paired-since + total requests). Opens
                   inline when this service's row is tapped. Close
                   button or another row's tap collapses it. *@
                @if (_openServicePanelId == svc.AppId)
                {
                    <div class="rec-service-panel">
                        <div class="rec-service-panel-header">
                            <div class="rec-service-panel-icon">
                                @if (!string.IsNullOrEmpty(svc.AppIconUrl))
                                {
                                    <img src="@svc.AppIconUrl" alt="" />
                                }
                                else
                                {
                                    <span class="rec-service-row-icon-placeholder">@GetServiceInitial(svc.AppName)</span>
                                }
                            </div>
                            <div class="rec-service-panel-meta">
                                <div class="rec-service-panel-name">@svc.AppName</div>
                                @if (!string.IsNullOrEmpty(svc.AppDescription))
                                {
                                    <div class="rec-service-panel-description">@svc.AppDescription</div>
                                }
                                @if (!string.IsNullOrEmpty(svc.AppUrl))
                                {
                                    <code class="rec-card-app-context-url">@svc.AppUrl</code>
                                }
                            </div>
                        </div>
                        <div class="rec-service-panel-stats">
                            <div>
                                <div class="rec-service-panel-stat-label">First connected</div>
                                <div class="rec-service-panel-stat-value">@svc.FirstSeenUtc.ToLocalTime().ToString("MMM d, yyyy")</div>
                            </div>
                            <div>
                                <div class="rec-service-panel-stat-label">Last activity</div>
                                <div class="rec-service-panel-stat-value">@FormatRelativeTime(svc.LastSeenUtc)</div>
                            </div>
                            <div>
                                <div class="rec-service-panel-stat-label">Total requests</div>
                                <div class="rec-service-panel-stat-value">@svc.RequestCount</div>
                            </div>
                            <div>
                                <div class="rec-service-panel-stat-label">Service ID</div>
                                <div class="rec-service-panel-stat-value"><code class="rec-mono">@svc.AppId</code></div>
                            </div>
                        </div>

                        @* Build 6 (2026-06-02): per-service unpair affordance.
                           Two-step inline confirm so an accidental tap on the
                           top-level "Unpair" button doesn't yank the row out
                           from under the operator. Demo-service path
                           (AppId == "demo") delegates to HandleStartFreshClick
                           so the full demo-mode exit ceremony runs (clears
                           biometric + pairing-state + bootloader) — sister of
                           commitment that one tap in the canonical Unpair
                           surface fully exits demo mode, no separate "Start
                           fresh" rabbit hole required. *@
                        @if (!string.IsNullOrEmpty(_unpairServiceError) && _openServicePanelId == svc.AppId)
                        {
                            <div class="alert alert-warning small mb-2" role="alert">
                                @_unpairServiceError
                            </div>
                        }
                        @if (_pendingUnpairAppId == svc.AppId)
                        {
                            <div class="rec-service-panel-unpair-confirm">
                                <div class="rec-service-panel-unpair-confirm-text">
                                    @if (string.Equals(svc.AppId, DemoServiceAppId, StringComparison.Ordinal))
                                    {
                                        @:Exit demo mode? This clears the demo pairing on this device.
                                    }
                                    else
                                    {
                                        @:Remove <strong>@svc.AppName</strong> from this device?
                                    }
                                </div>
                                <div class="rec-service-panel-unpair-confirm-actions">
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm"
                                            disabled="@_unpairServiceBusy"
                                            @onclick="HandleCancelUnpairServiceClick">
                                        Cancel
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            disabled="@_unpairServiceBusy"
                                            @onclick="() => HandleConfirmUnpairServiceAsync(svc.AppId)">
                                        @if (_unpairServiceBusy)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                        }
                                        @if (string.Equals(svc.AppId, DemoServiceAppId, StringComparison.Ordinal))
                                        {
                                            @:Exit demo mode
                                        }
                                        else
                                        {
                                            @:Confirm unpair
                                        }
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-outline-danger btn-sm w-100 mb-2"
                                    @onclick="() => HandleUnpairServiceClick(svc.AppId)">
                                @if (string.Equals(svc.AppId, DemoServiceAppId, StringComparison.Ordinal))
                                {
                                    <span>Exit demo mode</span>
                                }
                                else
                                {
                                    <span>Unpair this service</span>
                                }
                            </button>
                        }
                        <button type="button" class="rec-service-panel-close" @onclick="CloseServicePanel">
                            ← Close details
                        </button>
                    </div>
                }
            }
        }

        @* Phase H (2026-05-19 night) — "Pair a service" surface.
           End-user binds the phone's master secp256k1 pubkey to a
           downstream consumer's user-account via the 8-char code the
           consumer minted server-side. Sister of the operator-pairing
           card below (which binds the PHONE to a bootloader); this
           binds the already-paired phone's MASTER PUBKEY to a
           consumer's user-account. Self-attested model: the consumer
           recovers the signature against the caller-supplied master
           pubkey rather than a pre-banked operator pubkey.

           v1 hardcodes a single known consumer (DefaultConsumer* in
           @code) since one consumer staging deployment is the only one the
           bootloader's devices_pair_consumer_webhook_tokens registry
           contains today. v1.1 polish item: fetch the known-consumers
           list from the bootloader and render a picker.

           Demo-mode (App Review, banked 2026-05-22): hidden when
           IsDemoMode is true. The Phase H pair-a-service flow needs
           a real bootloader to relay the JWS to a downstream consumer,
           and there is none in demo mode. Hiding the surface entirely
           prevents the reviewer from tapping it and hitting another
           network error.
        *@
        @if (!IsDemoMode)
        {
        <details class="rec-pairing-details">
            <summary class="rec-pairing-summary">
                <span class="rec-pairing-summary-label">Add a service</span>
                <span class="rec-pairing-summary-hint">Tap to open</span>
            </summary>
            <div class="rec-pairing-body">
                @if (string.IsNullOrEmpty(_pairServiceSuccessMessage))
                {
                    <p class="text-muted small mb-3">
                        Start a "Connect a phone" or "Pair Recto" flow on a service
                        that supports Recto pairing, then type the 8-character code
                        it shows below. Your master pubkey gets cryptographically
                        bound to your account on that service &mdash; operator-
                        approved at signing time.
                    </p>
                    <dl class="small text-start text-muted mb-3">
                        <dt class="fw-normal">Service</dt>
                        <dd class="fw-semibold">@_pairServiceTargetName</dd>
                        <dt class="fw-normal">Service URL</dt>
                        <dd class="text-break"><code>@DefaultConsumerBaseUrl</code></dd>
                    </dl>
                    <div class="mb-3 text-start">
                        <label for="pair-service-code" class="form-label small">Pairing code</label>
                        <input id="pair-service-code"
                               type="text"
                               inputmode="text"
                               maxlength="8"
                               autocomplete="off"
                               autocapitalize="characters"
                               spellcheck="false"
                               placeholder="XXXXXXXX"
                               class="form-control form-control-lg text-center text-uppercase"
                               style="letter-spacing: 0.4em; font-variant-numeric: tabular-nums;"
                               disabled="@_pairServiceBusy"
                               @bind="_pairServiceCode"
                               @bind:event="oninput" />
                    </div>
                    @* Build 6 (2026-06-02): in-app QR scan button retired.
                       OS Camera + recto://pair URL-scheme deep-link is the
                       canonical scan path on both iOS and Android. See the
                       Build 6 banner above for the architectural rationale
                       (Android 16 ZXing crash, iOS first-permission-grant
                       trap, OS Camera "scan & tap banner" UX is universal
                       muscle-memory on modern phones, App Store reviewer
                       demo QR also routes via recto://). *@
                    <button type="button"
                            class="btn btn-lg btn-primary w-100"
                            disabled="@(!CanSubmitPairService)"
                            @onclick="HandlePairServiceClick">
                        @if (_pairServiceBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                            <span>@_pairServiceBusyText</span>
                        }
                        else
                        {
                            <span>Pair with @_pairServiceTargetName</span>
                        }
                    </button>
                    @if (!string.IsNullOrEmpty(_pairServiceError))
                    {
                        <div class="alert alert-danger small mt-3 mb-0 text-start" role="alert">
                            @_pairServiceError
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-success small text-start mb-3" role="status">
                        <strong>✓ Paired</strong>
                        <div class="mt-2">@_pairServiceSuccessMessage</div>
                    </div>
                    <button type="button"
                            class="btn btn-outline-primary w-100"
                            @onclick="DismissPairServiceSuccess">
                        Pair another service
                    </button>
                }
            </div>
        </details>
        } @* close @if (!IsDemoMode) — Phase H Pair-a-service is hidden in demo mode *@
    }

    <p class="rec-tagline">Phone-resident vault for your services' secrets.</p>

    @if (_paired is not null)
    {
        <div class="card shadow-sm" style="max-width: 32rem; width: 100%;">
            <div class="card-body p-4">
                @if (IsDemoMode)
                {
                    @* Build 5 (2026-06-02): demo-mode banner reworded +
                       gains a "Start fresh" button. Build 4's "Use
                       Settings → Unpair all bootloaders to exit" was
                       behind two taps + read as a one-way exit. Build 5
                       reframes as "restart" and surfaces the button
                       inline so the App Store reviewer (or any user
                       who paired in demo mode accidentally) can restart
                       the pairing flow in one tap without navigating
                       to Settings. Sister of the existing
                       UnpairAllAsync sequence in Settings.razor:
                       Pairing.SaveAsync(null) → Totp.ClearAllAsync →
                       EnclaveKeys.DeleteAsync → navigate to "/". *@
                    <div class="alert alert-info small py-2 mb-3" role="status">
                        <div class="mb-2">
                            <strong>Demo mode active.</strong> No real
                            bootloader is connected — the synthetic pending
                            request below lets you exercise the approval
                            flow with a real biometric + Secure Enclave
                            signature.
                        </div>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary"
                                disabled="@_busy"
                                @onclick="HandleStartFreshClick">
                            Start fresh
                        </button>
                    </div>
                }
                <h2 class="h5 mb-3 text-success">Paired</h2>

                @* Phase 2 disclosure pattern — collapse the bootloader detail
                   surface by default so the operator's pending-requests view
                   is the load-bearing surface on the main screen. The trust
                   indicator ("Paired") stays visible; the diagnostic-detail
                   lookup (bootloader id, phone id, algorithm, TLS pin, paired
                   at, managed secrets list) hides behind a tap on the summary
                   row. Erik's 2026-05-18 ask: "I dislike having the Unpair
                   button on the main screen" — the full Unpair + Registered
                   Phones migration to Settings.razor is queued separately;
                   collapsing the diagnostic detail is the part that drops in
                   without touching the wider routing surface. Native HTML
                   <details>/<summary> works identically on iOS WebKit +
                   Android WebView so the cross-platform style-parity rule
                   from earlier in the sprint is preserved automatically. *@
                <details class="rec-pairing-details">
                    <summary class="rec-pairing-summary">
                        <span class="rec-pairing-summary-label">Pairing details</span>
                        <span class="rec-pairing-summary-hint">Tap to view</span>
                    </summary>
                    <div class="rec-pairing-body">
                        <p class="text-muted small mb-3">
                            This phone is paired with the bootloader at
                            <code>@_paired.BootloaderUrl</code>.
                        </p>
                        @*
                            Long-string trust artifacts (TLS pin, Phone id, Bootloader id) render
                            in FULL inline with a Copy button below — no ellipsis truncation. Per
                            the Recto Phone v1.1 Phase 4 polish entry in CLAUDE.md (banked
                            2026-05-20 morning alongside the artifact-as-canonical-record pivot):
                            "we don't hide anything from you" is the trust signal App Review tends
                            to reward, and operators NEED to be able to cross-reference these values
                            across devices (TLS pin in particular when the bootloader's cert
                            rotates). The QR-code button is a v1.2 follow-up that depends on the
                            `recto/qr/` substrate primitive (Phase 1 of the new 5-phase queue).
                            Until that ships, Copy alone covers the "move this value to another
                            device" use case via the standard mobile-OS clipboard channel.
                        *@
                        <dl class="small text-start text-muted mb-3">
                            <dt class="fw-normal">Bootloader id</dt>
                            <dd class="text-break">
                                <code>@_paired.BootloaderId</code>
                                <div class="rec-artifact-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary rec-artifact-copy"
                                            @onclick="@(async () => await CopyArtifactAsync("bootloaderId", _paired!.BootloaderId))">
                                        @(_pairingCopiedKey == "bootloaderId" ? "Copied" : "Copy")
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary rec-artifact-qr"
                                            @onclick="@(() => ShowQrModal("bootloaderId", "Bootloader id", _paired!.BootloaderId))">
                                        QR
                                    </button>
                                </div>
                            </dd>
                            <dt class="fw-normal">Phone id</dt>
                            <dd class="text-break">
                                <code>@_paired.PhoneId</code>
                                <div class="rec-artifact-actions">
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary rec-artifact-copy"
                                            @onclick="@(async () => await CopyArtifactAsync("phoneId", _paired!.PhoneId))">
                                        @(_pairingCopiedKey == "phoneId" ? "Copied" : "Copy")
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary rec-artifact-qr"
                                            @onclick="@(() => ShowQrModal("phoneId", "Phone id", _paired!.PhoneId))">
                                        QR
                                    </button>
                                </div>
                            </dd>
                            <dt class="fw-normal">Algorithm</dt>
                            <dd><code>@EnclaveKeys.Algorithm</code></dd>
                            <dt class="fw-normal">TLS pin</dt>
                            <dd class="text-break">
                                @if (string.IsNullOrEmpty(_paired.BootloaderSpkiPin))
                                {
                                    @* Real bootloader paired without a pinned cert — amber
                                       warning is canonically correct: operators SHOULD see this
                                       when their bootloader doesn't have cert pinning configured.
                                       Demo mode never reaches this branch because
                                       RunDemoPairFlowAsync populates BootloaderSpkiPin with
                                       a synthetic SHA-256 base64url value (see
                                       DemoBootloaderSpkiPin constant block above). *@
                                    <span class="text-warning">none (system trust only)</span>
                                }
                                else
                                {
                                    <code>@_paired.BootloaderSpkiPin</code>
                                    @if (IsDemoMode)
                                    {
                                        @* Demo-mode honesty marker: the pin above is a
                                           deterministic SHA-256 of a known demo string, not
                                           a real bootloader's SPKI hash. Shows reviewers
                                           what the TLS pin FEATURE looks like (and lets
                                           them exercise Copy / QR on a load-bearing trust
                                           artifact, demonstrating the v1.1 substrate
                                           primitive) without faking real cryptographic
                                           pinning. Banked 2026-05-22 evening per option B
                                           of the honest-trade-off matrix. *@
                                        <div class="text-muted small mt-1">
                                            demo placeholder — real pairing pins the bootloader's SPKI hash
                                        </div>
                                    }
                                    <div class="rec-artifact-actions">
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary rec-artifact-copy"
                                                @onclick="@(async () => await CopyArtifactAsync("tlsPin", _paired!.BootloaderSpkiPin!))">
                                            @(_pairingCopiedKey == "tlsPin" ? "Copied" : "Copy")
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary rec-artifact-qr"
                                                @onclick="@(() => ShowQrModal("tlsPin", "TLS pin", _paired!.BootloaderSpkiPin!))">
                                            QR
                                        </button>
                                    </div>
                                }
                            </dd>
                            <dt class="fw-normal">Paired at</dt>
                            <dd>@_paired.PairedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</dd>
                        </dl>
                        @if (_paired.ManagedSecrets.Count > 0)
                        {
                            <div class="text-start small mb-0">
                                <p class="mb-1 fw-semibold">Managed secrets (@_paired.ManagedSecrets.Count)</p>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var secret in _paired.ManagedSecrets)
                                    {
                                        <li class="text-muted"><code>@secret.Service</code>/<code>@secret.Secret</code> &mdash; @secret.Algorithm</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </details>

                @{
                    var totpFresh = _lastTotpAt is not null
                        && (DateTimeOffset.UtcNow - _lastTotpAt.Value).TotalSeconds < 30
                        && _lastTotpCode is not null;
                }
                @if (totpFresh)
                {
                    <div class="alert alert-info text-center my-3 mb-0" role="alert">
                        <p class="small text-muted mb-1">Last generated TOTP for <code>@_lastTotpAlias</code></p>
                        <p class="display-6 fw-bold mb-1" style="letter-spacing: 0.2em; font-variant-numeric: tabular-nums;">@_lastTotpCode</p>
                        <div class="d-flex align-items-center justify-content-center gap-2 mt-1">
                            <button type="button" class="btn btn-lg btn-outline-primary"
                                    @onclick="() => CopyTotpCodeAsync()">
                                @if (_totpCopied)
                                {
                                    <span>&#10003; Copied</span>
                                }
                                else
                                {
                                    <span>Copy</span>
                                }
                            </button>
                            <span class="small text-muted">
                                Valid for ~@(Math.Max(0, 30 - (int)(DateTimeOffset.UtcNow - _lastTotpAt!.Value).TotalSeconds))s
                            </span>
                        </div>
                    </div>
                }

                <hr class="my-3" />

                @if (!string.IsNullOrEmpty(_pollingError))
                {
                    <div class="alert alert-warning small text-start mb-3 d-flex align-items-start gap-2" role="alert">
                        <div class="flex-grow-1">
                            <strong>Couldn't reach the bootloader.</strong>
                            <div class="text-muted">@_pollingError</div>
                        </div>
                        <button type="button" class="btn btn-lg btn-outline-secondary"
                                @onclick="HandleRetryPollAsync"
                                disabled="@_retrying">
                            @(_retrying ? "Retrying..." : "Retry")
                        </button>
                        <button type="button" class="btn-close ms-1" aria-label="Dismiss"
                                @onclick="() => _pollingError = null"></button>
                    </div>
                }

                @* Build 5 hardening (banked 2026-06-02): inset the Pending
                   Requests header label so it doesn't sit flush against the
                   screen edge on iPhone. Sister of the inline-style pattern
                   used throughout this file — the .rec-pending-header /
                   .rec-pending-title CSS classes are referenced in markup
                   but never defined in app.css, so we override via inline
                   style here. *@
                <div class="rec-pending text-start small">
                    <div class="rec-pending-header" style="padding-left: 8px;">
                        <span class="rec-pending-title">Pending requests</span>
                        @if (_pending.Count > 0)
                        {
                            <span class="badge bg-primary">@_pending.Count</span>
                        }
                    </div>

                    @if (_pending.Count == 0)
                    {
                        <div class="rec-empty">
                            <div class="rec-empty-mark">&#10003;</div>
                            <div class="rec-empty-line">All caught up</div>
                            <div class="rec-empty-sub">Nothing waiting for your approval.</div>
                        </div>
                    }
                    else
                    {
                        // Per-request card body lives in a single
                        // RenderFragment template so both sections share
                        // one source of truth. We're already in C# context
                        // inside the else { } block, so no @{ } wrapper
                        // is needed (Razor RZ1010: "you do not need to
                        // use @{ to switch to code").
                        RenderFragment<PendingRequest> renderCard = (PendingRequest req) =>
                            @<div class="rec-pending-card" data-kind="@req.Kind">
                                <div class="rec-pending-card-body">
                                    @{
                                        // Phase 5 Wave C part 3: app banner
                                        // at the top of every approval card.
                                        // Shows the requesting app's identity
                                        // (icon + name + description) when
                                        // the bootloader has a registered
                                        // AppContext for the principal;
                                        // shows an "Unknown app" warning
                                        // banner otherwise so unregistered
                                        // agents are visible rather than
                                        // silently approved.
                                        var appCtx = req.Context.AppContext;
                                    }
                                    @if (appCtx is not null)
                                    {
                                        <div class="rec-app-banner">
                                            @* AUDIT DETAILS v2 (2026-08-13): a broken-image glyph on a
                                               trust card reads as "something is wrong with this app" —
                                               fall back to an initial/monogram tile instead, both when
                                               the URL is absent and when the fetch fails (inline
                                               onerror swaps the img for the hidden monogram sibling). *@
                                            @{
                                                var appMonogram = string.IsNullOrWhiteSpace(appCtx.AppName)
                                                    ? "?"
                                                    : char.ToUpperInvariant(appCtx.AppName.TrimStart()[0]).ToString();
                                            }
                                            @if (!string.IsNullOrEmpty(appCtx.AppIconUrl))
                                            {
                                                <img class="rec-app-banner-icon"
                                                     src="@appCtx.AppIconUrl"
                                                     alt="@appCtx.AppName icon"
                                                     loading="lazy"
                                                     onerror="this.style.display='none'; var m=this.nextElementSibling; if (m) m.style.display='flex';" />
                                                <div class="rec-app-banner-icon rec-app-banner-monogram"
                                                     style="display:none;align-items:center;justify-content:center;background:#4a5568;color:#fff;font-weight:700;border-radius:8px;"
                                                     aria-hidden="true">@appMonogram</div>
                                            }
                                            else
                                            {
                                                <div class="rec-app-banner-icon rec-app-banner-monogram"
                                                     style="display:flex;align-items:center;justify-content:center;background:#4a5568;color:#fff;font-weight:700;border-radius:8px;"
                                                     aria-hidden="true">@appMonogram</div>
                                            }
                                            <div class="rec-app-banner-text">
                                                <div class="rec-app-banner-name">@appCtx.AppName</div>
                                                @if (!string.IsNullOrEmpty(appCtx.AppDescription))
                                                {
                                                    <div class="rec-app-banner-desc">@appCtx.AppDescription</div>
                                                }
                                                @if (!string.IsNullOrEmpty(appCtx.AppUrl))
                                                {
                                                    <div class="rec-app-banner-url"><code>@appCtx.AppUrl</code></div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(appCtx.AppVersion))
                                            {
                                                @* Explicit parens around the expression because Razor's
                                                   implicit @expression parser treats the "v" prefix +
                                                   dotted member access as an ambiguous token chain and
                                                   renders the binding LITERALLY ("v@appCtx.AppVersion")
                                                   instead of evaluating it. Caught 2026-05-22 when the
                                                   demo synthetic request was the first AppContext to
                                                   ever ship with a non-null AppVersion — every prior
                                                   caller passed null so this branch wasn't reached
                                                   until tonight. Same Razor-parser quirk that bites
                                                   adjacent-character expressions across the codebase. *@
                                                <div class="rec-app-banner-version">v@(appCtx.AppVersion)</div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rec-app-banner rec-app-banner-unknown">
                                            <div class="rec-app-banner-text">
                                                <div class="rec-app-banner-name">⚠ Unknown app</div>
                                                <div class="rec-app-banner-desc">
                                                    No AppContext registered for this principal.
                                                    Verify identity before approving.
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    @switch (req.Kind)
                                    {
                                        case PendingRequestKind.SingleSign:
                                            @* Phase 3 disclosure — primary action (badge + operation
                                               description + service/secret reference) stays visible;
                                               audit-detail subset (hash, PID, argv0) collapses behind
                                               "Audit details" disclosure per Erik's 2026-05-18 ask
                                               ("collapse them all but make them visible on tap"). *@
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-secondary me-1">sign</span>@req.Context.OperationDescription
                                            </p>
                                            <p class="mb-2 text-muted small"><code>@req.Service</code>/<code>@req.Secret</code></p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-1 text-muted small">
                                                        Hash: <code>@TruncateHash(req.Context.PayloadHashB64u ?? "")</code>
                                                    </p>
                                                    <p class="mb-0 text-muted small">
                                                        From PID @req.Context.ChildPid (<code>@req.Context.ChildArgv0</code>)
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.TotpProvision:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-warning text-dark me-1">TOTP</span>Provision secret
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                Alias: <code>@req.Context.TotpAlias</code>
                                            </p>
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-0 text-muted small">
                                                        Period: @(req.Context.TotpPeriodSeconds ?? 30)s,
                                                        digits: @(req.Context.TotpDigits ?? 6),
                                                        alg: @(req.Context.TotpAlgorithm ?? "SHA1")
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.TotpGenerate:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-info text-dark me-1">TOTP</span>Generate code
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                Alias: <code>@req.Context.TotpAlias</code>
                                            </p>
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            break;
                                        case PendingRequestKind.SessionIssuance:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-success me-1">capability</span>Issue JWT
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                <code>@req.Service</code>/<code>@req.Secret</code> &rarr;
                                                bearer <code>@(req.Context.SessionBearer ?? "?")</code>
                                            </p>
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-0 text-muted small">
                                                        Lifetime: @((req.Context.SessionLifetimeSeconds ?? 0) / 3600)h,
                                                        max uses: @(req.Context.SessionMaxUses ?? 0),
                                                        scope: @(req.Context.SessionScope is { Count: > 0 } s ? string.Join(", ", s) : "(none)")
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.WebAuthnAssert:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-primary me-1">passkey</span>Sign in with Recto
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                Site: <code>@(req.Context.WebAuthnRpId ?? "?")</code>
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                Origin: <code>@(req.Context.WebAuthnOrigin ?? "?")</code>
                                            </p>
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            break;
                                        case PendingRequestKind.Pkcs11Sign:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-dark me-1">PKCS#11</span>@(_pkcs11PurposeLabel(req.Context.Purpose))
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.Pkcs11ConsumerLabel))
                                            {
                                                <p class="mb-1 text-muted small">
                                                    Consumer: <code>@req.Context.Pkcs11ConsumerLabel</code>
                                                </p>
                                            }
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-0 text-muted small">
                                                        Hash: <code>@TruncateHash(req.Context.PayloadHashB64u ?? "")</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.PgpSign:
                                            <p class="mb-1 fw-semibold">
                                                <span class="badge bg-secondary me-1">PGP</span>@(_pgpOperationLabel(req.Context.PgpOperation))
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.PgpKeyLabel))
                                            {
                                                <p class="mb-1 text-muted small">
                                                    Key: <code>@req.Context.PgpKeyLabel</code>
                                                </p>
                                            }
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-0 text-muted small">
                                                        Hash: <code>@TruncateHash(req.Context.PayloadHashB64u ?? "")</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.BtcSign:
                                            // Already inside a C# switch-case (the @switch block);
                                            // var declares directly, no @{ } wrapper needed.
                                            // Razor RZ1010 if you re-add @{ here.
                                            var btcCoin = string.IsNullOrEmpty(req.Context.BtcCoin)
                                                ? BtcCoin.Bitcoin
                                                : req.Context.BtcCoin!;
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge @(_btcCoinBadgeClass(btcCoin))">@(_btcCoinTickerLabel(btcCoin))</span>@(_btcMessageKindLabel(req.Context.BtcMessageKind))
                                            </p>
                                            @* Phase 3 — address stays visible (operator must know WHICH
                                               account signs); message/PSBT stays visible (what's being
                                               signed); coin/network/path collapse into audit details. *@
                                            @if (_btcAddressByRequestId.TryGetValue(req.RequestId, out var btcDerivedAddr))
                                            {
                                                <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                    Address: <code>@btcDerivedAddr</code>
                                                </p>
                                            }
                                            @if (req.Context.BtcMessageKind == BtcMessageKind.MessageSigning && !string.IsNullOrEmpty(req.Context.BtcMessageText))
                                            {
                                                <p class="mb-2 text-muted small" style="white-space: pre-wrap; word-break: break-word;">
                                                    <strong>Message:</strong> @req.Context.BtcMessageText
                                                </p>
                                            }
                                            else if (req.Context.BtcMessageKind == BtcMessageKind.Psbt && !string.IsNullOrEmpty(req.Context.BtcPsbtBase64))
                                            {
                                                <p class="mb-2 text-muted small" style="white-space: pre-wrap; word-break: break-word;">
                                                    <strong>PSBT:</strong> <code>@TruncateHash(req.Context.BtcPsbtBase64)</code>
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-1 text-muted small">
                                                        Coin: <code>@(_btcCoinDisplayName(btcCoin))</code>
                                                    </p>
                                                    <p class="mb-1 text-muted small">
                                                        Network: <code>@(_btcNetworkLabel(req.Context.BtcNetwork))</code>
                                                    </p>
                                                    <p class="mb-0 text-muted small">
                                                        Path: <code>@(req.Context.BtcDerivationPath ?? _btcDefaultPathForCoin(btcCoin))</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.EdSign:
                                            // Wave-8 ed25519 chains (SOL / XLM / XRP). Same shape
                                            // as the BTC arm: chain-specific badge + chain name +
                                            // path + derived address + message text.
                                            var edChain = req.Context.EdChain ?? EdChain.Solana;
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge @(_edChainBadgeClass(edChain))">@(_edChainTickerLabel(edChain))</span>@(_edMessageKindLabel(req.Context.EdMessageKind))
                                            </p>
                                            @* Phase 3 — address + message stay visible; chain/path collapse. *@
                                            @if (_edAddressByRequestId.TryGetValue(req.RequestId, out var edDerivedAddr))
                                            {
                                                <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                    Address: <code>@edDerivedAddr</code>
                                                </p>
                                            }
                                            @if (req.Context.EdMessageKind == EdMessageKind.MessageSigning && !string.IsNullOrEmpty(req.Context.EdMessageText))
                                            {
                                                <p class="mb-2 text-muted small" style="white-space: pre-wrap; word-break: break-word;">
                                                    <strong>Message:</strong> @req.Context.EdMessageText
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-1 text-muted small">
                                                        Chain: <code>@(_edChainDisplayName(edChain))</code>
                                                    </p>
                                                    <p class="mb-0 text-muted small">
                                                        Path: <code>@(req.Context.EdDerivationPath ?? _edDefaultPathForChain(edChain))</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.EthSign:
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge rec-coin-badge-eth">ETH</span>@(_ethMessageKindLabel(req.Context.EthMessageKind))
                                            </p>
                                            @* Phase 3 — address stays visible (account-which-signs is
                                               primary trust info), per-kind structured fields stay
                                               visible (EIP-712 primary type / domain / contract;
                                               tx to/value/gas/data). Chain + path collapse into
                                               audit details. Pre-existing nested <details> for
                                               EIP-712 raw JSON + tx raw JSON stay untouched —
                                               they're already collapse-by-default. *@
                                            @if (_ethAddressByRequestId.TryGetValue(req.RequestId, out var derivedAddr))
                                            {
                                                <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                    Address: <code>@derivedAddr</code>
                                                </p>
                                            }
                                            @if (req.Context.EthMessageKind == EthMessageKind.PersonalSign && !string.IsNullOrEmpty(req.Context.EthMessageText))
                                            {
                                                <p class="mb-2 text-muted small" style="white-space: pre-wrap; word-break: break-word;">
                                                    <strong>Message:</strong> @req.Context.EthMessageText
                                                </p>
                                            }
                                            else if (req.Context.EthMessageKind == EthMessageKind.TypedData && !string.IsNullOrEmpty(req.Context.EthTypedDataJson))
                                            {
                                                var td = _ethTypedDataSummary(req.Context.EthTypedDataJson);
                                                <p class="mb-1 text-muted small">
                                                    <strong>Typed data (EIP-712):</strong> <code>@td.PrimaryType</code>
                                                </p>
                                                @if (!string.IsNullOrEmpty(td.DomainName))
                                                {
                                                    <p class="mb-1 text-muted small">
                                                        Domain: <code>@td.DomainName@(td.DomainVersion is null ? "" : $" v{td.DomainVersion}")</code>
                                                    </p>
                                                }
                                                @if (td.VerifyingContract is not null)
                                                {
                                                    <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                        Contract: <code>@td.VerifyingContract</code>
                                                    </p>
                                                }
                                                <details class="mb-2">
                                                    <summary class="text-muted small">Show full message</summary>
                                                    <pre class="text-muted small" style="white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto;">@req.Context.EthTypedDataJson</pre>
                                                </details>
                                            }
                                            else if (req.Context.EthMessageKind == EthMessageKind.Transaction && !string.IsNullOrEmpty(req.Context.EthTransactionJson))
                                            {
                                                var tx = _ethTransactionSummary(req.Context.EthTransactionJson);
                                                @if (!string.IsNullOrEmpty(tx.To))
                                                {
                                                    <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                        To: <code>@tx.To</code>
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p class="mb-1 text-muted small">
                                                        <strong>Contract creation</strong>
                                                    </p>
                                                }
                                                @if (!string.IsNullOrEmpty(tx.ValueDisplay))
                                                {
                                                    <p class="mb-1 text-muted small">
                                                        Value: <code>@tx.ValueDisplay</code>
                                                    </p>
                                                }
                                                @if (!string.IsNullOrEmpty(tx.GasDisplay))
                                                {
                                                    <p class="mb-1 text-muted small">
                                                        Gas: <code>@tx.GasDisplay</code>
                                                    </p>
                                                }
                                                @if (!string.IsNullOrEmpty(tx.MaxFeeDisplay))
                                                {
                                                    <p class="mb-1 text-muted small">
                                                        Max fee: <code>@tx.MaxFeeDisplay</code>
                                                    </p>
                                                }
                                                @if (!string.IsNullOrEmpty(tx.DataPreview))
                                                {
                                                    <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                        Data: <code>@tx.DataPreview</code>
                                                    </p>
                                                }
                                                <details class="mb-2">
                                                    <summary class="text-muted small">Show raw JSON</summary>
                                                    <pre class="text-muted small" style="white-space: pre-wrap; word-break: break-word; max-height: 200px; overflow-y: auto;">@req.Context.EthTransactionJson</pre>
                                                </details>
                                            }
                                            else
                                            {
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-1 text-muted small">
                                                        Chain: <code>@(_ethChainLabel(req.Context.EthChainId))</code>
                                                    </p>
                                                    <p class="mb-0 text-muted small">
                                                        Path: <code>@(req.Context.EthDerivationPath ?? "m/44'/60'/0'/0/0")</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.TronSign:
                                            // Wave 9: TRON message_signing. Same secp256k1 +
                                            // Keccak-256 primitive as ETH but with TIP-191 preamble
                                            // and base58check T-prefixed addresses. No chainId since
                                            // TRON's network distinction lives at RPC, not at the
                                            // signature layer; we surface tron_network as the label.
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge rec-coin-badge-tron">TRX</span>@(_tronMessageKindLabel(req.Context.TronMessageKind))
                                            </p>
                                            @* Phase 3 — address + message stay visible; network/path collapse. *@
                                            @if (_tronAddressByRequestId.TryGetValue(req.RequestId, out var tronDerivedAddr))
                                            {
                                                <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                    Address: <code>@tronDerivedAddr</code>
                                                </p>
                                            }
                                            @if (req.Context.TronMessageKind == TronMessageKind.MessageSigning && !string.IsNullOrEmpty(req.Context.TronMessageText))
                                            {
                                                <p class="mb-2 text-muted small" style="white-space: pre-wrap; word-break: break-word;">
                                                    <strong>Message:</strong> @req.Context.TronMessageText
                                                </p>
                                            }
                                            else
                                            {
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    <p class="mb-1 text-muted small">
                                                        Network: <code>@(_tronNetworkLabel(req.Context.TronNetwork))</code>
                                                    </p>
                                                    <p class="mb-0 text-muted small">
                                                        Path: <code>@(req.Context.TronDerivationPath ?? "m/44'/195'/0'/0/0")</code>
                                                    </p>
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.CapabilityRequest:
                                            // Phase 5 Wave B: structured-list approval UI rendered
                                            // from the typed CapabilityClaims decoded from
                                            // cap_payload_b64. Foundation-count breakdown tree
                                            // (groups -> actions -> counts, running weight totals
                                            // against tier ceiling) is computed via
                                            // ActionManifestLoader.ClauseWeightBreakdown when a
                                            // manifest is loaded; absent that, we still render the
                                            // raw groups list so the operator sees what's being
                                            // requested.
                                            @if (_capabilityDecodedByRequestId.TryGetValue(req.RequestId, out var capDecoded))
                                            {
                                                @* AUDIT DETAILS v2 (2026-08-13). LAW: sign-what-you-see —
                                                   every field in the signed section renders from the exact
                                                   cap_payload_b64 bytes the approval will sign (via
                                                   CapabilityAuditView, computed from the decoded claims
                                                   and nothing else). Transport facts (cap_agent_id,
                                                   AppContext) render BELOW, visually separated and
                                                   labeled unsigned. Cross-check warnings render with
                                                   inline styling + role="alert" so no theme or CSS
                                                   override can suppress them. *@
                                                <p class="mb-1 fw-semibold">
                                                    <span class="rec-coin-badge rec-coin-badge-cap">CAP</span>@(capDecoded.PurposeShort)
                                                </p>
                                                @foreach (var warning in capDecoded.Warnings)
                                                {
                                                    @* Contradiction inside the signed payload. Inline
                                                       styles on purpose: a warning a stylesheet can hide
                                                       is not a warning. *@
                                                    <p role="alert"
                                                       style="color:#ffffff;background:#b00020;border:2px solid #7f0016;border-radius:6px;padding:6px 10px;font-weight:600;margin:0 0 8px 0;word-break:break-word;">
                                                        &#9888; @warning
                                                    </p>
                                                }
                                                <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                    Acting agent: <code>@capDecoded.ActingAgent</code>
                                                </p>
                                                @if (capDecoded.OnBehalfOfUser is not null)
                                                {
                                                    <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                        On behalf of user: <code>@capDecoded.OnBehalfOfUser</code>
                                                    </p>
                                                }
                                                <p class="mb-1 text-muted small">
                                                    Tier: <strong>@capDecoded.Tier</strong>@if (capDecoded.TierCeiling.HasValue) {<span> / ceiling @capDecoded.TierCeiling</span>}
                                                </p>
                                                <p class="mb-1 text-muted small">
                                                    Validity: requested @capDecoded.RequestedAgo &middot; @capDecoded.TimeLeft
                                                    (until <code>@capDecoded.ExpiresLocal</code>)
                                                </p>
                                                <details class="mb-2">
                                                    <summary class="text-muted small">
                                                        Actions (@capDecoded.AllowedCount allowed &middot; @capDecoded.DeniedCount denied &middot; @capDecoded.GroupCount group-derived)
                                                    </summary>
                                                    <div class="text-muted small">
                                                        @if (capDecoded.AllowedActions.Count > 0)
                                                        {
                                                            <div class="mb-1">
                                                                Allowed actions:
                                                                <ul class="mb-1">
                                                                    @foreach (var a in capDecoded.AllowedActions)
                                                                    {
                                                                        <li><code>@a</code></li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        @if (capDecoded.DeniedActions.Count > 0)
                                                        {
                                                            <div class="mb-1">
                                                                Denied actions:
                                                                <ul class="mb-1">
                                                                    @foreach (var a in capDecoded.DeniedActions)
                                                                    {
                                                                        <li><code>@a</code></li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                        @if (capDecoded.Groups.Count > 0)
                                                        {
                                                            <div class="mb-0">
                                                                Group-derived (resolved by the manifest at verify time):
                                                                <ul class="mb-0">
                                                                    @foreach (var g in capDecoded.Groups)
                                                                    {
                                                                        <li><code>@g</code></li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        }
                                                    </div>
                                                </details>
                                                <details class="rec-disclosure">
                                                    <summary>Audit details</summary>
                                                    <div class="rec-disclosure-body">
                                                        @if (capDecoded.ScopeServices.Count > 0 || capDecoded.ScopeRepos.Count > 0 || capDecoded.ScopeEnv.Count > 0)
                                                        {
                                                            <p class="mb-1 text-muted small">
                                                                Scope:
                                                                @if (capDecoded.ScopeServices.Count > 0) {<span> services <code>@string.Join(", ", capDecoded.ScopeServices)</code></span>}
                                                                @if (capDecoded.ScopeRepos.Count > 0) {<span> &middot; repos <code>@string.Join(", ", capDecoded.ScopeRepos)</code></span>}
                                                                @if (capDecoded.ScopeEnv.Count > 0) {<span> &middot; env <code>@string.Join(", ", capDecoded.ScopeEnv)</code></span>}
                                                            </p>
                                                        }
                                                        <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                            You will issue as: <code>@capDecoded.WillIssueAs</code>
                                                        </p>
                                                        <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                            Request id@(capDecoded.SingleUse ? " (single-use)" : ""): <code>@capDecoded.Jti</code>
                                                        </p>
                                                        <p class="mb-0 text-muted small">
                                                            Registry: <code>@capDecoded.RegistryVersion</code>
                                                        </p>
                                                    </div>
                                                </details>
                                                <div class="rec-transport-section"
                                                     style="margin-top:8px;padding:6px 10px;border:1px dashed #999;border-radius:6px;">
                                                    <p class="mb-1 small" style="letter-spacing:0.04em;color:#666;">
                                                        TRANSPORT &mdash; not covered by the signature
                                                    </p>
                                                    <p class="mb-0 text-muted small" style="word-break: break-all;">
                                                        Delivered by:
                                                        @if (!string.IsNullOrEmpty(req.Context.CapAgentId))
                                                        {
                                                            <code>@req.Context.CapAgentId</code>
                                                        }
                                                        @if (req.Context.AppContext is not null)
                                                        {
                                                            <span> &middot; @req.Context.AppContext.AppName</span>
                                                            @if (!string.IsNullOrEmpty(req.Context.AppContext.AppUrl))
                                                            {
                                                                <span> (<code>@req.Context.AppContext.AppUrl</code>)</span>
                                                            }
                                                        }
                                                    </p>
                                                </div>
                                            }
                                            else if (!string.IsNullOrEmpty(_capabilityDecodeErrorByRequestId.GetValueOrDefault(req.RequestId)))
                                            {
                                                <p class="mb-1 fw-semibold text-danger">
                                                    <span class="rec-coin-badge rec-coin-badge-cap">CAP</span> capability_request (decode failed)
                                                </p>
                                                <p class="mb-2 text-muted small">@(_capabilityDecodeErrorByRequestId[req.RequestId])</p>
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            else
                                            {
                                                <p class="mb-1 fw-semibold">
                                                    <span class="rec-coin-badge rec-coin-badge-cap">CAP</span> capability_request
                                                </p>
                                                <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            }
                                            break;
                                        case PendingRequestKind.ProfileCreate:
                                            // Phase 2.0.C wave C.3: profile_create
                                            // approval card. Renders the candidate
                                            // fields straight off PendingRequestContext
                                            // (no decoded-view needed -- the
                                            // bootloader stashed them as structured
                                            // fields at queue time alongside the
                                            // canonical-JSON in cap_payload_b64).
                                            @* Phase 3 — primary surface: headline + Kind + Display
                                               name (operator's choice of what the new profile is).
                                               Audit details: BIP-32 derivation path, theme hint,
                                               SCIM provider, caller-authored profile id, requesting
                                               agent — all verifiable / technical detail that the
                                               operator typically doesn't need to read at every
                                               approval. *@
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge rec-coin-badge-cap">PROFILE</span>
                                                Mint child profile
                                            </p>
                                            <p class="mb-1 text-muted small">
                                                Kind: <code>@req.Context.CandidateKind</code>
                                            </p>
                                            <p class="mb-2 text-muted small">
                                                Display name: <strong>@req.Context.CandidateDisplayName</strong>
                                            </p>
                                            <details class="rec-disclosure">
                                                <summary>Audit details</summary>
                                                <div class="rec-disclosure-body">
                                                    @if (req.Context.CandidateDerivationPurpose.HasValue
                                                        && req.Context.CandidateDerivationCoinType.HasValue
                                                        && req.Context.CandidateDerivationIndex.HasValue)
                                                    {
                                                        <p class="mb-1 text-muted small">
                                                            Derivation:
                                                            <code>m/@(req.Context.CandidateDerivationPurpose)'/@(req.Context.CandidateDerivationCoinType)'/@(req.Context.CandidateDerivationIndex)'</code>
                                                        </p>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.Context.CandidateThemeHint))
                                                    {
                                                        <p class="mb-1 text-muted small">
                                                            Theme hint: <code>@req.Context.CandidateThemeHint</code>
                                                        </p>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.Context.CandidateScimProvider))
                                                    {
                                                        <p class="mb-1 text-muted small">
                                                            SCIM provider: <code>@req.Context.CandidateScimProvider</code>
                                                        </p>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.Context.CandidateProfileId))
                                                    {
                                                        <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                            Profile id (caller-authored): <code>@req.Context.CandidateProfileId</code>
                                                        </p>
                                                    }
                                                    @if (!string.IsNullOrEmpty(req.Context.CapAgentId))
                                                    {
                                                        <p class="mb-0 text-muted small">
                                                            Requesting agent: <code>@req.Context.CapAgentId</code>
                                                        </p>
                                                    }
                                                </div>
                                            </details>
                                            break;
                                        case PendingRequestKind.ProfileRevokeDevice:
                                            // Phase 2.0.C wave C.6.c: profile_revoke_device
                                            // approval card. The operator master phone is
                                            // being asked to attest the REMOVAL of a paired
                                            // device from an existing profile's device_ids
                                            // tuple.
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge rec-coin-badge-cap">PROFILE</span>
                                                Revoke device from profile
                                            </p>
                                            <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                Target profile: <code>@req.Context.RevdevProfileId</code>
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.RevdevRevokerLabel))
                                            {
                                                <p class="mb-1 text-muted small">
                                                    Approving as: <strong>@req.Context.RevdevRevokerLabel</strong>
                                                </p>
                                            }
                                            <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                Removing phone id: <code>@req.Context.RevdevPhoneIdToRevoke</code>
                                            </p>
                                            <p class="mb-2 text-muted small">
                                                Approving REMOVES the named device from
                                                this profile's authorized device set. The
                                                device can no longer sign capability
                                                requests OR approve future add-device /
                                                revoke-device operations under this
                                                profile. Other profiles the device is on
                                                are unaffected. The removal is recorded
                                                with cryptographic evidence via the
                                                operator master key.
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.CapAgentId))
                                            {
                                                <details class="rec-disclosure">
                                                    <summary>Audit details</summary>
                                                    <div class="rec-disclosure-body">
                                                        <p class="mb-0 text-muted small">
                                                            Requesting agent: <code>@req.Context.CapAgentId</code>
                                                        </p>
                                                    </div>
                                                </details>
                                            }
                                            break;
                                        case PendingRequestKind.ProfileAddDevice:
                                            // Phase 2.0.C wave C.5.c: profile_add_device
                                            // approval card. The operator master phone
                                            // is being asked to attest the addition of a
                                            // newly-paired device to an existing
                                            // profile's device_ids tuple.
                                            <p class="mb-1 fw-semibold">
                                                <span class="rec-coin-badge rec-coin-badge-cap">PROFILE</span>
                                                Add device to profile
                                            </p>
                                            <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                Target profile: <code>@req.Context.AddevProfileId</code>
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.AddevNewPhoneLabel))
                                            {
                                                <p class="mb-1 text-muted small">
                                                    New device: <strong>@req.Context.AddevNewPhoneLabel</strong>
                                                </p>
                                            }
                                            <p class="mb-1 text-muted small" style="word-break: break-all;">
                                                New phone id: <code>@req.Context.AddevNewPhoneId</code>
                                            </p>
                                            <p class="mb-2 text-muted small">
                                                Approving authorizes the named device to
                                                act on this profile's behalf going forward
                                                (sign capability requests, approve future
                                                add-device / revoke-device operations).
                                                The approval is recorded with cryptographic
                                                evidence via the operator master key.
                                            </p>
                                            @if (!string.IsNullOrEmpty(req.Context.CapAgentId))
                                            {
                                                <details class="rec-disclosure">
                                                    <summary>Audit details</summary>
                                                    <div class="rec-disclosure-body">
                                                        <p class="mb-0 text-muted small">
                                                            Requesting agent: <code>@req.Context.CapAgentId</code>
                                                        </p>
                                                    </div>
                                                </details>
                                            }
                                            break;
                                        default:
                                            <p class="mb-1 fw-semibold">Unknown request kind: <code>@req.Kind</code></p>
                                            <p class="mb-2 text-muted small">@req.Context.OperationDescription</p>
                                            break;
                                    }

                                    @* v1 polish: canonical .rec-btn-approve / .rec-btn-deny.
                                       Equal-size enforced by .rec-btn min-width + min-height +
                                       .rec-btn-row flex: 1 1 0 so siblings always measure
                                       identically on iOS WebKit + Android WebView regardless
                                       of label length. Processing-state button matches the
                                       same size geometry via .rec-btn (no .btn-lg / btn-sm
                                       modifier — there IS no smaller variant to accidentally
                                       apply). *@
                                    @if (_processingRequestId == req.RequestId)
                                    {
                                        <div class="rec-btn-row">
                                            <button class="rec-btn rec-btn-ghost" style="flex: 1 1 0; cursor: not-allowed;" disabled>
                                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                                <span>@_processingText</span>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rec-btn-row">
                                            <button class="rec-btn rec-btn-approve"
                                                    disabled="@(!string.IsNullOrEmpty(_processingRequestId))"
                                                    @onclick="() => HandleApproveAsync(req)">
                                                Approve
                                            </button>
                                            <button class="rec-btn rec-btn-deny"
                                                    disabled="@(!string.IsNullOrEmpty(_processingRequestId))"
                                                    @onclick="() => HandleDenyAsync(req)">
                                                Deny
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>;

                            var identityReqs = _pending.Where(r => !IsTokenSigningKind(r.Kind)).ToList();
                            var tokenReqs = _pending.Where(r => IsTokenSigningKind(r.Kind)).ToList();

                        @if (identityReqs.Count > 0)
                        {
                            <section class="rec-section rec-section-identity">
                                <div class="rec-section-header">
                                    <span class="rec-section-mark">●</span>
                                    <span class="rec-section-title">Identity &amp; Access</span>
                                    <span class="rec-section-count">@identityReqs.Count</span>
                                </div>
                                @foreach (var req in identityReqs)
                                {
                                    @renderCard(req)
                                }
                            </section>
                        }

                        @if (tokenReqs.Count > 0)
                        {
                            <section class="rec-section rec-section-tokens">
                                <div class="rec-section-header">
                                    <span class="rec-section-mark">◆</span>
                                    <span class="rec-section-title">Crypto Tokens</span>
                                    <span class="rec-section-count">@tokenReqs.Count</span>
                                </div>
                                @foreach (var req in tokenReqs)
                                {
                                    @renderCard(req)
                                }
                            </section>
                        }
                    }
                </div>

                <hr class="my-3" />

                @* Phase 2 disclosure — Registered Phones stays on the main
                   screen (critical security feature: operators with N paired
                   phones must be able to revoke a lost device from a
                   surviving one without first navigating to Settings) but
                   collapses by default so it isn't visual weight when no
                   revocation is in flight. Summary row carries the count
                   badge so "how many phones are paired?" is answerable
                   at-a-glance without expanding. Refresh button moves
                   INSIDE the body so a tap doesn't accidentally toggle
                   the disclosure. Sister of the Pairing-details
                   disclosure above; reuses the same .rec-pairing-details
                   CSS recipe. *@
                <details class="rec-pairing-details">
                    <summary class="rec-pairing-summary">
                        <span class="rec-pairing-summary-label">
                            Registered phones
                            @if (_registeredPhones.Count > 0)
                            {
                                <span class="badge bg-secondary ms-1">@_registeredPhones.Count</span>
                            }
                        </span>
                        <span class="rec-pairing-summary-hint">Tap to view</span>
                    </summary>
                    <div class="rec-pairing-body">
                        <div class="text-start small">
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-lg btn-link p-0"
                                        disabled="@_refreshingPhones"
                                        @onclick="() => RefreshRegisteredPhonesAsync(CancellationToken.None)">
                                    @if (_refreshingPhones)
                                    {
                                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span>Refresh</span>
                                    }
                                </button>
                            </div>

                            @if (_registeredPhones.Count == 0)
                            {
                                <p class="text-muted mb-0">
                                    Only this phone is registered. Pair another phone as a backup so a
                                    lost device can be revoked from the surviving one.
                                </p>
                            }
                            else
                            {
                                @foreach (var other in _registeredPhones)
                                {
                                    <div class="card mb-2 border-secondary-subtle">
                                        <div class="card-body p-3">
                                            <p class="mb-1 fw-semibold">@other.DeviceLabel</p>
                                            <p class="mb-1 text-muted small">
                                                <code>@other.PhoneId</code>
                                            </p>
                                            <p class="mb-2 text-muted small">
                                                @other.Algorithm &mdash; paired @other.PairedAt
                                            </p>
                                            @if (_revokingPhoneId == other.PhoneId)
                                            {
                                                <button class="btn btn-lg btn-danger w-100" disabled>
                                                    <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                                                    <span>@_revokingText</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-lg btn-outline-danger w-100"
                                                        disabled="@(!string.IsNullOrEmpty(_revokingPhoneId))"
                                                        @onclick="() => HandleRevokeAsync(other)">
                                                    Revoke
                                                </button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </details>

                @* Phase 2 — Unpair button removed from main screen per Erik's
                   2026-05-18 feedback ("I dislike having the Unpair button on
                   the main screen"). Settings.razor's Danger zone already
                   carries the canonical "Unpair all bootloaders" flow with a
                   proper two-step confirmation, full wipe semantics (pairing
                   + TOTP + pin store + enclave key) and red visual treatment.
                   That's the right home for it. HandleUnpairClick is left
                   in @code for now as a private soft-unpair primitive in
                   case a future Settings sub-feature wants the partial-wipe
                   path (clear pairing only, preserve TOTP secrets) —
                   removing the method body is a separate polish pass. *@
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm" style="max-width: 28rem; width: 100%;">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Not paired yet</h2>

                @* Build 7 (banked 2026-06-02 night): end-user first-pair
                   ceremony banner. Renders ABOVE the App Store reviewer
                   demo banner when the user came in via a Service-kind QR
                   with bootstrap_bootloader + bootstrap_pair_code (the
                   canonical end-user flow). The bootloader URL +
                   bootloader-pair code fields are already pre-filled from
                   the QR; this banner just explains what's about to
                   happen so the single tap on Pair feels intentional. *@
                @if (_firstPairCeremonyActive)
                {
                    <div class="alert mb-3 text-start" role="alert"
                         style="background: rgba(25, 135, 84, 0.18);
                                border: 1px solid var(--bs-success, #198754);
                                color: #d1f5dd;">
                        <strong style="color: #ffffff;">Pair with @FirstPairServiceHostname?</strong>
                        We'll pair your phone with this service so signing
                        requests for your account can reach this device.
                        Tap <strong style="color: #ffffff;">Pair</strong> below to confirm —
                        your bootloader URL and pairing code have been
                        pre-filled from the QR you scanned. The biometric
                        prompt will fire to generate your phone's signing
                        key.
                    </div>
                }

                @* Build 5 (2026-06-02): App Store reviewer demo banner
                   HOISTED to the top of the card + restyled as a
                   prominent cyan call-out. Build 4's positioning was
                   below the bootloader-URL instructions, which Apple's
                   reviewer skimmed past — Build 4's rejection said
                   "we cannot access to the 'pairing code' as suggested",
                   meaning the reviewer never saw the 000000 instruction.
                   This block is now the FIRST thing they see after the
                   "Not paired yet" header so the demo path is impossible
                   to miss. *@
                @* Build 5 hardening (banked 2026-06-02): high-contrast
                   light text on translucent cyan background. The previous
                   #055160 dark-cyan body color assumed Bootstrap's default
                   light-page-background convention, but Recto's dark theme
                   makes the translucent cyan overlay sit on a dark page —
                   dark-on-dark was unreadable on actual phone hardware
                   (caught on the Mac mini simulator 2026-06-02). Light
                   cyan #e0f6ff reads cleanly against the dark page
                   while preserving the info-banner cyan identity.
                   Build 7 (2026-06-02 night): hidden during the first-
                   pair ceremony — end users coming from a Service-kind
                   QR don't need the App Store reviewer demo guidance. *@
                <div class="alert mb-3 text-start" role="alert"
                     hidden="@_firstPairCeremonyActive"
                     style="background: rgba(13, 202, 240, 0.18);
                            border: 1px solid var(--bs-info, #0dcaf0);
                            color: #e0f6ff;">
                    <strong style="color: #ffffff;">App Store reviewer — demo mode access:</strong>
                    Enter pairing code
                    <code style="background: rgba(13, 202, 240, 0.4);
                                 color: #ffffff;
                                 padding: 2px 6px;
                                 border-radius: 4px;
                                 font-weight: 700;">000000</code>
                    and tap <strong style="color: #ffffff;">Pair</strong>. You can leave the
                    bootloader URL blank. Demo mode exercises the full UX
                    end-to-end (real biometric prompt + real Secure Enclave
                    signing); only the network handshake is mocked. To exit
                    demo mode, tap <strong style="color: #ffffff;">Start fresh</strong> on the
                    paired card or go to Settings → Danger zone →
                    Unpair all bootloaders.
                </div>

                @* Build 7 (banked 2026-06-02 night): hide the operator-
                   targeted "Real pairing" hint during the first-pair
                   ceremony. End users coming from a Service-kind QR
                   don't need to know about running recto v0.4 register
                   on a server — their downstream consumer hosts a
                   managed bootloader and minted the codes for them. *@
                @if (!_firstPairCeremonyActive)
                {
                    <p class="text-muted small mb-4">
                        Real pairing: enter your Recto bootloader's URL and
                        the 6-digit pairing code. Run <code>recto v0.4 register</code>
                        on the server to mint one.
                    </p>
                }

                @* Build 5: bootloader URL field auto-collapses when the
                   demo code "000000" is typed. Visual confirmation the
                   demo path is the right input — reviewer sees the URL
                   field vanish + the cyan banner now glows brighter,
                   confirming the demo path is active. *@
                <div class="mb-3 text-start"
                     style="@(IsDemoPairAttempt ? "display: none;" : "")">
                    <label for="bootloader-url" class="form-label small">Bootloader URL</label>
                    <input id="bootloader-url"
                           type="url"
                           autocomplete="off"
                           placeholder="https://recto-bootloader.example.com"
                           class="form-control"
                           disabled="@_busy"
                           @bind="_bootloaderUrl"
                           @bind:event="oninput" />
                </div>

                @if (IsDemoPairAttempt)
                {
                    <div class="alert alert-success small mb-3 text-start" role="alert">
                        <strong>Demo mode active.</strong> Tap <strong>Pair</strong>
                        to enter demo mode. Face ID / Touch ID will prompt for real;
                        no server required.
                    </div>
                }

                <div class="mb-3 text-start">
                    <label for="pairing-code" class="form-label small">Pairing code</label>
                    <input id="pairing-code"
                           type="text"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="off"
                           placeholder="000000"
                           class="form-control form-control-lg text-center"
                           style="letter-spacing: 0.4em; font-variant-numeric: tabular-nums;"
                           disabled="@_busy"
                           @bind="_pairingCode"
                           @bind:event="oninput" />
                </div>

                <button type="button"
                        class="btn btn-lg btn-primary w-100"
                        disabled="@(!CanPair)"
                        @onclick="HandlePairClick">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        <span>@_busyText</span>
                    }
                    else
                    {
                        <span>Pair</span>
                    }
                </button>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    @* Build 5 (2026-06-02): route _errorMessage through
                       EnclaveErrors.TranslateRectoEnclaveError to map raw
                       OSStatus / LAError / Android KeyStore exception
                       text to user-readable actionable strings. The Apple
                       reviewer's rejection of Build 4 was triggered by a
                       raw OSStatus -25293 dump landing here when biometric
                       wasn't enrolled. Translation surfaces "Open iOS
                       Settings → Face ID & Passcode and enroll Face ID"
                       instead. Sister of the EnclaveErrors helper banked
                       in Recto.Shared/Services/EnclaveErrors.cs. *@
                    <div class="alert alert-danger small mt-3 mb-0 text-start" role="alert">
                        @EnclaveErrors.TranslateRectoEnclaveError(_errorMessage)
                    </div>
                }

                @if (_biometricsStatusMessage is not null)
                {
                    @* Build 5: pre-flight biometric availability warning.
                       Banked from IBiometricsAvailability.CheckAsync run
                       at OnInitializedAsync + every render. Shows ONLY
                       when status != Available + status != Unknown
                       (Unknown silently falls through so keygen path
                       surfaces the real error). *@
                    <div class="alert alert-warning small mt-3 mb-0 text-start" role="alert">
                        @_biometricsStatusMessage
                    </div>
                }

                <p class="text-muted small mt-3 mb-0 text-start">
                    Signing algorithm: <code>@EnclaveKeys.Algorithm</code>
                </p>
            </div>
        </div>
    }

    <p class="text-muted small mt-4 mb-0">
        Running on <em>@FormFactor.GetFormFactor()</em> &mdash; <em>@FormFactor.GetPlatform()</em>
    </p>

    @* Recto Phone v1.1 Phase 2.C — QR-rendering modal for long-string
        trust artifacts (TLS pin / Phone id / Bootloader id). Rendered
        as an overlay outside the main page flow so it sits above
        whatever content is below. Tap-outside (overlay click) AND
        the explicit Close button both close via CloseQrModal. Modal
        only renders when _qrModalArtifactKey is non-null; otherwise
        the whole subtree is absent from the DOM. *@
    @if (_qrModalArtifactKey is not null && _qrModalDataUri is not null)
    {
        <div class="rec-qr-modal-overlay" @onclick="CloseQrModal">
            @* Inner card stops click propagation so tapping the QR
                itself doesn't dismiss the modal — only overlay taps. *@
            <div class="rec-qr-modal" @onclick:stopPropagation="true">
                <h5 class="rec-qr-modal-label">@_qrModalArtifactLabel</h5>
                <img class="rec-qr-modal-image" src="@_qrModalDataUri" alt="@($"QR code for {_qrModalArtifactLabel}")" />
                <code class="rec-qr-modal-value">@_qrModalArtifactValue</code>
                <button type="button"
                        class="btn btn-sm btn-outline-secondary rec-qr-modal-close"
                        @onclick="CloseQrModal">
                    Close
                </button>
            </div>
        </div>
    }
</div>

@code {
    private const string KeyAlias = "recto.phone.identity";
    // Wave-4: alias is the suffix of the SecureStorage key
    // ("recto.phone.eth.mnemonic.{alias}"). Keep this single canonical
    // alias for the v0.5+ universal-vault first-account behavior; future
    // multi-account UI can pick alternative aliases (e.g. "trading",
    // "longterm", "thru-governance") to give each its own mnemonic.
    private const string EthKeyAlias = "default";
    // Wave-5: BTC service shares the same SecureStorage entry as ETH
    // (one mnemonic per phone, two BIP-44 trees). The alias here is
    // the same as EthKeyAlias on purpose. Future v0.6+ vault refactor
    // will collapse both into a single VaultAlias.
    private const string BtcKeyAlias = "default";
    // Wave-8: ED service also shares the same SecureStorage entry. One
    // mnemonic per phone covers ETH + BTC + ED (eight chain coin
    // families now: ETH/BTC/LTC/DOGE/BCH/SOL/XLM/XRP). Same alias
    // again — three services point at the same row in storage.
    private const string EdKeyAlias = "default";
    // Wave 9: TRON service shares the same SecureStorage entry as
    // ETH / BTC / ED. One mnemonic, nine chain trees now (ETH, BTC,
    // LTC, DOGE, BCH, SOL, XLM, XRP, TRON). Same alias again -- four
    // services pointing at the same row in storage.
    private const string TronKeyAlias = "default";
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(3);

    // App Store review demo-mode (banked 2026-05-22 for Apple Guideline 2.1(a)
    // resubmission). Apple's reviewer rejected 1.0 (2) because they couldn't
    // pair the app without a real bootloader -- the screenshot they attached
    // shows them entering "000000" (matching the placeholder) into a
    // truncated bootloader URL field and hitting net_http_client_invalid_requesturi.
    // Demo mode: when the operator types DemoPairingCode AND the bootloader URL
    // is empty OR doesn't successfully reach a real bootloader, we short-circuit
    // the HTTP pairing handshake entirely. The biometric prompt + Secure
    // Enclave key generation + ECDSA signing all run REAL so the reviewer
    // sees the full UX -- only the network layer is mocked. After "pairing",
    // we surface ONE synthetic SingleSign request so the reviewer can also
    // exercise the approve flow with a real biometric prompt + real
    // enclave signature (the response just gets discarded locally instead
    // of POSTing to a fake bootloader). _paired.BootloaderUrl is the
    // sentinel -- IsDemoMode checks for the demo:// scheme.
    //
    // The demo code is "000000" (6 zeros) because (a) it matches the
    // placeholder text in the form so Apple's reviewer will type exactly
    // this if they follow the placeholder, AND (b) it's what their
    // attached screenshot shows them already typing. First-attempt success.
    //
    // SAFETY: real users typing "000000" by accident would also enter demo
    // mode, but a real bootloader will never mint "000000" as a pairing
    // code (the canonical Recto pairing code is randomly generated). So
    // the worst case is a real user gets a "Paired with App Review
    // Demo Bootloader" state instead of a real pairing -- they can hit
    // Unpair All Bootloaders in Settings and try again with the real
    // code.
    // Sourced from PairDeepLinkConstants (banked 2026-06-01 alongside the
    // demo-mode QR primitive, task #41). The Constants class is the single
    // source of truth shared by Home.razor, PairDeepLinkParser (deep-link
    // ingest path), PairDeepLinkEmitter (QR-render path), and the Python
    // sister at recto/qr/pair.py. Any drift across those surfaces would
    // surface as a demo-QR-doesn't-work mystery; centralizing eliminates
    // the failure mode. The fields stay private const string per Razor's
    // @code-block convention so existing call sites (DemoPairingCode in
    // CanPair, IsDemoPairAttempt, etc.) keep their bare-identifier syntax.
    private const string DemoPairingCode = PairDeepLinkConstants.DemoPairingCode;
    private const string DemoBootloaderUrl = PairDeepLinkConstants.DemoBootloaderUrl;
    private const string DemoBootloaderId = PairDeepLinkConstants.DemoBootloaderId;

    // Synthetic SPKI pin for demo mode. Deterministic SHA-256 base64url
    // of a fixed demo-mode marker string, computed once at class load.
    // Lets the Pairing Details disclosure show a real-looking TLS pin
    // row in demo mode (with Copy / QR buttons fully functional,
    // demonstrating the v1.1 portability primitive on a load-bearing
    // trust artifact) while staying honest about being synthetic via
    // the "demo placeholder" subscript next to the pin value.
    //
    // Banked 2026-05-22 evening after Erik flagged that hiding the
    // TLS pin in demo mode obscured one of the app's core security
    // features from App Store reviewers. Option B from the
    // honest-trade-off matrix (synthetic + explicitly labeled in UI):
    // (A) "n/a (offline demo pairing)" hides the feature, (B) this
    // synthetic + labeled approach shows the feature while marking
    // it as a demo placeholder, (C) a real network handshake to a
    // demo server is overkill for the demo flow.
    //
    // The marker string is intentionally distinctive ("demo-recto-
    // app-review-spki-placeholder") so a curious reviewer who hashes
    // it gets a value matching what's displayed — provable that it's
    // synthetic, not a leaked real pin.
    private static readonly string DemoBootloaderSpkiPin = ComputeDemoSpkiPin();
    private static string ComputeDemoSpkiPin()
    {
        var bytes = System.Security.Cryptography.SHA256.HashData(
            System.Text.Encoding.UTF8.GetBytes("demo-recto-app-review-spki-placeholder"));
        return Convert.ToBase64String(bytes)
            .TrimEnd('=')
            .Replace('+', '-')
            .Replace('/', '_');
    }

    // Default points at the demo sentinel URL so App Store reviewers (and
    // any real user typing the demo pairing code "000000") see a clear
    // "this is a demo placeholder" surface rather than a localhost URL
    // that could be mistaken for a required real server. The pairing
    // form accepts ANY URL — empty, the demo sentinel, or a real
    // bootloader URL — and only branches into demo mode when the
    // pairing code matches DemoPairingCode. Banked 2026-05-22 evening
    // after the simulator screenshots flagged the localhost URL as
    // potentially confusing to Apple's reviewer.
    private string _bootloaderUrl = DemoBootloaderUrl;
    private string _pairingCode = string.Empty;
    private bool _busy;
    private string _busyText = string.Empty;
    private string? _errorMessage;

    // Build 7 (banked 2026-06-02 night): end-user first-pair ceremony
    // state. Populated by ProcessPairDeepLinkPayloadAsync when an unpaired
    // phone scans a Service-kind QR carrying bootstrap_bootloader +
    // bootstrap_pair_code (the canonical end-user pairing flow for
    // consumer-emitted QRs from a downstream consumer's Account →
    // Pair my phone surface). When _firstPairCeremonyActive is true:
    //   - The bootloader-pair form fields are pre-filled (_bootloaderUrl
    //     + _pairingCode from the QR's bootstrap_* fields).
    //   - A first-pair banner renders above the pair card explaining
    //     "Pair with <service hostname>? We'll pair your phone with
    //     this service so signing requests can reach this device."
    //   - HandlePairClick's post-success branch detects
    //     _pendingServicePairCodeAfterFirstPair + auto-fires the Phase H
    //     service-pair flow with the carried code. Single user tap
    //     covers both phases (bootloader pair → service pair).
    private bool _firstPairCeremonyActive;
    // The 8-char Service-pair code carried from the QR's code= field.
    // Stashed when first-pair ceremony activates; consumed by
    // HandlePairClick's post-bootloader-pair success path to auto-fire
    // the Phase H pair-a-service flow. Cleared on any first-pair exit
    // (success, failure, manual cancel). Null = no service-pair pending.
    private string? _pendingServicePairCodeAfterFirstPair;

    // Build 7 (2026-06-02 night): derives a human-readable service hostname
    // from the carried bootstrap_bootloader URL for the first-pair
    // confirmation banner. Falls back to a generic phrase on parse failure
    // so the banner never renders empty. We surface the bootloader's host
    // (the consumer-domain DNS name visible in the QR's URL) rather than
    // any service brand name, because the QR-emit consumer is the only
    // side that knows the brand string, and v1 of the wire contract
    // doesn't carry it — the host string IS the user-facing trust
    // anchor for "where is this taking me?".
    private string FirstPairServiceHostname
    {
        get
        {
            if (string.IsNullOrEmpty(_bootloaderUrl)) return "this service";
            try { return new Uri(_bootloaderUrl).Host; }
            catch { return "this service"; }
        }
    }

    // Build 5 (2026-06-02): pre-flight biometric availability warning.
    // Populated by RefreshBiometricsStatusAsync on OnInitializedAsync +
    // after any pairing state change. Null = no warning to show.
    // See IBiometricsAvailability.GetUserMessage for the mapping table.
    private string? _biometricsStatusMessage;

    private PairingState? _paired;

    // ── Build 12 multi-URL failover (2026-07-11, wave-C consumer) ──────────
    //
    // Session-scoped candidate list + rotating index. On pairing we build the
    // candidate list = [paired primary] ∪ RegistrationResponse.bootloader_urls
    // (deduped, primary always index 0). _failoverIndex is which candidate the
    // NEXT request uses; a connection-level failure (per
    // BootloaderClient.IsNetworkUnreachable) advances it, so the polling loop
    // naturally rotates through the load-balanced instances on an outage. The
    // rotation is in-memory only — the persisted PairingState.BootloaderUrl
    // stays the operator-paired primary, retried first on cold start. When the
    // list has one entry (single-instance / pre-Build-12 pairings) this is a
    // no-op and ActiveBootloaderUrl == _paired.BootloaderUrl always.
    private List<string> _failoverCandidates = new();
    private int _failoverIndex;

    /// <summary>The bootloader URL to use for the NEXT request — the current
    /// failover candidate, or the paired primary when no list exists.</summary>
    private string ActiveBootloaderUrl =>
        _failoverCandidates.Count > 0
            ? _failoverCandidates[_failoverIndex % _failoverCandidates.Count]
            : (_paired?.BootloaderUrl ?? _bootloaderUrl);

    /// <summary>Rebuild the session failover list from a pairing (primary
    /// first, deduped, https-only). Call after _paired is set.</summary>
    private void RebuildFailoverCandidates()
    {
        _failoverIndex = 0;
        _failoverCandidates = new List<string>();
        if (_paired is null) return;

        void Add(string? u)
        {
            if (string.IsNullOrWhiteSpace(u)) return;
            var trimmed = u.TrimEnd('/');
            // demo:// never federates; only real transports are candidates.
            if (!trimmed.StartsWith("http", StringComparison.OrdinalIgnoreCase)) return;
            if (!_failoverCandidates.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
                _failoverCandidates.Add(trimmed);
        }

        Add(_paired.BootloaderUrl);          // primary is always candidate #0
        if (_paired.BootloaderUrls is { } list)
            foreach (var u in list) Add(u);
    }

    /// <summary>Advance to the next failover candidate after a connection
    /// failure. Returns true when there's actually another instance to try
    /// (list length > 1); false leaves the index put (nothing to fail over
    /// to, so the caller surfaces the error).</summary>
    private bool AdvanceFailover()
    {
        if (_failoverCandidates.Count <= 1) return false;
        _failoverIndex = (_failoverIndex + 1) % _failoverCandidates.Count;
        System.Diagnostics.Debug.WriteLine(
            $"[Recto/Failover] rotating to candidate {_failoverIndex} of {_failoverCandidates.Count}: " +
            $"{_failoverCandidates[_failoverIndex]}");
        return true;
    }

