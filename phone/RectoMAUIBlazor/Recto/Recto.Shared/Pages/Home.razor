    // docs/backlog.md 2026-07-29.
    private const string DefaultConsumerAppIconUrl =
        DefaultConsumerBaseUrl + "/_content/" + DefaultConsumerAppName
        + ".Shared/brand/" + DefaultConsumerAppId + "-logo-1024.png";

