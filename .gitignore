# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# One-shot push scripts occasionally written at repo root by maintainer
# tooling. Ignored so a forgotten cleanup cannot land in a commit.
git_push.ps1

# Operator-side helper scripts. These are authored per-sprint on the
# maintainer's machine and are not part of the substrate; they stay local.
*script_*.ps1
*script.ps1
# (No exceptions. Helper scripts stay local; nothing in this family is
#  part of the published substrate.)

